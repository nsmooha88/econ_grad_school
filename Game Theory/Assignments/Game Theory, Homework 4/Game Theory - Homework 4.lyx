\size normal
\emph off
\bar no
\strikeout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula $J^{*}\rightarrow\infty$
\end_inset

.
\begin_inset Formula 
\[
p^{*}=\dfrac{\alpha}{\beta}-\dfrac{J}{(J+1)}\dfrac{\alpha}{\beta}+\dfrac{J}{(J+1)}c
\]

\end_inset


\family default
\series default
\shape default
\size default
\emph default
\bar default
\strikeout default
\uuline default
\uwave default
\noun default
\color inherit
Since 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\strikeout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula $J^{*}\rightarrow\infty$
\end_inset


\family default
