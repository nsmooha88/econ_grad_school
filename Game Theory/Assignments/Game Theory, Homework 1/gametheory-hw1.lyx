\begin_layout Section*
Problem 2
\end_layout

\begin_layout Standard
\begin_inset Formula $u_{f}=\dfrac{1}{2}\sqrt{KL}-rK\implies K^{*}\left(L\right)=\dfrac{L}{16r^{2}}=AL$
\end_inset


\begin_inset space \qquad{}
\end_inset


\begin_inset Formula $A=\dfrac{1}{16r^{2}}<1$
\end_inset

 since 
\begin_inset Formula $r>\frac{1}{4}$
\end_inset

.
 
\end_layout

\begin_layout Standard
\begin_inset Formula $u_{w}=\dfrac{1}{2}\sqrt{KL}-cL\implies L^{*}\left(K\right)=\dfrac{K}{16c^{2}}=BK$
\end_inset


\begin_inset space \qquad{}
\end_inset


\begin_inset Formula $B=\dfrac{1}{16c^{2}}<1$
\end_inset

 since 
\begin_inset Formula $c>\frac{1}{4}$
\end_inset

.
\end_layout

\begin_layout Standard
Suppose that 
\begin_inset Formula $(L^{*},K^{*})$
\end_inset

 is rationalizable.
 We know that 
\begin_inset Formula $L^{*}\in[0,\bar{L}]$
\end_inset

.
 Accordingly, we have:
\end_layout

\begin_layout Standard
\begin_inset Formula $K^{*}<A\bar{L}\implies L^{*}<AB\bar{L}\implies K^{*}<A^{2}BL\implies K^{*}<A^{2}B^{2}L\implies K^{*}<A^{3}B^{2}L\implies K^{*}<A^{3}B^{3}L$
\end_inset


\end_layout

\begin_layout Standard
By induction, 
\begin_inset Formula $\forall n\in\mathbb{N}\;:\; L^{*},K^{*}\in[0,A^{n}B^{n})$
\end_inset

.
 Since 
\begin_inset Formula $A,B\in(0,1)$
\end_inset

, this implies that 
\begin_inset Formula $(L^{*},K^{*})=(0,0)$
\end_inset

.
\end_layout

\begin_layout Standard
Accordingly, the set of rationalizable strategies is given by 
\begin_inset Formula $R_{1}=R_{2}=\{0\}$
\end_inset

.
\end_layout

\begin_layout Section*
Problem 3
\end_layout

\begin_layout Standard
\begin_inset Formula $u_{i}(s_{i},s_{j})=\begin{cases}
v_{i}-s_{j} & \textrm{if }s_{i}>s_{j}\\
\frac{1}{2}\left(v_{i}-s_{j}\right) & \textrm{if }s_{i}=s_{j}\\
0 & \textrm{if }s_{i}<s_{j}
\end{cases}$
\end_inset


\end_layout

\begin_layout Standard
For the sake of contradiction, suppose that 
\begin_inset Formula $s_{i}$
\end_inset

 is a dominated strategy for player 
\begin_inset Formula $i$
\end_inset

.
\end_layout

\begin_layout Standard
This means that 
\begin_inset Formula $\exists s_{i}'\in S_{i}\quad\forall s_{-i}\in S_{-i}\;:\; u_{i}(s_{i}',s_{-i})>u_{i}(s_{i},s_{-i})$
\end_inset


\begin_inset space \qquad{}
\end_inset

(
\begin_inset Formula $*$
\end_inset

)
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $s_{i}'>s_{i}$
\end_inset

 then: 
\begin_inset Formula $u_{i}(s_{i}',s_{i}'+1)=0=u_{i}(s_{i},s_{i}'+1)\implies\bot$
\end_inset

 
\begin_inset space \qquad{}
\end_inset

by (
\begin_inset Formula $*$
\end_inset

)
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $s_{i}\geq s_{i}'$
\end_inset

 then: 
\begin_inset Formula $u_{i}(s_{i}',s_{i}'-1)=v_{i}-s_{i}+1=u_{i}(s_{i},s_{i}'-1)\implies\bot$
\end_inset


\begin_inset space \qquad{}
\end_inset

by (
\begin_inset Formula $*$
\end_inset

)
\end_layout

\begin_layout Standard
Hence, there can be no dominated strategies in this game.
 Since this is a two player game, the set of rationalizable strategies is
 equal to the set of strategies that survive iterated elimination of dominated
 strategies.
 Accordingly, since there are no dominated strategies, every strategy is
 rationalizable.
\end_layout

\begin_layout Standard
Note that 
\begin_inset Formula $\forall s_{i}\in S_{i}\quad\forall s_{-i}\in S_{-i}\;:\; u_{i}(v_{i},s_{-i})\geq u_{i}(s_{i},s_{-i})$
\end_inset

.
 Thus every strategy is weakly dominated by 
\begin_inset Formula $v_{i}$
\end_inset

.
\end_layout

\begin_layout Standard
Note that the profile 
\begin_inset Formula $(v_{1},v_{2})$
\end_inset

 survives iterated elimination of weakly dominated strategies in this case.
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $v_{1}<v_{2}$
\end_inset

, then player 2 will win the auction and recieve payoff 
\begin_inset Formula $v_{1}-v_{2}$
\end_inset

 while player 1 receives payoff 0.
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $v_{1}=v_{2}$
\end_inset

 then both players are equally likely to win and both will obtain payoff
 0.
\end_layout

\begin_layout Standard
However, consider an alternate order of elimintation.
 Without loss of generality, suppose 
\begin_inset Formula $v_{j}\geq v_{i}$
\end_inset

.
\end_layout

\begin_layout Standard
In the first round, we can eliminate all strategies other than 
\begin_inset Formula $v_{i}$
\end_inset

 for agent 
\begin_inset Formula $i$
\end_inset

.
 In the second round, all 
\begin_inset Formula $v_{j}\geq v_{i}$
\end_inset

 survive for agent 
\begin_inset Formula $j$
\end_inset

, since 
\begin_inset Formula $v_{j}\geq v_{i}$
\end_inset

.
 Thus, different orders of elimination may yeild different sets of surviving
 strategies.
\end_layout

