E\left\{ p_{i}\right\}  & = & P(v_{i}=1)\cdot E\left\{ p_{i}|v_{i}=1\right\} +P(v_{i}=2)\cdot E\left\{ p_{i}|v_{i}=2\right\} +P(v_{i}=3)\cdot E\left\{ p_{i}|v_{i}=3\right\} \\
