\begin_layout Title
2012 Qualifier, Round 1, Section 3, Problem 2
\end_layout

\begin_layout Standard
Two types of people: 
\begin_inset Formula $G$
\end_inset

 and 
\begin_inset Formula $M$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\alpha=Pr(G)=\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $u_{i}(\theta_{i},x,1)=-(x-\theta_{i})^{2}+q$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\theta_{i}(G)=1$
\end_inset

, 
\begin_inset Formula $\theta_{i}(M)=\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Section*
Part A
\end_layout

\begin_layout Standard

\series bold
Inuitive Criteria (IC): 
\series default

\begin_inset Formula $x^{*}(\theta_{i}),q^{*}(x^{*}(\theta_{i}))$
\end_inset


\end_layout

\begin_layout Standard
1.
 
\begin_inset Formula $u(\theta_{i},x^{*},q^{*})>u(\theta_{i},x,q),\ \forall\ q$
\end_inset


\end_layout

\begin_layout Standard
2.
 
\begin_inset Formula $\exists\ j$
\end_inset

, 
\begin_inset Formula $u(\theta_{j},x,q)\geq u(\theta_{j},x^{*},q^{*})$
\end_inset

 for some 
\begin_inset Formula $q$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $Pr(\theta_{i}|x)=0$
\end_inset

.
\end_layout

\begin_layout Section*
Part B
\end_layout

\begin_layout Standard
We can find 
\begin_inset Formula $x$
\end_inset

 such that 
\end_layout

\begin_layout Standard
1.
 
\begin_inset Formula $-(x^{p}-\frac{1}{2})^{2}+\frac{1}{2}>-(x-\frac{1}{2})^{2}+1\iff(x^{p}+x-1)(x-x^{p})>\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Standard
2.
 
\begin_inset Formula $-(x^{p}-1)^{2}+\frac{1}{2}<-(x-1)^{2}+1\iff(x^{p}+x-2)(x-x^{p})<\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $(1)\implies x\mbox{\ is equilibrium dominated for type M}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $(2)\implies x\mbox{\ is not equilibrium dominated for type G}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $IC\implies Pr(M|x)=0$
\end_inset

.
 Therefore, 
\begin_inset Formula $Pr(G|x)=1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $(2)\implies G\mbox{\ has an incentive to deviate}$
\end_inset


\end_layout

\begin_layout Section*
Part C
\end_layout

\begin_layout Standard
\begin_inset Formula $\max\ -(x-\theta_{i}(M))^{2}+0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $x^{s}(M)=\frac{1}{2}$
\end_inset

, since 
\begin_inset Formula $\theta_{i}(M)=\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Section*
Part D
\end_layout

\begin_layout Standard
Belief: 
\begin_inset Formula $q=\begin{cases}
1 & \mbox{if}\ x\geq x^{s}(G)\\
0 & \mbox{otherwise}
\end{cases}$
\end_inset


\end_layout

\begin_layout Standard
This condition says that 
\begin_inset Formula $G$
\end_inset

 should prefer to donate at least 
\begin_inset Formula $x^{s}(G)$
\end_inset

 instead of something less:
\end_layout

\begin_layout Standard
\begin_inset Formula $-(x^{s}(G)-1)^{2}+1\geq0\iff0\leq x^{s}(G)\leq2$
\end_inset


\end_layout

\begin_layout Standard
M should have no incentive to mimic G:
\end_layout

\begin_layout Standard
\begin_inset Formula $-(x^{s}(G)-\frac{1}{2})^{2}+1\leq0\iff x^{s}(G)\geq\frac{3}{2}$
\end_inset

 or 
\begin_inset Formula $x^{s}(G)\leq-\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Standard
This implies that 
\begin_inset Formula $\frac{3}{2}\leq x^{s}(G)\leq2$
\end_inset


\end_layout

\begin_layout Standard
For 
\begin_inset Formula $\tilde{x}\in(\frac{3}{2},2]$
\end_inset

, 
\begin_inset Formula $\exists\ x$
\end_inset

 such that
\end_layout

\begin_layout Standard
\begin_inset Formula $\left\{ \begin{array}{c}
0>-(x-\frac{1}{2})^{2}+1\iff(x-\frac{1}{2})^{2}>1\iff x<-\frac{1}{2}\ \vee\ x>\frac{3}{2}\\
-(\tilde{x}-1)^{2}+1<-(x-1)^{2}+1\iff(x-1)^{2}<(\tilde{x}-1)^{2}\implies(x-1)^{2}<\frac{1}{4}<(\tilde{x}-1)^{2}\iff\frac{1}{2}+\epsilon<x<\frac{3}{2}+\epsilon
\end{array}\right.$
\end_inset

 
\end_layout

\begin_layout Standard
\begin_inset Formula $x$
\end_inset

 is equilibrium dominated for type 
\begin_inset Formula $M$
\end_inset

 and 
\begin_inset Formula $x$
\end_inset

 is not equilibrium dominated for type 
\begin_inset Formula $G$
\end_inset

.
 Thus, 
\begin_inset Formula $G$
\end_inset

 has an incentive deviate from 
\begin_inset Formula $\tilde{x}\in(\frac{3}{2},2]$
\end_inset

.
 So, the only strategy that satisfies IC is 
\begin_inset Formula $x=\frac{3}{2}$
\end_inset

.
\end_layout

\begin_layout Section*
Part E
\end_layout

\begin_layout Standard
\begin_inset Formula $Pr(M)\cdot x^{s}(M)+Pr(G)\cdot x^{s}(G)=1$
\end_inset


\end_layout

\begin_layout Section*
Part F
\end_layout

\begin_layout Standard
Belief: 
\begin_inset Formula $q=\begin{cases}
1 & \mbox{if}\ x\geq\hat{x}\\
0 & \mbox{otherwise}
\end{cases}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $-(\hat{x}-1)^{2}+1\geq0\iff0\leq\hat{x}\leq2$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $-(\hat{x}-\frac{1}{2})^{2}\leq0\iff\hat{x}\geq\frac{3}{2}$
\end_inset

 or 
\begin_inset Formula $\hat{x}\leq-\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $\hat{x}\in[\frac{3}{2},2]$
\end_inset


\end_layout

\begin_layout Section*
Part G
\end_layout

\begin_layout Standard
When 
\begin_inset Formula $\hat{x}=2$
\end_inset

, 
\end_layout

\begin_layout Standard
Expected donation: 
\begin_inset Formula $\frac{1}{2}\times\frac{1}{2}+\frac{1}{2}\times2=\frac{5}{4}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $G$
\end_inset

 type is worse off
\end_layout

