\begin_layout Section*
Monopolist
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
{\displaystyle \max_{q(\theta),T(\theta)}} & {\displaystyle \int_{\underline{\theta}}^{\overline{\theta}}}\left[T(\theta)-c\cdot q(\theta)\right]dF(\theta)\\
\mbox{s.t.} & V(q(\theta),\theta)-T(\theta)\geq0\ \forall\ \theta & \mbox{(IR)}\\
 & V(q(\theta),\theta)-T(\theta)\geq V(q(\hat{\theta}),\theta)-T(\hat{\theta})\ \forall\ \theta,\hat{\theta} & \mbox{(IC)}
\end{eqnarray*}

\end_inset

We now have an infinite number of constraints in this optimization problem.
 To deal with the huge number of constraints:
\end_layout

\begin_layout Enumerate
Replace all IR with 
\begin_inset Formula $\mbox{IR}(\underline{\theta})$
\end_inset


\end_layout

\begin_layout Enumerate
Replace all IC constraints with
\end_layout

\begin_deeper
\begin_layout Enumerate
IC holds locally (ICFOC): 
\begin_inset Formula $V_{q}(q(\hat{\theta}),\theta)\cdot q^{\prime}(\hat{\theta})-T^{\prime}(\hat{\theta})|_{\hat{\theta}=\theta}=0$
\end_inset

.
 We don't want a type 
\begin_inset Formula $\theta$
\end_inset

 will pretend to be a type that is locally next to him.
\end_layout

\begin_layout Enumerate
Monotonicity: 
\begin_inset Formula $q^{\prime}(\theta)>0$
\end_inset


\end_layout

\end_deeper
\begin_layout Itemize

\series bold
