\begin_layout Subsection*
ICFOC
\end_layout

\begin_layout Standard
Type 
\begin_inset Formula $\theta$
\end_inset

 can choose any bundle 
\begin_inset Formula $\hat{\theta}$
\end_inset


\end_layout

\begin_layout Standard
Net surplus to buyer: 
\begin_inset Formula $V(q(\hat{\theta}),\theta)-T(\hat{\theta})$
\end_inset

.
 The ICFOC implies there is a local maximum for the buyer at 
\begin_inset Formula $\theta$
\end_inset

.
\end_layout

\begin_layout Standard
The monotonicity constraint allows us to rule out global maximums somewhere
 else.
\end_layout

\begin_layout Subsection*
Problem to Solve
\begin_inset Formula 
\begin{eqnarray*}
{\displaystyle \max_{q(\theta),T(\theta)}} & {\displaystyle \int_{\underline{\theta}}^{\overline{\theta}}}\left[T(\theta)-c\cdot q(\theta)\right]dF(\theta)\\
\mbox{s.t.} & V(q(\underline{\theta}),\underline{\theta})-T(\underline{\theta})=0 & \mbox{IR}_{L}\\
 & V_{q}(q(\theta),\theta)q^{\prime}(\theta)-T^{\prime}(\theta)=0 & \mbox{ICFOC}\\
 & q^{\prime}(\theta)>0 & \mbox{Monotonicity}
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $U(\theta)\equiv\mbox{{\displaystyle \max_{\theta}}}\ V(q(\hat{\theta},\theta)-T(\hat{\theta})$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $V(q(\hat{\theta},\theta)-T(\hat{\theta})\equiv\phi(\hat{\theta},\theta)$
\end_inset


\end_layout

\begin_layout Standard
Total derivative
\begin_inset Formula 
\[
dU=\frac{\partial\phi}{\partial\hat{\theta}}|_{\hat{\theta}=\theta}\cdot d\hat{\theta}+\frac{\partial\phi}{\partial\theta}d\theta
\]

\end_inset


\end_layout

\begin_layout Standard
Because of the ICFOC
\begin_inset Formula 
\[
\frac{\partial\phi}{\partial\hat{\theta}}|_{\hat{\theta}=\theta}\cdot d\hat{\theta}=0
\]

\end_inset


\end_layout

\begin_layout Standard
Thus,
\begin_inset Formula 
\[
\frac{dU}{d\theta}=\frac{d\phi}{\theta}=V_{\theta}(q(\theta),\theta)
\]

\end_inset


\end_layout

\begin_layout Standard
Now, we have
\begin_inset Formula 
\[
U(\theta)={\displaystyle \int_{\underline{\theta}}^{\theta}}V_{\theta}(q(v),v)dv+U(\underline{\theta})
\]

\end_inset

We know that 
\begin_inset Formula $V_{\theta}(q(v),v)$
\end_inset

 is positive and 
\begin_inset Formula $U(\underline{\theta})=0$
\end_inset

 by 
\begin_inset Formula $\mbox{IR}_{L}$
\end_inset

.
 This implies that every type 
\begin_inset Formula $\theta>\underline{\theta}$
\end_inset

 gets information rents.
 Als0, the monopolist earns all rents minus information rents.
 The problem becomes
\begin_inset Formula 
\[
{\displaystyle \max_{q(\theta)}}\ {\displaystyle \int_{\underline{\theta}}^{\overline{\theta}}\left[V(q(\theta),\theta)-c\cdot q(\theta)-{\displaystyle \int_{\underline{\theta}}^{\theta}V_{\theta}(q(v),v)dv}\right]f(\theta)d\theta}
\]

\end_inset

Note that 
\begin_inset Formula $V(q(\theta),\theta)-c\cdot q(\theta)$
\end_inset

 is the total surplus and 
\begin_inset Formula $\int_{\underline{\theta}}^{\theta}V_{\theta}(q(v),v)dv$
\end_inset

 are information rents.
 The original problem for the information rents was
\begin_inset Formula 
\[
{\displaystyle \int_{\theta=\underline{\theta}}^{\overline{\theta}}{\displaystyle \int_{v=\underline{\theta}}^{\theta}}V_{\theta}}(q(v),v)dvf(\theta)d\theta
\]

\end_inset

The new information rents problem is
\begin_inset Formula 
\[
{\displaystyle \int_{v=\underline{\theta}}^{\overline{\theta}}V_{\theta}(q(v),v)\cdot F(\theta)|_{v}^{\overline{\theta}}dv}
\]

\end_inset

where 
\begin_inset Formula $F(\theta)|_{v}^{\overline{\theta}}=1-F(v)$
\end_inset

.
 Thus,
\begin_inset Formula 
\[
{\displaystyle \int_{v=\underline{\theta}}^{\overline{\theta}}V_{\theta}(q(v),v)\cdot\frac{1-F(v)}{f(v)}\cdot f(v)dv}
\]

\end_inset

Thus, maximization problem for the monopolist now becomes
\begin_inset Formula 
\begin{eqnarray*}
{\displaystyle \max_{q(\theta)}} & {\displaystyle \int_{\underline{\theta}}^{\overline{\theta}}}\left[V(q(\theta),\theta)-c\cdot q(\theta)-V_{\theta}(q(\theta),\theta)\cdot\frac{1-F(\theta)}{f(\theta)}\right]f(\theta)d\theta\\
\mbox{s.t.} & \mbox{monotonicity (ignore for now)}\\
 & V_{q}(q(\theta),\theta)-c-V_{\theta q}(q(\theta),\theta)\cdot\frac{1-F(\theta)}{f(\theta)}=0\ \forall\ \theta
\end{eqnarray*}

\end_inset

where MU is 
\begin_inset Formula $V_{q}(q(\theta),\theta)$
\end_inset

, MC is 
\begin_inset Formula $c$
\end_inset

, 
\begin_inset Formula $V_{\theta q}(q(\theta),\theta)$
\end_inset

 is positive, and 
\begin_inset Formula $\frac{1-F(\theta)}{f(\theta)}=0$
\end_inset

 for 
\begin_inset Formula $\overline{\theta}$
\end_inset


\end_layout

