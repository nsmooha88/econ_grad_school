\begin_layout Section*
Problem 6.12
\end_layout

\begin_layout Standard
In the linear model 
\begin_inset Formula $y_{i}=x_{i}^{\prime}\beta_{i}+u_{i}$
\end_inset

, initially assume that Assumptions 2SLS.1-2SLS.3 hold with 
\begin_inset Formula $w$
\end_inset

 in place of 
\begin_inset Formula $z$
\end_inset

, where 
\begin_inset Formula $w$
\end_inset

 includes all nonredundant elements of 
\begin_inset Formula $x$
\end_inset

 and 
\begin_inset Formula $z$
\end_inset

.
\end_layout

\begin_layout Enumerate
Show that under 
\begin_inset Formula $H_{0}:E(x_{i}\cdot u)=0$
\end_inset


\begin_inset Formula 
\begin{eqnarray*}
\mbox{Avar}[\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS})] & = & \mbox{Avar}[\sqrt{N}(\hat{\beta}_{2SLS}-\beta)]-\mbox{Avar}[\sqrt{N}(\hat{\beta}_{OLS}-\beta)]\\
 & = & \sigma^{2}[E(x_{i}^{*}x_{i}^{*\prime})]^{-1}-\sigma^{2}[E(x_{i}x_{i}^{\prime})]^{-1}
\end{eqnarray*}

\end_inset

where 
\begin_inset Formula $x_{i}^{*}=\Pi z_{i}$
\end_inset

 is the linear projection of 
\begin_inset Formula $x_{i}$
\end_inset

 on 
\begin_inset Formula $z_{i}$
\end_inset

.
\end_layout

\begin_layout Enumerate
Show how to estimate 
\begin_inset Formula $\mbox{Avar}[\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS})]$
\end_inset

 if Assumption 2SLS.3 (and Assumption OLS.3) do not hold under 
\begin_inset Formula $H_{0}$
\end_inset

.
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Standard

\series bold
\bar under
Part a.
\end_layout

\begin_layout Standard
We can write
\begin_inset Formula 
\[
\sqrt{N}(\hat{\beta}_{2SLS}-\beta)=A_{1}^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{n}}x_{i}^{*}u_{i}\right)+o_{p}(1)
\]

\end_inset

and
\begin_inset Formula 
\[
\sqrt{N}(\hat{\beta}_{OLS}-\beta)=A_{2}^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{n}}x_{i}u_{i}\right)+o_{p}(1)
\]

\end_inset

where 
\begin_inset Formula $A_{1}=E(x_{i}^{*}x_{i}^{*\prime})$
\end_inset

 and 
\begin_inset Formula $A_{2}=E(x_{i}x_{i}^{\prime})$
\end_inset

.
 The
\begin_inset Formula 
\begin{eqnarray*}
\sqrt{N}(\hat{\beta}_{2SLS}-\beta)-\sqrt{N}(\hat{\beta}_{OLS}-\beta) & = & A_{1}^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{n}}x_{i}^{*}u_{i}\right)-A_{2}^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{n}}x_{i}u_{i}\right)\\
\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS}) & = & N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{n}}\left(A_{1}^{-1}x_{i}^{*}-A_{2}^{-1}x_{i}\right)u_{i}
\end{eqnarray*}

\end_inset

where 
\begin_inset Formula $x_{i}^{*}=\Pi z_{i}=E(x_{i}z_{i}^{\prime})E(z_{i}z_{i}^{\prime})^{-1}z_{i}$
\end_inset

.
 Under 
\begin_inset Formula $H_{0}$
\end_inset

 and the given assumptions, 
\begin_inset Formula $E\left[\left(A_{1}^{-1}x_{i}^{*}-A_{2}^{-1}x_{i}\right)u_{i}\right]=E(A_{1}^{-1}\Pi z_{i}u_{i})-E(A_{2}^{-1}x_{i}u_{i})=0$
\end_inset

.
 Thus, by the Central Limit Theorem,
\begin_inset Formula 
\[
\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS})\begin{array}[b]{c}
_{d}\\
\longrightarrow
\end{array}N(0,V)
\]

\end_inset

where 
\begin_inset Formula $V\equiv\mbox{Avar}[\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS})]$
\end_inset

 and 
\begin_inset Formula 
\begin{eqnarray*}
V & = & E\left[u_{i}^{2}\left(A_{1}^{-1}x_{i}^{*}-A_{2}^{-1}x_{i}\right)\left(x_{i}^{*\prime}A_{1}^{-1}-x_{i}^{\prime}A_{2}^{-1}\right)\right]\\
 & = & E\left[u_{i}^{2}\left(A_{1}^{-1}x_{i}^{*}x_{i}^{*\prime}A_{1}^{-1}-A_{1}^{-1}x_{i}^{*}x_{i}^{\prime}A_{2}^{-1}-A_{2}^{-1}x_{i}x_{i}^{*\prime}A_{1}^{-1}+A_{2}^{-1}x_{i}x_{i}^{\prime}A_{2}^{-1}\right)\right]\\
 & = & \sigma^{2}\left[A_{1}^{-1}E(x_{i}^{*}x_{i}^{*\prime})A_{1}^{-1}-A_{1}^{-1}E(x_{i}^{*}x_{i}^{\prime})A_{2}^{-1}-A_{2}^{-1}E(x_{i}x_{i}^{*\prime})A_{1}^{-1}+A_{2}^{-1}E(x_{i}x_{i}^{\prime})A_{2}^{-1}\right]\\
 & = & \sigma^{2}\left[A_{1}^{-1}+A_{2}^{-1}-\left(A_{1}^{-1}E(x_{i}^{*}x_{i}^{\prime})A_{2}^{-1}+A_{2}^{-1}E(x_{i}x_{i}^{*\prime})A_{1}^{-1}\right)\right]
\end{eqnarray*}

\end_inset

Note that
\begin_inset Formula 
\begin{eqnarray*}
E(x_{i}^{*}x_{i}^{\prime}) & = & E(\Pi z_{i}x_{i}^{\prime})\\
 & = & E(x_{i}z_{i}^{\prime})E(z_{i}z_{i}^{\prime})^{-1}E(z_{i}x_{i}^{\prime})\\
E(x_{i}^{*}x_{i}^{*\prime}) & = & E(\Pi z_{i}z_{i}^{\prime}\Pi^{\prime})\\
 & = & E(E(x_{i}z_{i}^{\prime})E(z_{i}z_{i}^{\prime})^{-1}z_{i}z_{i}^{\prime}E(z_{i}z_{i}^{\prime})^{-1}E(z_{i}x_{i}^{\prime})\\
 & = & E(x_{i}z_{i}^{\prime})E(z_{i}z_{i}^{\prime})^{-1}E(z_{i}x_{i}^{\prime})
\end{eqnarray*}

\end_inset

So, 
\begin_inset Formula $A_{1}=E(x_{i}^{*}x_{i}^{*\prime})=E(x_{i}^{*}x_{i}^{\prime})=E(x_{i}x_{i}^{*\prime})$
\end_inset

.
 Therefore, we now have
\begin_inset Formula 
\begin{eqnarray*}
V & = & \sigma^{2}\left[A_{1}^{-1}+A_{2}^{-1}-A_{2}^{-1}-A_{2}^{-1}\right]\\
 & = & \sigma^{2}\left[A_{1}^{-1}-A_{2}^{-1}\right]
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
Part b.
\end_layout

\begin_layout Standard
If Assumption 2SLS.3 and Assumption OLS.3 do not hold under 
\begin_inset Formula $H_{0}$
\end_inset

, then becomes 
\begin_inset Formula $V\equiv\mbox{Avar}[\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS})]$
\end_inset

:
\begin_inset Formula 
\[
V=A_{1}^{-1}E(u_{i}^{2}x_{i}^{*}x_{i}^{*\prime})A_{1}^{-1}+A_{2}^{-1}E(u_{i}^{2}x_{i}x_{i}^{\prime})A_{2}^{-1}-\left(A_{1}^{-1}E(u_{i}^{2}x_{i}^{*}x_{i}^{\prime})A_{2}^{-1}+A_{2}^{-1}E(u_{i}^{2}x_{i}x_{i}^{*\prime})A_{1}^{-1}\right)
\]

\end_inset

The estimators of the second moment matrices, 
\begin_inset Formula $A_{1}^{-1}$
\end_inset

 and 
\begin_inset Formula $A_{2}^{-1}$
\end_inset

, are just their corresponding sample analogues, with the first-stage fitted
 values 
\begin_inset Formula $\hat{x}_{i}=\hat{\Pi}z_{i}$
\end_inset

 replacing 
\begin_inset Formula $x_{i}^{*}$
\end_inset

.
 So,
\begin_inset Formula 
\begin{eqnarray*}
\hat{A}_{1}^{-1} & = & N^{-1}{\displaystyle \sum_{i=1}^{N}}\hat{x}_{i}\hat{x}_{i}^{\prime}\\
\hat{A}_{2}^{-1} & = & N^{-1}{\displaystyle \sum_{i=1}^{N}}x_{i}x_{i}^{\prime}
\end{eqnarray*}

\end_inset

Estimation of the fourth moment matrices is also straightforward.
 First, by the law of large numbers,
\begin_inset Formula 
\begin{eqnarray*}
N^{-1}{\displaystyle \sum_{i=1}^{N}}u_{i}^{2}x_{i}^{*}x_{i}^{*\prime} & \begin{array}[b]{c}
_{p}\\
\longrightarrow
\end{array} & E(u_{i}^{2}x_{i}^{*}x_{i}^{*\prime})\equiv B_{1}\\
N^{-1}{\displaystyle \sum_{i=1}^{N}}u_{i}^{2}x_{i}x_{i}^{\prime} & \begin{array}[b]{c}
_{p}\\
\longrightarrow
\end{array} & E(u_{i}^{2}x_{i}x_{i}^{\prime})\equiv B_{2}\\
N^{-1}{\displaystyle \sum_{i=1}^{N}u_{i}^{2}x_{i}^{*}x_{i}^{\prime}} & \begin{array}[b]{c}
_{p}\\
\longrightarrow
\end{array} & E(u_{i}^{2}x_{i}^{*}x_{i}^{\prime})\equiv C
\end{eqnarray*}

\end_inset

Now, since 
\begin_inset Formula $u_{i}$
\end_inset

 are not observed, we replace 
\begin_inset Formula $u_{i}$
\end_inset

 with its residuals, which there are three possibilities.
 We can calculare residuals separately for 2SLS and OLS and insert these
 in the proper occurences of 
\begin_inset Formula $u_{i}^{2}$
\end_inset

.
 Or we can just use the 2SLS residuals or just use the OLS residuals in
 both places.
 Using the latter, let 
\begin_inset Formula $\hat{u}_{i}=y_{i}-x_{i}^{\prime}\hat{\beta}_{OLS}$
\end_inset

.
 This leads to the consistent estimators for each of the fourth moment matrices
\begin_inset Formula 
\begin{eqnarray*}
\hat{B}_{1} & \equiv & N^{-1}{\displaystyle \sum_{i=1}^{N}}\hat{u}_{i}^{2}x_{i}^{*}x_{i}^{*\prime}\\
\hat{B}_{2} & \equiv & N^{-1}{\displaystyle \sum_{i=1}^{N}}\hat{u}_{i}^{2}x_{i}x_{i}^{\prime}\\
\hat{C} & \equiv & N^{-1}{\displaystyle \sum_{i=1}^{N}\hat{u}_{i}^{2}x_{i}^{*}x_{i}^{\prime}}
\end{eqnarray*}

\end_inset

Thus, the heteroskedasticity-robust variance matrix for 
\begin_inset Formula $\mbox{Avar}[\sqrt{N}(\hat{\beta}_{2SLS}-\hat{\beta}_{OLS})]$
\end_inset

 is given by:
\begin_inset Formula 
\[
\hat{V}\equiv\hat{A}_{1}^{-1}\hat{B}_{1}\hat{A}_{1}^{-1}+\hat{A}_{2}^{-1}\hat{B}_{2}\hat{A}_{2}^{-1}-\left(\hat{A}_{1}^{-1}\hat{C}\hat{A}_{2}^{-1}+\hat{A}_{2}^{-1}\hat{C}^{\prime}\hat{A}_{1}^{-1}\right)
\]

\end_inset


\end_layout

\begin_layout Section*
Problem 10.2
\end_layout

\begin_layout Standard
Suppose you have 
\begin_inset Formula $T=2$
\end_inset

 years of data on the same group of 
\begin_inset Formula $N$
\end_inset

 working individuals.
 Consider the following model of wage determination:
\begin_inset Formula 
\[
\log(\mbox{\emph{wage}}_{it})=\theta_{1}+\theta_{2}d2_{t}+z_{it}^{\prime}\gamma+\delta_{1}\mbox{\emph{female}}_{i}+\delta_{2}d2_{t}\cdot\mbox{\emph{female}}_{i}+c_{i}+u_{i}
\]

\end_inset

The unobserved effect 
\begin_inset Formula $c_{i}$
\end_inset

 is allowed to be correlated with 
\begin_inset Formula $z_{it}$
\end_inset

 and 
\begin_inset Formula $\mbox{\emph{female}}_{i}$
\end_inset

.
 The variable 
\begin_inset Formula $d2_{t}$
\end_inset

 is a time period indicator, where 
\begin_inset Formula $d2_{t}=1$
\end_inset

 if 
\begin_inset Formula $t=2$
\end_inset

 and 
\begin_inset Formula $d2_{t}=0$
\end_inset

 if 
\begin_inset Formula $t=1$
\end_inset

.
 In what follows, assume that 
\begin_inset Formula 
\[
E(u_{it}|\mbox{\emph{female}}_{i},z_{i1},z_{i2},c_{i})=0,\ t=1,2
\]

\end_inset


\end_layout

\begin_layout Enumerate
Without further assumptions, what parameters in the log wage equation can
 be consistently estimated?
\end_layout

\begin_layout Enumerate
Interpret the coefficients 
\begin_inset Formula $\theta_{2}$
\end_inset

 and 
\begin_inset Formula $\delta_{2}$
\end_inset

.
\end_layout

\begin_layout Enumerate
Write the log equation explicitly for the two time periods.
 Show that the differenced equation can be written as
\begin_inset Formula 
\[
\Delta\log(\mbox{\emph{wage}}_{i})=\theta_{2}+\Delta z_{i}^{\prime}\gamma+\delta_{2}\mbox{\emph{female}}_{i}+\Delta u_{i}
\]

\end_inset

where 
\begin_inset Formula $\Delta\log(\mbox{\emph{wage}}_{i})=\log(\mbox{\emph{wage}}_{i2})-\log(\mbox{\emph{wage}}_{i1})$
\end_inset

, and so on.
\end_layout

\begin_layout Enumerate
How would you test 
\begin_inset Formula $H_{0}:\delta_{2}=0$
\end_inset

 if 
\begin_inset Formula $Var(\Delta u_{i}|\Delta z_{i},\mbox{\emph{female}}_{i})$
\end_inset

 is not constant?
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Standard

\series bold
\bar under
Part a.
\end_layout

\begin_layout Standard
Using the Fixed Effects Methods, we can consistently estimate 
\begin_inset Formula $\gamma$
\end_inset

, which represents the coefficients on the time-varying explanatory variables,
 as well as 
\begin_inset Formula $\theta_{2}$
\end_inset

 and 
\begin_inset Formula $\delta_{2}$
\end_inset

.
 Without further assumptions, the intercept 
\begin_inset Formula $\theta_{1}$
\end_inset

 and the parameter 
\begin_inset Formula $\delta_{1}$
\end_inset

 cannot be identified because 
\begin_inset Formula $\theta_{1}+\delta_{1}\mbox{\emph{female}}_{i}$
\end_inset

 cannot be distinguished from 
\begin_inset Formula $c_{i}$
\end_inset

.
 Even though we cannot identify the effects of the intercept and
\emph on
 
\begin_inset Formula $\mbox{\emph{female}}_{i}$
\end_inset

 
\emph default
in any particular time period, 
\begin_inset Formula $\theta_{2}$
\end_inset

 and 
\begin_inset Formula $\delta_{2}$
\end_inset

 are identified, and therefore we can estimate the differences in partial
 effects on the two time-constant variables relative to the base period
 
\begin_inset Formula $T=1$
\end_inset

.
 In particular, we can test whether the effects of the two time-constant
 variables have changed over time.
 For example, we can estimate how the gender gap has changed over time.
\end_layout

\begin_layout Standard

\series bold
\bar under
Part b.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{flalign*}
\log(\mbox{\emph{wage}}_{i2})|{}_{d2_{t}=1,\mbox{\emph{female}}_{i}=1} & =\theta_{1}+\theta_{2}+z_{i2}^{\prime}\gamma+\delta_{1}+\delta_{2}+c_{i}+u_{i2}\\
\log(\mbox{\emph{wage}}_{i1})|{}_{d2_{t}=0,\mbox{\emph{female}}_{i}=1} & =\theta_{1}+z_{i1}^{\prime}\gamma+\delta_{1}+c_{i}+u_{i1}\\
\log(\mbox{\emph{wage}}_{i2})|{}_{d2_{t}=1,\mbox{\emph{female}}_{i}=0} & =\theta_{1}+\theta_{2}+z_{i2}^{\prime}\gamma+c_{i}+u_{i2}\\
\log(\mbox{\emph{wage}}_{i1})|{}_{d2_{t}=0,\mbox{\emph{female}}_{i}=0} & =\theta_{1}+z_{i1}^{\prime}\gamma+c_{i}+u_{i1}\\
\theta_{2} & =\left(\log(\mbox{\emph{wage}}_{i2})|{}_{d2_{t}=1,\mbox{\emph{female}}_{i}=0}\right)-\left(\log(\mbox{\emph{wage}}_{i1})|{}_{d2_{t}=0,\mbox{\emph{female}}_{i}=0}\right)\\
\delta_{2} & =\left(\log(\mbox{\emph{wage}}_{i2})|{}_{d2_{t}=1,\mbox{\emph{female}}_{i}=1}-\log(\mbox{\emph{wage}}_{i1})|{}_{d2_{t}=0,\mbox{\emph{female}}_{i}=1}\right)-\theta_{2}
\end{flalign*}

\end_inset


\begin_inset Formula $\theta_{2}$
\end_inset

 measures how the wage changes over time for males, while 
\begin_inset Formula $\delta_{2}$
\end_inset

 measures how the gender gap is changing over time.
\end_layout

\begin_layout Standard

\series bold
\bar under
Part c.
\series default
\bar default

\begin_inset Formula 
\begin{eqnarray}
\log(\mbox{\emph{wage}}_{i1}) & = & \theta_{1}+z_{i1}^{\prime}\gamma+\delta_{1}\mbox{\emph{female}}_{i}+c_{i}+u_{i1}\nonumber \\
\log(\mbox{\emph{wage}}_{i2}) & = & \theta_{1}+\theta_{2}+z_{i2}^{\prime}\gamma+\delta_{1}\mbox{\emph{female}}_{i}+\delta_{2}\mbox{\emph{female}}_{i}+c_{i}+u_{i1}\nonumber \\
\Delta\log(\mbox{\emph{wage}}_{i}) & = & \log(\mbox{\emph{wage}}_{i2})-\log(\mbox{\emph{wage}}_{i1})\nonumber \\
 & = & \theta_{2}+\Delta z_{i}^{\prime}\gamma+\delta_{2}\mbox{\emph{female}}_{i}+\Delta u_{i}\ 
\end{eqnarray}

\end_inset

where 
\begin_inset Formula $\Delta z_{i}=z_{i2}-z_{i1}$
\end_inset

 and 
\begin_inset Formula $\Delta u_{i}=u_{i2}-u_{i1}$
\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
Part d.
\end_layout

\begin_layout Standard
When 
\begin_inset Formula $Var\left(\Delta u_{i}|\Delta z_{i},female_{i}\right)$
\end_inset

 is not a constant, then I would use heteroskedasticity-robust standard
 errors in the computation of the usual t-test, which I can then use to
 test 
\begin_inset Formula $H_{0}:\delta_{2}=0$
\end_inset

.
 Let 
\begin_inset Formula $\Delta x_{i}^{\prime}=(1,\Delta z_{i1},\Delta z_{i2},\ldots,\Delta z_{ik},\mbox{\emph{female}}_{i})$
\end_inset

 be the set of all regressors in the and 
\begin_inset Formula $\beta=\left(\theta_{2},\gamma_{1},\gamma_{2},\cdots,\gamma_{k},\delta_{2}\right)'$
\end_inset

 be set of all parameters in (4).
 Here I am assuming that 
\begin_inset Formula $\Delta z_{i}^{\prime}$
\end_inset

 is 
\begin_inset Formula $1\times K$
\end_inset

 and 
\begin_inset Formula $\gamma$
\end_inset

 is 
\begin_inset Formula $K\times1$
\end_inset

.
 So, equation (4) can be written as 
\begin_inset Formula $\Delta\log(\mbox{\emph{wage}}_{i})=\Delta x_{i}'\beta+\Delta u_{i}$
\end_inset

.
 The first-difference estimator is the pooled OLS estimator from the regression
 
\begin_inset Formula $\Delta\log(\mbox{\emph{wage}}_{i})$
\end_inset

 on 
\begin_inset Formula $\Delta x_{i}$
\end_inset

.
 Thus,
\begin_inset Formula 
\begin{eqnarray*}
\hat{\beta}_{FD} & = & \left(\sum_{i=1}^{N}\Delta x_{i}\Delta x_{i}'\right)^{-1}\left(\sum_{i=1}^{N}\Delta x_{i}\Delta\log(\mbox{\emph{wage}}_{i})\right)\\
\hat{\beta}_{FD}-\beta & = & \left(\sum_{i=1}^{N}\Delta x_{i}\Delta x_{i}'\right)^{-1}\left(\sum_{i=1}^{N}\Delta x_{i}\Delta u_{i}\right)\\
\sqrt{N}\left(\hat{\beta}_{FD}-\beta\right) & = & \left(N^{-1}\sum_{i=1}^{N}\Delta x_{i}\Delta x_{i}'\right)^{-1}\left(N^{-\frac{1}{2}}\sum_{i=1}^{N}\Delta x_{i}\Delta u_{i}\right)
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $E(\Delta x_{i}\cdot\Delta u_{i})=0$
\end_inset

 and assuming that 
\begin_inset Formula $E(\Delta x_{i}\Delta u_{i}\Delta u_{i}'\Delta x_{i}')<\infty$
\end_inset

, then by central limit theorem, we have:
\begin_inset Formula 
\begin{eqnarray*}
\sqrt{N}\left(\hat{\beta}_{FD}-\beta\right) & \begin{array}[b]{c}
_{d}\\
\longrightarrow
\end{array} & N(0,\left(E\Delta x_{i}\Delta x_{i}'\right)^{-1}E(\Delta x_{i}\Delta u_{i}\Delta u_{i}'\Delta x_{i}')\left(E\Delta x_{i}\Delta x_{i}'\right)^{-1})\\
\implies\hat{\beta}_{FD} & \begin{array}[b]{c}
_{d}\\
\longrightarrow
\end{array} & N\left(\beta,V_{R}\right)
\end{eqnarray*}

\end_inset

where 
\begin_inset Formula $V_{R}=N^{-1}(E\Delta x_{i}\Delta x_{i}'){}^{-1}E(\Delta x_{i}\Delta u_{i}\Delta u_{i}'\Delta x_{i}')(E\Delta x_{i}\Delta x_{i}')^{-1}$
\end_inset

 is the heteroskedasticity-robust variance covariance matrix.
 It can be estimated as:
\begin_inset Formula 
\[
\hat{V}_{R}=N^{-1}\left(\frac{\sum_{i=1}^{N}\Delta x_{i}\Delta x_{i}'}{N}\right)^{-1}\left(\frac{\sum_{i=1}^{N}\Delta x_{i}\hat{\Delta u}_{i}\hat{\Delta u_{i}}'\Delta x_{i}'}{N}\right)\left(\frac{\sum_{i=1}^{N}\Delta x_{i}\Delta x_{i}'}{N}\right)^{-1}
\]

\end_inset

where 
\begin_inset Formula $\hat{\Delta u_{i}}\equiv\Delta y_{i}-\Delta x_{i}^{\prime}\hat{\beta}_{FD}$
\end_inset

.
 The 
\begin_inset Formula $(K+2,K+2)$
\end_inset

 term of 
\begin_inset Formula $\hat{V_{R}}$
\end_inset

, 
\begin_inset Formula $v_{r}\left(\delta_{2}\right)$
\end_inset

, is the robust variance of 
\begin_inset Formula $\delta_{2}$
\end_inset

.
 Thus, the heteroskedasticity-robust t-statistic is:
\begin_inset Formula 
\[
t=\frac{\hat{\delta}_{2}}{\sqrt{v_{r}\left(\delta_{2}\right)}}
\]

\end_inset


\end_layout

\begin_layout Section*
Problem 10.8
\end_layout

\begin_layout Standard
Use the data in NORWAY.RAW for the years 1972 and 1978 for a two-year panel
 data analysis.
 The model is a simple distributed lag model:
\begin_inset Formula 
\[
\log(\mbox{\emph{crime}}_{it})=\theta_{0}+\theta_{1}d78_{t}+\beta_{1}\mbox{\emph{clrprc}}_{i,t-1}+\beta_{2}\mbox{\emph{clrprc}}_{i,t-2}+c_{i}+u_{it}
\]

\end_inset

The variable 
\emph on
clrprc
\emph default
 is the clear-up percentage (the percentage of crimes solved).
 The data are stored for two years, with the needed lags given as viaralbes
 for each year.
\end_layout

\begin_layout Enumerate
First estimate this equation using a pooled OLS analysis.
 Comment on the deterent effect of the clear-up percentage, including interpreti
ng the size of the coefficients.
 Test for serial correlation in the composite error 
\begin_inset Formula $v_{it}$
\end_inset

 assuming strict exogeneity (see Section 7.8).
\end_layout

\begin_layout Enumerate
Estimate the equation by FE, and compare the estimates with the pooled OLS
 estimates.
 Is there any reason to test for serial correlation? Obtain heteroskedasticity
 robust standard errors for the FE estimates by using the FD equation.
\end_layout

\begin_layout Enumerate
Using FE analysis, test the hypothesis 
\begin_inset Formula $H_{0}:\beta_{1}=\beta_{2}$
\end_inset

.
 What do you conclude? If the hypothesis is not reject, what would be a
 more parsimonious model? Estimate this model.
\end_layout

