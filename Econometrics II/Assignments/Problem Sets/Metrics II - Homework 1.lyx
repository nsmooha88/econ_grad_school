\begin_layout Section*
Problem 2.4
\end_layout

\begin_layout Standard
For random scalars 
\begin_inset Formula $u$
\end_inset

 and 
\begin_inset Formula $v$
\end_inset

 and a random vector 
\begin_inset Formula $\mathbf{x}$
\end_inset

, suppose that 
\begin_inset Formula $E(u|\mathbf{x},v)$
\end_inset

 is a linear function of 
\begin_inset Formula $(\mathbf{x},v)$
\end_inset

 and that 
\begin_inset Formula $u$
\end_inset

 and 
\begin_inset Formula $v$
\end_inset

 each have zero mean and are uncorrelated with the elements of 
\begin_inset Formula $\mathbf{x}$
\end_inset

.
 Show that 
\begin_inset Formula $E(u|\mathbf{x},v)=E(u|v)=\rho_{1}v$
\end_inset

 for some 
\begin_inset Formula $\rho_{1}$
\end_inset

.
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Standard
By assumption, we know that 
\begin_inset Formula $E(u|\mathbf{x},v)=\mathbf{x}^{\prime}\beta+\rho_{1}v$
\end_inset

, and 
\begin_inset Formula $E(u)=0$
\end_inset

, 
\begin_inset Formula $E(v)=0$
\end_inset

, 
\begin_inset Formula $Cov(u,\mathbf{x})=0$
\end_inset

, and 
\begin_inset Formula $Cov(v,\mathbf{x})=0$
\end_inset

.
 Also, since 
\begin_inset Formula $E(u|\mathbf{x},v)$
\end_inset

 is a linear function, we know that the linear projection coincides with
 the conditional expectation.
 We want to show that 
\begin_inset Formula $\beta=0$
\end_inset

.
 Consider the linear projection of 
\begin_inset Formula $\mathbf{x}$
\end_inset

 onto 
\begin_inset Formula $v$
\end_inset

.
 Let 
\begin_inset Formula $r\equiv\mathbf{x}-L(\mathbf{x}|v)$
\end_inset

.
 Since 
\begin_inset Formula $Cov(v,\mathbf{x})=0$
\end_inset

, then 
\begin_inset Formula $L(\mathbf{x}|v)=0$
\end_inset

, so 
\begin_inset Formula $r=\mathbf{x}$
\end_inset

.
 Now, consider the linear projection of 
\begin_inset Formula $u$
\end_inset

 onto 
\begin_inset Formula $r$
\end_inset

.
 By LP.7 from Chapter 2's appendix in Wooldridge, 
\begin_inset Formula $L(u|r)=\mathbf{x}^{\prime}\beta$
\end_inset

.
 Since 
\begin_inset Formula $r=\mathbf{x}$
\end_inset

, then 
\begin_inset Formula $L(u|r)=L(u|\mathbf{x})$
\end_inset

.
 Since 
\begin_inset Formula $Cov(u,\mathbf{x})=0$
\end_inset

, then 
\begin_inset Formula $L(u|\mathbf{x})=0$
\end_inset

.
 Therefore, 
\begin_inset Formula $\beta=0$
\end_inset

.
\end_layout

\begin_layout Section*
Problem 2.6
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\mathbf{x}$
\end_inset

 be a 
\begin_inset Formula $1\times K$
\end_inset

 random vector, and let 
\begin_inset Formula $q$
\end_inset

 be a random scalar.
 Suppose that 
\begin_inset Formula $q$
\end_inset

 can be expressed as 
\begin_inset Formula $q=q^{*}+e$
\end_inset

, where 
\begin_inset Formula $E(e)=0$
\end_inset

 and 
\begin_inset Formula $E(\mathbf{x}e)=\mathbf{0}$
\end_inset

.
 Write the linear projection of 
\begin_inset Formula $q^{*}$
\end_inset

onto 
\begin_inset Formula $(1,\mathbf{x})$
\end_inset

 as 
\begin_inset Formula $q^{*}=\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}+r^{*}$
\end_inset

, where 
\begin_inset Formula $E(r^{*})=0$
\end_inset

 and 
\begin_inset Formula $E(\mathbf{x}r^{*})=\mathbf{0}$
\end_inset

.
\end_layout

\begin_layout Enumerate
Show that 
\begin_inset Formula $L(q|1,\mathbf{x})=\delta_{0}+\delta_{1}x_{1}+\cdots+\delta_{K}x_{K}$
\end_inset


\end_layout

\begin_layout Enumerate
Find the projection error 
\begin_inset Formula $r\equiv q-L(q|1,\mathbf{x})$
\end_inset

 in terms of 
\begin_inset Formula $r^{*}$
\end_inset

 and 
\begin_inset Formula $e$
\end_inset

.
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Enumerate
\begin_inset Formula $q=q^{*}+e=\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{k}+r^{*}+e=\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}+r$
\end_inset

, where 
\begin_inset Formula $r=r^{*}+e$
\end_inset

.
 Since 
\begin_inset Formula $E(\mathbf{x}e)=0$
\end_inset

 and 
\begin_inset Formula $E(\mathbf{x}r^{*})=0$
\end_inset

, then 
\begin_inset Formula $E(\mathbf{x}u)=0$
\end_inset

.
 Also 
\begin_inset Formula $E(u)=E(r^{*})+E(e)=0$
\end_inset

.
 Note that the linear projection is just another way of writing down a populatio
n linear model where the disturbance has the properties we have just shown.
 Thus, 
\begin_inset Formula $q=\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}+r$
\end_inset

 where 
\begin_inset Formula $E(r)=0$
\end_inset

 and 
\begin_inset Formula $Cov(x_{j},r)=0,j=1,\ldots,K$
\end_inset

 is equivalent to writing 
\begin_inset Formula $L(q|1,x)=\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}$
\end_inset

.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $r\equiv q-L(q|1,\mathbf{x})=q^{*}+e-\left(\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}\right)$
\end_inset

 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\strikeout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula $=\left(\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}\right)+r^{*}+e-\left(\delta_{0}+\delta_{1}x_{1}+\cdots+\delta x_{K}\right)=r^{*}+e$
\end_inset


\end_layout

\begin_layout Section*
Problem 3.6
\end_layout

\begin_layout Standard
Give a careful (albeit short) proof of the following statement: If 
\begin_inset Formula $\sqrt{N}\left(\hat{\theta}_{N}-\theta\right)=O_{p}(1)$
\end_inset

, then 
\begin_inset Formula $\hat{\theta}_{N}-\theta=o_{p}(N^{-c})$
\end_inset

 for any 
\begin_inset Formula $0\leq c<\frac{1}{2}$
\end_inset

.
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $\sqrt{N}(\hat{\theta}_{N}-\theta)=O_{p}(1)$
\end_inset

.
 Take 
\begin_inset Formula $c\in[0,\frac{1}{2})$
\end_inset

.
 We want to show that 
\begin_inset Formula $\hat{\theta}_{N}-\theta=o_{p}(N^{-c})$
\end_inset

, which is equivalent to showing that 
\begin_inset Formula $N^{c}(\hat{\theta}_{N}-\theta)=o_{p}(1)$
\end_inset

.
 Now,
\begin_inset Formula 
\begin{eqnarray*}
N^{c}(\hat{\theta}-\theta) & = & N^{c}\cdot N^{-\frac{1}{2}}\cdot N^{\frac{1}{2}}(\hat{\theta}_{N}-\theta)\\
 & = & N^{(c-\frac{1}{2})}\cdot\left[\sqrt{N}(\hat{\theta}_{N}-\theta)\right]\\
 & = & N^{(c-\frac{1}{2})}\cdot O_{p}(1)\ \ \mbox{by assumption}\\
 & = & N^{x}\cdot O_{p}(1),\ \mbox{where}\ x\in[-\frac{1}{2},0)\ \mbox{since}\ c\in[0,\frac{1}{2})\\
 & = & o(1)\cdot O_{p}(1)\ \ \mbox{since}\ N^{x}\rightarrow0\ \mbox{as}\ N\rightarrow\infty\\
 & = & o_{p}(1)\cdot O_{p}(1)\ \ \mbox{since}\ N^{x}=o(1)\iff N^{x}=o_{p}(1)\\
 & = & o_{p}(1)\ \ \mbox{by Lemma 3.2}
\end{eqnarray*}

\end_inset


\end_layout

