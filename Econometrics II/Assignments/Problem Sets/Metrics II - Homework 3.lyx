\begin_body

\begin_layout Title
Econometrics II: Homework 3
\end_layout

\begin_layout Author
Nathan Smooha
\end_layout

\begin_layout Section*
Problem 7.2
\end_layout

\begin_layout Standard
In the model
\begin_inset Formula 
\begin{equation}
y_{i}=x_{i}\beta+u_{i}
\end{equation}

\end_inset

 maintain Assumptions SOLS.1 and SOLS.2, and assume 
\begin_inset Formula $E(x_{i}^{\prime}u_{i}u_{i}^{\prime}x_{i})=E(x_{i}^{\prime}\Omega x_{i})$
\end_inset

, where 
\begin_inset Formula $\Omega\equiv E(u_{i}u_{i}^{\prime})$
\end_inset

.
 The last assumption is a different way of stating the homoskedasticity
 assumption for systems of equations.
\end_layout

\begin_layout Enumerate
Show that 
\begin_inset Formula $\mbox{AVar}(\hat{\beta}_{SOLS})=N^{-1}\cdot\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left[E(x_{i}^{\prime}\Omega x_{i})\right]\left[E(x_{i}^{\prime}x_{i})\right]^{-1}$
\end_inset


\end_layout

\begin_layout Enumerate
How would you estimate the asymptotic variance in part a?
\end_layout

\begin_layout Enumerate
Now add Assumptions SGLS.1-SGLS.3 Show that 
\begin_inset Formula $\mbox{AVar}(\hat{\beta}_{SOLS})-\mbox{AVar}(\hat{\beta}_{FGLS})$
\end_inset

 is positive semidefinite.
 (Hint: Show that 
\begin_inset Formula $\left[\mbox{AVar}(\hat{\beta}_{FGLS})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{SOLS})\right]^{-1}$
\end_inset

 is p.s.d.)
\end_layout

\begin_layout Enumerate
If, in addition to the previous assumptions, 
\begin_inset Formula $\Omega=\sigma^{2}I_{G}$
\end_inset

, show that SOLS and FGLS have the same asymptotic variance.
\end_layout

\begin_layout Enumerate
Evaluate the following statement: 
\begin_inset Quotes eld
\end_inset

Under the assumptions of part c, FGLS is never asymptotically worse than
 SOLS, even if 
\begin_inset Formula $\Omega=\sigma^{2}I_{G}$
\end_inset

.
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Subsubsection*

\series bold
Part a.
\end_layout

\begin_layout Standard
Under Assumptions SOLS.1 and SOLS.2, 
\begin_inset Formula $\beta$
\end_inset

 is identified and a consistent estimator is given by
\begin_inset Formula 
\begin{equation}
\hat{\beta}_{SOLS}=\left(N^{-1}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}x_{i}\right)^{-1}\left(N^{-1}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}y_{i}\right)
\end{equation}

\end_inset

From (1) and (2), write
\begin_inset Formula 
\[
\sqrt{N}\left(\hat{\beta}_{SOLS}-\beta\right)=\left(N^{-1}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}x_{i}\right)\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\right)
\]

\end_inset

Because 
\begin_inset Formula $E(x_{i}^{\prime}u_{i})=0$
\end_inset

 under Assumption SOLS.1, the CLT implies that
\begin_inset Formula 
\begin{equation}
N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\begin{array}[b]{c}
_{d}\\
\rightarrow
\end{array}N\left(0,E[x_{i}^{\prime}u_{i}u_{i}^{\prime}x_{i}]\right)
\end{equation}

\end_inset

In particular, 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $N^{-\frac{1}{2}}\sum_{i=1}^{N}x_{i}^{\prime}u_{i}=O_{p}(1)$
\end_inset

.
 But, by the law of large numbers, 
\begin_inset Formula $\left(\nicefrac{X^{\prime}X}{N}\right)^{-1}=\left[E(x_{i}^{\prime}x_{i})\right]^{-1}+o_{p}(1)$
\end_inset

, so
\begin_inset Formula 
\begin{eqnarray}
\sqrt{N}\left(\hat{\beta}_{SOLS}-\beta\right) & = & \left(\left[\left(\nicefrac{X^{\prime}X}{N}\right)^{-1}-\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\right]+\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\right)\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\right)\nonumber \\
 & = & \left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\right)+\left[\left(\frac{X^{\prime}X}{N}\right)^{-1}-\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\right]\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\right)\nonumber \\
 & = & \left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\right)+o_{p}(1)\cdot O_{p}(1)\nonumber \\
 & = & \left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left(N^{-\frac{1}{2}}{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}u_{i}\right)+o_{p}(1)
\end{eqnarray}

\end_inset

Thus, by the CLT, equations (3) and (4) and the asymptotic equivalence lemma
 imply
\begin_inset Formula 
\[
\sqrt{N}\left(\hat{\beta}_{SOLS}-\beta\right)\begin{array}[b]{c}
_{d}\\
\rightarrow
\end{array}N\left(0,\left[E(x_{i}^{\prime}x_{i})\right]^{-1}E\left(x_{i}^{\prime}u_{i}u_{i}^{\prime}x_{i}\right)\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\right)
\]

\end_inset

Since 
\begin_inset Formula $E(x_{i}^{\prime}u_{i}u_{i}^{\prime}x_{i})=E(x_{i}^{\prime}\Omega x_{i})$
\end_inset

, then the asymptotic variance of 
\begin_inset Formula $\hat{\beta}$
\end_inset

 is
\begin_inset Formula 
\begin{equation}
\mbox{AVar}(\hat{\beta}_{SOLS})=N^{-1}\cdot\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left[E(x_{i}^{\prime}\Omega x_{i})\right]\left[E(x_{i}^{\prime}x_{i})\right]^{-1}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*

\series bold
Part b.
\end_layout

\begin_layout Standard
To obtain a consistent estimator of the asymptotic variance in part a, we
 must first find a consistent estimator of 
\begin_inset Formula $\Omega$
\end_inset

.
 By the WLLN, 
\begin_inset Formula $\mbox{plim}\left(N^{-1}\sum_{i=1}^{N}u_{i}u_{i}^{\prime}\right)=\Omega$
\end_inset

.
 So, a natural estimator of 
\begin_inset Formula $\Omega$
\end_inset

 is
\begin_inset Formula 
\begin{equation}
\hat{\Omega}\equiv N^{-1}{\displaystyle \sum_{i=1}^{N}}\hat{u}_{i}\hat{u}_{i}^{\prime}
\end{equation}

\end_inset

where 
\begin_inset Formula $\hat{u}_{i}=y_{i}-x_{i}\hat{\beta}_{SOLS}$
\end_inset

.
 It can be shown that this estimator is consistent for 
\begin_inset Formula $\Omega$
\end_inset

.
 Therefore, I would estimate the asymptotic variance in part a by using
 the sample analogue of (5), i.e.,
\begin_inset Formula 
\begin{equation}
\widehat{\mbox{AVar}(\hat{\beta}_{SOLS})}=\left(X^{\prime}X\right)^{-1}\left[{\displaystyle \sum_{i=1}^{N}}x_{i}^{\prime}\hat{\Omega}x_{i}\right]\left(X^{\prime}X\right)^{-1}
\end{equation}

\end_inset

where 
\begin_inset Formula $\hat{\Omega}$
\end_inset

 is given by equation (6).
\end_layout

\begin_layout Subsubsection*

\series bold
Part c.
\end_layout

\begin_layout Standard
If Assumptions SGLS.1-SGLS.3 hold, then by Theorem 7.4, the asymptotic variance
 of the FGLS estimator is
\begin_inset Formula 
\begin{equation}
\mbox{AVar}(\hat{\beta}_{FGLS})=N^{-1}\cdot\left[E(x_{i}^{\prime}\Omega^{-1}x_{i})\right]^{-1}
\end{equation}

\end_inset

Now, showing that 
\begin_inset Formula $\mbox{AVar}(\hat{\beta}_{SOLS})-\mbox{AVar}(\hat{\beta}_{FGLS})$
\end_inset

 is p.s.d.
 is equivlent to showing that 
\begin_inset Formula $\left[\mbox{AVar}(\hat{\beta}_{FGLS})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{SOLS})\right]^{-1}$
\end_inset

 is p.s.d.
 So, consider 
\begin_inset Formula 
\[
\left[\mbox{AVar}(\hat{\beta}_{FGLS})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{SOLS})\right]^{-1}=N\cdot\left(E(x_{i}^{\prime}\Omega^{-1}x_{i})-E(x_{i}^{\prime}x_{i})\left[E(x_{i}^{\prime}\Omega x_{i})\right]^{-1}E(x_{i}^{\prime}x_{i})\right)
\]

\end_inset

Since 
\begin_inset Formula $\Omega$
\end_inset

 is positive definite by Assumption SGLS.2 and nonsingular, then we can decompose
 
\begin_inset Formula $\Omega$
\end_inset

 as follows: 
\begin_inset Formula $\Omega=\Omega^{\nicefrac{1}{2}}\Omega^{\nicefrac{1}{2}}$
\end_inset

 and 
\begin_inset Formula $\Omega^{-1}=\Omega^{-\nicefrac{1}{2}}\Omega^{-\nicefrac{1}{2}}$
\end_inset

.
 Also, define 
\begin_inset Formula $A_{i}\equiv\Omega^{-\nicefrac{1}{2}}x_{i}$
\end_inset

 and 
\begin_inset Formula $B_{i}\equiv\Omega^{\nicefrac{1}{2}}x_{i}$
\end_inset

.
 Now, we have
\begin_inset Formula 
\begin{eqnarray*}
\left[\mbox{AVar}(\hat{\beta}_{FGLS})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{SOLS})\right]^{-1} & = & N\cdot\left(E(A_{i}^{\prime}A_{i})-E(A_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i})\right)\\
 & = & N\cdot E(C_{i}^{\prime}C_{i})
\end{eqnarray*}

\end_inset

where 
\begin_inset Formula $C_{i}=A_{i}-B_{i}\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i})$
\end_inset

.
 Note that
\begin_inset Formula 
\begin{eqnarray*}
E(C_{i}^{\prime}C_{i}) & = & E\left[(A_{i}^{\prime}-E(A_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}B_{i}^{\prime})(A_{i}-B_{i}\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i}))\right]\\
 & = & E(A_{i}^{\prime}A_{i})-E(A_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i})-E(A_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i})\\
 &  & +E(A_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i})\\
 & = & E(A_{i}^{\prime}A_{i})-E(A_{i}^{\prime}B_{i})\left[E(B_{i}^{\prime}B_{i})\right]^{-1}E(B_{i}^{\prime}A_{i})
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $E(C_{i}^{\prime}C_{i})$
\end_inset

 is positive semi-definite, then 
\begin_inset Formula $\left[\mbox{AVar}(\hat{\beta}_{FGLS})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{SOLS})\right]^{-1}$
\end_inset

 is positive semi-definite.
\end_layout

\begin_layout Subsubsection*

\series bold
Part d.
\end_layout

\begin_layout Standard
If, in addition to the previous assumptions, 
\begin_inset Formula $\Omega=\sigma^{2}I_{G}$
\end_inset

, then the asymptotic variances become
\begin_inset Formula 
\begin{eqnarray*}
\mbox{AVar}(\hat{\beta}_{SOLS}) & = & N^{-1}\cdot\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left[E(x_{i}^{\prime}\sigma^{2}I_{G}x_{i})\right]\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\\
 & = & N^{-1}\cdot\sigma^{2}\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\left[E(x_{i}^{\prime}x_{i})\right]\left[E(x_{i}^{\prime}x_{i})\right]^{-1}\\
 & = & N^{-1}\cdot\sigma^{2}\left[E(x_{i}^{\prime}x_{i})\right]^{-1}
\end{eqnarray*}

\end_inset

and
\begin_inset Formula 
\begin{eqnarray*}
\mbox{AVar}(\hat{\beta}_{FGLS}) & = & N^{-1}\cdot\left[E(x_{i}^{\prime}\sigma^{2}I_{G}x_{i})\right]^{-1}\\
 & = & N^{-1}\cdot\sigma^{2}\left[E(x_{i}^{\prime}x_{i})\right]^{-1}
\end{eqnarray*}

\end_inset

Therefore, if 
\begin_inset Formula $\Omega=\sigma^{2}I_{G}$
\end_inset

, then SOLS and FGLS have the same asymptotic variance.
\end_layout

\begin_layout Subsubsection*

\series bold
Part e.
\end_layout

\begin_layout Standard
In part (c), it was shown that under Assumptions SGLS.1-SGLS.3, 
\begin_inset Formula $\mbox{AVar}(\hat{\beta}_{SOLS})-\mbox{AVar}(\hat{\beta}_{FGLS})$
\end_inset

 is positive semi-definite.
 From part (d), it was shown that under 
\begin_inset Formula $\Omega=\sigma^{2}I_{G}$
\end_inset

, the asymptotic variances of the two estimators are the same.
 From these two results, we can conclude that under Assumptions SGLS.1-SGLS,
 the FGLS estimator is at least as asymptotically efficient as the SOLS
 estimator.
 This means that the FGLS estimator is never asymptotically worse than SOLS,
 even if 
\begin_inset Formula $\Omega=\sigma^{2}I_{G}$
\end_inset

.
\end_layout

\begin_layout Section*
Problem 7.14
\end_layout

\begin_layout Standard
Consider the system of equations 
\begin_inset Formula $y_{i}=x_{i}\beta+u_{i}$
\end_inset

 under 
\begin_inset Formula $E(x_{i}\otimes u_{i})=0$
\end_inset

 and 
\begin_inset Formula $E(u_{i}u_{i}^{\prime}|x_{i})=\Omega$
\end_inset

.
 Consider the FGLS estimator with 
\begin_inset Formula $\hat{\Omega}$
\end_inset

 consistent for 
\begin_inset Formula $\Omega$
\end_inset

 and another FGLS estimator using 
\begin_inset Formula $\hat{\Lambda}\begin{array}[b]{c}
_{p}\\
\rightarrow
\end{array}\Lambda\neq\Omega$
\end_inset

.
 Show that the former is at least as asymptotically efficient as the latter.
\end_layout

\begin_layout Subsection*
Solution
\end_layout

\begin_layout Standard
Since Assumptions SGLS.1-SGLS.3 hold, then by Theorem 7.4, the asymptotic variance
 of the FGLS estimator with 
\begin_inset Formula $\hat{\Omega}$
\end_inset

 consistent for 
\begin_inset Formula $\Omega$
\end_inset

 is
\begin_inset Formula 
\begin{equation}
\mbox{AVar}(\hat{\beta}_{C})=N^{-1}\cdot\left[E(x_{i}^{\prime}\Omega^{-1}x_{i})\right]^{-1}
\end{equation}

\end_inset

Since 
\begin_inset Formula $E(x_{i}\otimes u_{i})=0$
\end_inset

 holds, then the FGLS estimator of 
\begin_inset Formula $\beta$
\end_inset

 using 
\begin_inset Formula $\hat{\Lambda}$
\end_inset

 as the variance matrix is consistent.
 Under 
\begin_inset Formula $E(u_{i}u_{i}^{\prime}|x_{i})=\Omega$
\end_inset

, its asymptotic variance is
\begin_inset Formula 
\[
\mbox{AVar}(\hat{\beta}_{I})=N^{-1}\cdot\left[E(x_{i}^{\prime}\Lambda^{-1}x_{i})\right]^{-1}\left[E(x_{i}^{\prime}\Lambda^{-1}\Omega\Lambda^{-1}x_{i})\right]\left[E(x_{i}^{\prime}\Lambda^{-1}x_{i})\right]^{-1}
\]

\end_inset

To show 
\begin_inset Formula $\hat{\beta}_{C}$
\end_inset

 is at least as asymptotically efficient as 
\begin_inset Formula $\hat{\beta}_{I}$
\end_inset

, we will show that 
\begin_inset Formula $\mbox{AVar}(\hat{\beta}_{I})-\mbox{AVar}(\hat{\beta}_{C})$
\end_inset

 is p.s.d, which is equivalent to showing that 
\begin_inset Formula $\left[\mbox{AVar}(\hat{\beta}_{C})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{I})\right]^{-1}$
\end_inset

 is p.s.d.
 So, consider
\begin_inset Formula 
\begin{eqnarray*}
\left[\mbox{AVar}(\hat{\beta}_{C})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{I})\right]^{-1} & = & N\cdot E(x_{i}^{\prime}\Omega^{-1}x_{i})\\
 &  & -N\cdot E(x_{i}^{\prime}\Lambda^{-1}x_{i})\left[E(x_{i}^{\prime}\Lambda^{-1}\Omega\Lambda^{-1}x_{i})\right]^{-1}E(x_{i}^{\prime}\Lambda^{-1}x_{i})
\end{eqnarray*}

\end_inset

Note that 
\begin_inset Formula $\Lambda\equiv\Lambda^{\nicefrac{1}{2}}\Lambda^{\nicefrac{1}{2}}$
\end_inset

.
 Let 
\begin_inset Formula $\tilde{x}_{i}=\Lambda^{-\nicefrac{1}{2}}x_{i}$
\end_inset

 and 
\begin_inset Formula $\tilde{\Omega}=\Lambda^{-\nicefrac{1}{2}}\Omega\Lambda^{-\nicefrac{1}{2}}$
\end_inset

.
 Now, we have
\begin_inset Formula 
\[
\left[\mbox{AVar}(\hat{\beta}_{FGLS})\right]^{-1}-\left[\mbox{AVar}(\hat{\beta}_{SOLS})\right]^{-1}=N\cdot\left[E\left(\tilde{x}_{i}^{\prime}\tilde{\Omega}^{-1}\tilde{x}_{i}\right)-E(\tilde{x}_{i}^{\prime}\tilde{x}_{i})\left[E(\tilde{x}_{i}^{\prime}\tilde{\Omega}\tilde{x}_{i})\right]^{-1}E(\tilde{x}_{i}^{\prime}\tilde{x}_{i})\right]
\]

\end_inset


\end_layout

\begin_layout Section*
Problem 8.8
\end_layout

