\end_inset


\end_layout

\begin_layout Standard
By the Intermediate Value Theorem, if 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $\left(\frac{d\left[E_{F}u\right]}{dx}(0)\right)\cdot\left(\frac{d\left[E_{F}u\right]}{dx}(w)\right)<0,$
\end_inset

 then 
\begin_inset Formula $\exists\ x^{*}\in(0,w):\frac{d\left[E_{F}u\right]}{dx}(x^{*})=0$
\end_inset


\end_layout

\begin_layout Standard
Since the index function is concave, then 
\begin_inset Formula $\frac{d^{2}\left[E_{F}u\right]}{dx^{2}}(x)<0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{d^{2}\left[E_{F}u\right]}{dx^{2}}(x)<0\implies\frac{d\left[E_{F}u\right]}{dx}(x)$
\end_inset

 is a decreasing function
\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $\left(\frac{d\left[E_{F}u\right]}{dx}(0)\right)>0$
\end_inset

 and 
\begin_inset Formula $\left(\frac{d\left[E_{F}u\right]}{dx}(w)\right)<0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{d\left[E_{F}u\right]}{dx}(0)>0\iff-e^{-2aw}a\left[\alpha-(1-\alpha)\right]>0\iff\left[\alpha-(1-\alpha)\right]<0\iff2\alpha<1\iff\alpha<\frac{1}{2}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{d\left[E_{F}u\right]}{dx}(w)<0\iff-e^{-2aw}a\left[\alpha e^{aw}-(1-\alpha)(e^{-aw})\right]<0\iff\left[\alpha e^{aw}-(1-\alpha)(e^{-aw})\right]>0\iff\alpha>\frac{e^{-aw}}{(e^{aw}+e^{-aw})}$
\end_inset


\end_layout

\begin_layout Standard
Thus, to obtain an interior solution for 
\begin_inset Formula $x^{*}$
\end_inset

, 
\begin_inset Formula $\alpha\in\left(\frac{e^{-aw}}{(e^{aw}+e^{-aw})},\frac{1}{2}\right)$
\end_inset


\end_layout

