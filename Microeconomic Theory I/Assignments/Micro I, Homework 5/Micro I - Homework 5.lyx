\begin_layout Standard
Let 
\begin_inset Formula $X\equiv\mathbb{R}^{3}$
\end_inset

 be the set of alternatives.
 Suppose that a demand function 
\begin_inset Formula $x$
\end_inset

 satisfies Walras' law and is such that for each pair 
\begin_inset Formula $(p,w)\in\mathbb{R}_{++}^{3}\times\mathbb{R}_{+}$
\end_inset

:
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $x_{1}(p,w)\equiv100+\frac{1}{10}\frac{p_{1}}{p_{3}}+20\frac{p_{2}}{p_{3}}$
\end_inset

,
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $x_{2}(p,w)\equiv450+20\frac{p_{1}}{p_{3}}-\frac{5}{3}\frac{p_{2}}{p_{3}}$
\end_inset

.
\end_layout

\begin_layout Standard

\series bold
(a) Calculate 
\begin_inset Formula $x_{3}(p,w)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard
Since the demand function 
\begin_inset Formula $x$
\end_inset

 satisfies Walras' law, we have 
\begin_inset Formula $p_{1}\cdot x_{1}(p,w)+p_{2}\cdot x_{2}(p,w)+p_{3}\cdot x_{3}(p,w)=w$
\end_inset


\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $x_{3}(p,w)=\frac{w}{p_{3}}-\frac{p_{1}}{p_{3}}\cdot x_{1}(p,w)-\frac{p_{2}}{p_{3}}\cdot x_{2}(p,w)$
\end_inset


\end_layout

\begin_layout Standard
Therefore, 
\begin_inset Formula $x_{3}(p,w)=\frac{w}{p_{3}}-\frac{p_{1}}{p_{3}}\left(100+\frac{1}{10}\frac{p_{1}}{p_{3}}+20\frac{p_{2}}{p_{3}}\right)-\frac{p_{2}}{p_{3}}\left(450+20\frac{p_{1}}{p_{3}}-\frac{5}{3}\frac{p_{2}}{p_{3}}\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
(b) Is 
\begin_inset Formula $x$
\end_inset

 homogeneous of degree zero?
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard
Take 
\begin_inset Formula $\alpha\in\mathbb{R}_{+}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $x_{1}(\alpha p,\alpha w)=100+\frac{1}{10}\frac{\alpha p_{1}}{\alpha p_{3}}+20\frac{\alpha p_{2}}{\alpha p_{3}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $\ \ \ =100+\frac{1}{10}\frac{p_{1}}{p_{3}}+20\frac{p_{2}}{p_{3}}=x_{1}(p,w)$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\align left
\begin_inset Formula $x_{2}(\alpha p,\alpha w)=450+20\frac{\alpha p_{1}}{\alpha p_{3}}-\frac{5}{3}\frac{\alpha p_{2}}{\alpha p_{3}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $\ \ \ =450+20\frac{p_{1}}{p_{3}}-\frac{5}{3}\frac{p_{2}}{p_{3}}=x_{2}(p,w)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $x_{3}(\alpha p,\alpha w)=\frac{\alpha w}{\alpha p_{3}}-\frac{\alpha p_{1}}{\alpha p_{3}}\left(100+\frac{1}{10}\frac{\alpha p_{1}}{\alpha p_{3}}+20\frac{\alpha p_{2}}{\alpha p_{3}}\right)-\frac{\alpha p_{2}}{\alpha p_{3}}\left(450+20\frac{\alpha p_{1}}{\alpha p_{3}}-\frac{5}{3}\frac{\alpha p_{2}}{\alpha p_{3}}\right)$
