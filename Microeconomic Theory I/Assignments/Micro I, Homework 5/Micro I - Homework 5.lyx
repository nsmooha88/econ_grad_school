\begin_layout Standard
By Proposition 9, a continuous preference reltation 
\begin_inset Formula $\succeq$
\end_inset

 on 
\begin_inset Formula $\mathbb{R}\times\mathbb{R}_{+}^{L-1}$
\end_inset

 is quasi-linear with respect to commodity 
\begin_inset Formula $k$
\end_inset

 if and only if it admits a continuous utility representation of the form:
\end_layout

\begin_layout Standard
\begin_inset Formula $\forall\ x\in\mathbb{R}\times\mathbb{R}_{+}^{L-1},\ u(x)\equiv x_{k}+\varphi(x_{-k})$
\end_inset


\end_layout

\begin_layout Standard
Suppose for contradiction that 
\begin_inset Formula $x(p,w)+z$
\end_inset

 does not maximize utility on 
\begin_inset Formula $B(p,w^{\prime})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies\exists\ v\in B(p,w^{\prime}):v\succ x(p,w)+z$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff u(v)>u(x(p,w)+z)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff v_{k}+\varphi(v_{-k})>\left(x_{k}+c\right)+\varphi(x_{-k})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff\left(v_{k}-c\right)+\varphi(v_{-k})>x_{k}+\varphi(x_{-k})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff u(v-z)>u(x(p,w))$
\end_inset


\end_layout

\begin_layout Standard
Now, 
\begin_inset Formula $p\cdot(v-z)=p\cdot v-p\cdot z$
\end_inset


\end_layout

