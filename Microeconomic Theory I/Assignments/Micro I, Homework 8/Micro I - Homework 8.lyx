 such that 
\begin_inset Formula ${\displaystyle \sum_{i=1}^{k}}\alpha_{i}=1,\delta_{z_{1}}\succsim\left[\alpha_{1}\delta_{z_{1}}+\ldots+\alpha_{k}\delta_{z_{k}}\right]\succsim\delta_{z_{k}}$
\end_inset


\end_layout

\begin_layout Standard
Note, 
\begin_inset Formula $\forall\ \left(\alpha_{i}\right)_{i=1}^{k}\in\mathbb{R}_{+}^{n},\left[\alpha_{1}\delta_{z_{1}}+\ldots+\alpha_{k}\delta_{z_{k}}\right]\in\Delta(Z)$
\end_inset

 
\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\delta_{z_{i}}\equiv(e_{i})$
\end_inset

, then 
\begin_inset Formula $\{\delta_{z_{1}},\ldots,\delta_{z_{n}}\}$
\end_inset

 forms a basis for 
\begin_inset Formula $\Delta(Z)$
\end_inset


\end_layout

\begin_layout Standard
So, any element in 
\begin_inset Formula $\Delta(Z)$
\end_inset

 can be represented by a linear combination of these vectors
\end_layout

\begin_layout Standard
Thus, 
\begin_inset Formula $\forall\ \pi\in\Delta(Z),\exists\left(\alpha_{i}\right)_{i=1}^{k}\in\mathbb{R}_{+}^{n}:\pi=\left[\alpha_{1}\delta_{z_{1}}+\ldots+\alpha_{k}\delta_{z_{k}}\right]$
\end_inset


\end_layout

\begin_layout Standard
Therefore, 
\begin_inset Formula $\forall\ \pi\in\Delta(Z),\overline{\pi}\succsim\pi\succsim\underline{\pi}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
Q.E.D.
\end_layout

