\begin_layout Standard
Take 
\begin_inset Formula $\pi\in\Delta(Z)$
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $E_{\pi}v$
\end_inset

 represents the preferences 
\begin_inset Formula $\succsim$
\end_inset

, define 
\begin_inset Formula $\lambda_{\pi}\in[0,1]$
\end_inset

 by
\end_layout

\begin_layout Standard
\begin_inset Formula $E_{\pi}v=\lambda_{\pi}E_{\overline{\pi}}v+(1-\lambda_{\pi})E_{\underline{\pi}}v$
\end_inset


\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $\lambda_{\pi}=\frac{E_{\pi}v-E_{\underline{\pi}}v}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}$
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(8.1)$
