\begin_inset Formula $=\frac{E_{\pi}vE_{\overline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}-\frac{E_{\pi}vE_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}+\frac{E_{\overline{\pi}}vE_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}-\frac{E_{\underline{\pi}}vE_{\overline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}+\frac{E_{\underline{\pi}}vE_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}-\frac{E_{\underline{\pi}}vE_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $=\left[\frac{E_{\overline{\pi}}u-E_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}\right]E_{\pi}v+\left[\frac{E_{\overline{\pi}}vE_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}-\frac{E_{\underline{\pi}}vE_{\overline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}\right]$
\end_inset


\end_layout

\begin_layout Standard
Define 
\begin_inset Formula $\alpha\equiv\left[\frac{E_{\overline{\pi}}u-E_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}\right]$
\end_inset

 and 
\begin_inset Formula $\beta\equiv\left[\frac{E_{\overline{\pi}}vE_{\underline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}-\frac{E_{\underline{\pi}}vE_{\overline{\pi}}u}{E_{\overline{\pi}}v-E_{\underline{\pi}}v}\right]$
\end_inset


\end_layout

\begin_layout Standard
Now, 
\begin_inset Formula $E_{\pi}u=\alpha E_{\pi}v+\beta$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \sum_{z\in Z}u(z)\pi(z)={\displaystyle \sum_{z\in Z}\alpha v(z)\pi(z)+\beta=\sum_{z\in Z}\alpha v(z)\pi(z)+\sum_{z\in Z}\beta\pi(z)=\sum_{z\in Z}\left[\alpha v(z)+b\right]\pi(z)}}$
\end_inset


\end_layout

\begin_layout Standard
So, we have 
\begin_inset Formula $\sum_{z\in Z}u(z)\pi(z)={\displaystyle \sum_{z\in Z}\left[\alpha v(z)+b\right]\pi(z)}$
\end_inset


\end_layout

\begin_layout Standard
Note, 
\begin_inset Formula $\pi(z)$
\end_inset

 is the same on both sides for all 
\begin_inset Formula $z\in Z$
\end_inset


\end_layout

\begin_layout Standard
Thus, 
\begin_inset Formula $\forall\ z\in Z,u(z)=\left[\alpha v(z)+b\right]$
\end_inset


\end_layout

\begin_layout Standard
Therefore, 
\begin_inset Formula $\exists\ a\in\mathbb{R}_{++},\exists\ b\in\mathbb{R},\forall\ z\in Z:u(z)=av(z)+b$
\end_inset


\end_layout

