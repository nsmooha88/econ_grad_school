\end_inset


\end_layout

\begin_layout Standard

\series bold
(c) Provide an explicit proof of 
\begin_inset Formula $\left(\Longleftarrow\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $m_{p}(x)\geq m_{p}(y)$
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
Want to show:
\series default
\emph default
 
\begin_inset Formula $x\succeq y$
\end_inset


\end_layout

\begin_layout Standard
Suppose for contradiction 
\begin_inset Formula $\neg(x\succeq y)$
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\succeq$
\end_inset

 is complete, then 
\begin_inset Formula $(y\succeq x)$
\end_inset


\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $(y\succeq x)$
\end_inset

 and 
\begin_inset Formula $\neg(x\succeq y)\implies y\succ x$
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\succeq$
\end_inset

 is monotone and continuous, 
\begin_inset Formula $y\neq0$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $x^{*}\in\mathbb{R}_{+}^{L}$
\end_inset

 such that 
\begin_inset Formula $x^{*}\succeq x$
\end_inset

 and 
\begin_inset Formula $m_{p}(x)=p\cdot x^{*}=\begin{array}{c}
\mbox{min}\\
z\in U(\succeq,x)
\end{array}p\cdot z$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $y^{*}\in\mathbb{R}_{+}^{L}$
\end_inset

 such that 
\begin_inset Formula $y^{*}\succeq x$
\end_inset

 and 
\begin_inset Formula $m_{p}(y)=p\cdot y^{*}=\begin{array}{c}
\mbox{min}\\
t\in U(\succeq,y)
\end{array}p\cdot t$
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\succeq$
\end_inset

 is a preference, then 
\begin_inset Formula $\succeq$
\end_inset

 is continuous 
\begin_inset Formula $\iff$
\end_inset

 
\begin_inset Formula $\succeq$
\end_inset

 is continuous* by Theorem 7
\end_layout

\begin_layout Standard
\begin_inset Formula $\succeq$
\end_inset

 is continuous* 
\begin_inset Formula $\iff\forall\ x\in\mathbb{R}_{+}^{L}$
\end_inset

, 
\begin_inset Formula $U(\succeq,x)$
\end_inset

 and 
\begin_inset Formula $L(\succeq,x)$
\end_inset

 are closed in 
\begin_inset Formula $\mathbb{R}_{+}^{L}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $L(\succeq,x)$
\end_inset

 is closed 
\begin_inset Formula $\iff L(\succeq,x)^{c}=U(\succ,x)$
\end_inset

 is open
\end_layout

\begin_layout Standard
\begin_inset Formula $y^{*}\succeq y\succ x\implies y^{*}\succ x$
\end_inset

 by transitivity of 
\begin_inset Formula $\succeq$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies y^{*}\in U(\succ,x)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies\exists\ \epsilon>0$
\end_inset

 such that 
\begin_inset Formula $B_{\epsilon}^{X}(y^{*})\subseteq U(\succ,x)$
\end_inset


\end_layout

\begin_layout Standard
Define 
\begin_inset Formula $\tilde{y}=\left(\tilde{y_{i}}=\mbox{max}\left\{ y_{i}^{*}-\frac{\epsilon}{2},0\right\} ,i=1\ldots,L\right)$
\end_inset


\end_layout

\begin_layout Standard
Now, 
\begin_inset Formula $\tilde{y}\in B_{\epsilon}^{X}(y^{*})\implies\tilde{y}\in U(\succ,x)\implies\tilde{y}\succ x$
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $y^{*}\gneq\tilde{y}$
\end_inset

 and 
\begin_inset Formula $p\in\mathbb{R}_{++}^{L}$
\end_inset

, 
\begin_inset Formula $p\cdot x^{*}\geq p\cdot y^{*}>p\cdot\tilde{y}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies p\cdot x^{*}>p\cdot\tilde{y}$
\end_inset


\end_layout

\begin_layout Standard
But, 
\begin_inset Formula $p\cdot x^{*}>p\cdot\tilde{y}$
\end_inset

 and 
\begin_inset Formula $\tilde{y}\succ x$
\end_inset

 contradicts 
\begin_inset Formula $p\cdot x^{*}=\begin{array}{c}
\mbox{min}\\
z\in U(\succeq,x)
\end{array}p\cdot z\ \ \ \left(\rightarrow\leftarrow\right)$
\end_inset


\end_layout

\begin_layout Standard
Therefore, 
\begin_inset Formula $x\succeq y$
\end_inset


\end_layout

