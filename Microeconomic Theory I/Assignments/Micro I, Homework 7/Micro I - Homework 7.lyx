\align center
\begin_inset Formula $x^{\succsim^{m}}(p,w)\equiv\begin{cases}
\left(\frac{w}{p_{1}+p_{2}},\frac{w}{p_{1}+p_{2}}\right) & \mbox{if}\ \mbox{min}\ \{x_{1},x_{2}\}\leq1\\
\left(\frac{1}{m}\left[\frac{w-p_{1}\frac{m-1}{m}}{\frac{p_{1}}{m}+p_{2}}\right]+\frac{m-1}{m},\frac{w-p_{1}\frac{m-1}{m}}{\frac{p_{1}}{m}+p_{2}}\right) & \mbox{if}\ \mbox{min}\ \{x_{1},x_{2}\}>1
\end{cases}$
\end_inset


\end_layout

\begin_layout Standard
Take 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset


\end_layout

\begin_layout Standard
Take 
\begin_inset Formula $\{p,p^{\prime}\}\subseteq\mathbb{R}_{++}^{2}$
\end_inset

 such that 
\end_layout

\begin_layout Standard
\begin_inset Formula $x^{\succsim^{m}}(p,w)=\left(\frac{w}{p_{1}+p_{2}},\frac{w}{p_{1}+p_{2}}\right)$
\end_inset

 
\end_layout

\begin_layout Standard
\begin_inset Formula $x^{\succsim^{m}}(p^{\prime},w)=\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]+\frac{m-1}{m},\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right)$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $x_{1}^{\succsim^{m}}(p,w)=x_{2}^{\succsim^{m}}(p,w)=1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies w=p_{1}+p_{2}$
\end_inset


\end_layout

\begin_layout Standard
Also, suppose 
\begin_inset Formula $x_{1}^{\succsim^{m}}(p^{\prime},w)>x_{1}^{\succsim^{m}}(p,w)$
\end_inset


\end_layout

\begin_layout Standard
Now, consider 
\begin_inset Formula $(p^{\prime}-p)\cdot\left[x^{\succsim^{m}}(p^{\prime},w)-x^{\succsim^{m}}(p,w)\right]$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=(p_{1}^{\prime}-p_{1})\left[x_{1}^{\succsim^{m}}(p^{\prime},w)-x_{1}^{\succsim^{m}}(p,w)\right]+(p_{2}^{\prime}-p_{2})\left[x_{2}^{\succsim^{m}}(p^{\prime},w)-x_{2}^{\succsim^{m}}(p,w)\right]$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=(p_{1}^{\prime}-p_{1})\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]+\frac{m-1}{m}-1\right)+(p_{2}^{\prime}-p_{2})\left(\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}-1\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=(p_{1}^{\prime}-p_{1})\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)+(p_{2}^{\prime}-p_{2})\left(\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}-1\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=(p_{1}^{\prime}-p_{1})\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)+(p_{2}^{\prime}-p_{2})m\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=\left[(p_{1}^{\prime}-p_{1})+m(p_{2}^{\prime}-p_{2})\right]\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)$
\end_inset


\end_layout

\begin_layout Standard
Note, 
\begin_inset Formula $x_{1}^{\succsim^{m}}(p^{\prime},w)-x_{1}^{\succsim^{m}}(p,w)=\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)$
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $x_{1}^{\succsim^{m}}(p^{\prime},w)>x_{1}^{\succsim^{m}}(p,w)$
\end_inset

, then 
\begin_inset Formula $\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)>0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\left(\frac{1}{m}\left[\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}\right]-\frac{1}{m}\right)>0\iff\frac{w-p_{1}^{\prime}\frac{m-1}{m}}{\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}}>1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff w-p_{1}^{\prime}(1-\frac{1}{m})>\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff(p_{1}+p_{2})-p_{1}^{\prime}(1-\frac{1}{m})>\frac{p_{1}^{\prime}}{m}+p_{2}^{\prime}$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $w=p_{1}+p_{2}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff(p_{1}^{\prime}-p_{1})+(p_{2}^{\prime}-p_{2})<0$
\end_inset


\end_layout

\begin_layout Standard
Thus, for 
\begin_inset Formula $x^{\succsim^{m}}(p,w)$
\end_inset

 to violate the Uncompensated Law of Demand, i.e., 
\begin_inset Formula $(p^{\prime}-p)\cdot\left[x^{\succsim^{m}}(p^{\prime},w)-x^{\succsim^{m}}(p,w)\right]>0$
\end_inset


\end_layout

\begin_layout Standard
we need to find 
\begin_inset Formula $p,p^{\prime},m$
\end_inset

 such that 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $\left[(p_{1}^{\prime}-p_{1})+m(p_{2}^{\prime}-p_{2})\right]>0$
\end_inset

 and 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $(p_{1}^{\prime}-p_{1})+(p_{2}^{\prime}-p_{2})<0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
Q.E.D.
\end_layout

