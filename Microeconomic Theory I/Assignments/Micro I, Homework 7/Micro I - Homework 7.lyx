\begin_layout Standard

\series bold
2.
 For each 
\begin_inset Formula $i\in N$
\end_inset

, 
\begin_inset Formula $\succsim^{i}$
\end_inset

 is homothetic, and for each pair 
\begin_inset Formula $\{i,j\}\subseteq N$
\end_inset

, 
\begin_inset Formula $\succsim^{i}=\succsim^{j}$
\end_inset

.
\end_layout

\begin_layout Standard
By Theore 10, a continuous preference 
\begin_inset Formula $\succsim^{i}$
\end_inset

 is homothetic if and only if it admits a continuous representation 
\begin_inset Formula $u^{i}:X\rightarrow\mathbb{R}$
\end_inset

 that is homogeneous of degree one, i.e., such that 
\begin_inset Formula $\forall\ \alpha\in\mathbb{R}_{+}$
\end_inset

, 
\begin_inset Formula $u^{i}(\alpha x)=\alpha u^{i}(x)$
\end_inset

.
\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\forall\{i,j\}\subseteq N,\succsim^{i}=\succsim^{j}$
\end_inset

, then 
\begin_inset Formula $u^{i}(x)=u(x)\ \forall\ i\in N$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies x^{i}(p,w^{i})=x(p,w^{i})\ \forall\ i\in N$
\end_inset


\end_layout

\begin_layout Standard
Take 
\begin_inset Formula $i\in N$
\end_inset


\end_layout

\begin_layout Standard
Now, let 
\begin_inset Formula $y\in B(p,w^{i})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies\left(\frac{1}{w^{i}}\right)y\in B(p,1)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies x(p,1)\succsim\left(\frac{1}{w^{i}}\right)y$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff u\left(x(p,1)\right)\geq u\left(\left(\frac{1}{w^{i}}\right)y\right)$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $u^{i}$
\end_inset

 represents 
\begin_inset Formula $\succsim^{i}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff w^{i}u\left(x(p,1)\right)\geq w^{i}u\left(\left(\frac{1}{w^{i}}\right)y\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\iff u\left(w^{i}x^{i}(p,1)\right)\geq u\left(y\right)$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $u^{i}$
\end_inset

 is homogeneous of degree zero
\end_layout

\begin_layout Standard
\begin_inset Formula $\iff w^{i}\cdot x(p,1)\geq y$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies x(p,w^{i})=w^{i}\cdot x(p,1)$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $x$
\end_inset

 is a demand function, so it is unique.
\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $i$
\end_inset

 was an arbitrary agent from the set 
\begin_inset Formula $N$
\end_inset

, then this result holds 
\begin_inset Formula $\forall\ i\in N$
\end_inset


\end_layout

\begin_layout Standard
Now, 
\begin_inset Formula $SD(p,w)\equiv\sum_{i\in N}x^{i}(p,w^{i})=\sum_{i\in N}x(p,w^{i})=\sum_{i\in N}w^{i}\cdot x(p,1)=\mu\cdot x(p,1)$
\end_inset


\end_layout

\begin_layout Standard
Also, 
\begin_inset Formula $SD(p,\bar{w})\equiv\sum_{i\in N}x^{i}(p,\bar{w}^{i})=\sum_{i\in N}x(p,\bar{w}^{i})=\sum_{i\in N}\bar{w}^{i}\cdot x(p,1)=\mu\cdot x(p,1)$
\end_inset


\end_layout

\begin_layout Standard
Thus, 
\begin_inset Formula $SD(p,w)=SD(p,\bar{w})$
\end_inset


\end_layout

\begin_layout Standard
Therefore, 
\begin_inset Formula $AD(p,\mu)$
\end_inset

 is well defined
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

