\begin_layout Standard
Thus, preferences are monotone and stricly convex, so the demand correspondence
 is single-valued, and the demand function satifies Walras' Law.
\end_layout

\begin_layout Standard
The associated demand function is given by:
\end_layout

\begin_layout Standard
\begin_inset Formula $x^{\succsim}(p,w)\equiv\left(\frac{w}{p_{1}+p_{2}},\frac{w}{p_{1}+p_{2}}\right)$
\end_inset


\end_layout

\begin_layout Standard
Take 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset


\end_layout

\begin_layout Standard
Take 
\begin_inset Formula $\{p,p^{\prime}\}\subseteq\mathbb{R}_{++}^{2}$
\end_inset


\end_layout

\begin_layout Standard
Now, consider 
\begin_inset Formula $(p^{\prime}-p)\cdot\left[x^{\succsim}(p^{\prime},w)-x^{\succsim}(p,w)\right]$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=(p_{1}^{\prime}-p_{1})\left[\frac{w}{p_{1}^{\prime}+p_{2}^{\prime}}-\frac{w}{p_{1}+p_{2}}\right]+(p_{2}^{\prime}-p_{2})\left[\frac{w}{p_{1}^{\prime}+p_{2}^{\prime}}-\frac{w}{p_{1}+p_{2}}\right]$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=\left[\frac{w}{p_{1}^{\prime}+p_{2}^{\prime}}-\frac{w}{p_{1}+p_{2}}\right](p_{1}^{\prime}-p_{1}+p_{2}^{\prime}-p_{2})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=w\left[\frac{p_{1}+p_{2}-p_{1}^{\prime}-p_{2}^{\prime}}{(p_{1}^{\prime}+p_{2}^{\prime})(p_{1}+p_{2})}\right](p_{1}^{\prime}-p_{1}+p_{2}^{\prime}-p_{2})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=-w\left[\frac{p_{1}+p_{2}-p_{1}^{\prime}-p_{2}^{\prime}}{(p_{1}^{\prime}+p_{2}^{\prime})(p_{1}+p_{2})}\right]^{2}\leq0$
\end_inset


\end_layout

\begin_layout Standard
Thus, the associated demand function satisfies the uncompensated law of
 demand.
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

