\begin_layout Standard
\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $\begin{array}{cccc}
 & p & \longmapsto & x_{l}^{M^{i}}(p)\equiv x_{l}^{i}(p,w^{i})\ \mbox{for some}\ w^{i}\in\mathbb{R}_{++}\end{array}$
\end_inset


\end_layout

\begin_layout Standard
From homework 5, since preferences are continuous and locally non-satiated,
 then agent 
\begin_inset Formula $i$
\end_inset

's Marshallian demand for good 
\begin_inset Formula $l$
\end_inset

 is well defined, i.e., 
\begin_inset Formula $\forall\ p\gg0$
\end_inset

 and each 
\begin_inset Formula $\left\{ w^{i},\bar{w}^{i}\right\} \subseteq\mathbb{R}_{++}$
\end_inset

, 
\begin_inset Formula $x_{l}^{i}\left(p,w^{i}\right)=x_{l}^{i}\left(p,\bar{w}^{i}\right)$
\end_inset


\end_layout

\begin_layout Standard
As a result, for 
\begin_inset Formula $l\neq k$
\end_inset

, 
\begin_inset Formula $\sum_{i\in N}x_{l}^{i}(p,w^{i})=\sum_{i\in N}x_{l}^{i}(p,\bar{w}^{i})$
\end_inset


\end_layout

\begin_layout Standard
Also, 
\begin_inset Formula $\sum_{l\ne k}x_{l}^{i}\left(p,w^{i}\right)=\sum_{l\ne k}x_{l}^{i}\left(p,\bar{w}^{i}\right)$
\end_inset


\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $\sum_{l\ne k}p_{l}\cdot x_{l}^{i}\left(p,w^{i}\right)=\sum_{l\ne k}p_{l}\cdot x_{l}^{i}\left(p,\bar{w}^{i}\right)$
\end_inset


\end_layout

\begin_layout Standard
Since Walras' Law holds, we can find an equation for the demand of commodity
 
\begin_inset Formula $k$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $x_{k}^{i}(p,w^{i})=\frac{w^{i}}{p_{k}}-\frac{\sum_{l\ne k}p_{l}\cdot x_{l}^{i}\left(p,w^{i}\right)}{p_{k}}$
\end_inset

 and 
\begin_inset Formula $x_{k}^{i}\left(p,\bar{w}^{i}\right)=\frac{\bar{w}^{i}}{p_{k}}-\frac{\sum_{l\ne k}p_{l}\cdot x_{l}^{i}\left(p,\bar{w}^{i}\right)}{p_{k}}$
\end_inset


\end_layout

\begin_layout Standard
Now, 
\begin_inset Formula $\sum_{i\in N}x_{k}^{i}(p,w^{i})-\sum_{i\in N}x_{k}^{i}\left(p,\bar{w}^{i}\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=\sum_{i\in N}\frac{w^{i}}{p_{k}}-\sum_{i\in N}\frac{\bar{w}^{i}}{p_{k}}$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $\sum_{l\ne k}p_{l}\cdot x_{l}^{i}\left(p,w^{i}\right)=\sum_{l\ne k}p_{l}\cdot x_{l}^{i}\left(p,\bar{w}^{i}\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $=\frac{\mu}{p_{k}}-\frac{\mu}{p_{k}}=0$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $\sum_{i\in N}w^{i}=\sum_{i\in N}\bar{w}^{i}=\mu$
\end_inset


\end_layout

\begin_layout Standard
Hence, 
\begin_inset Formula $\sum_{i\in N}x_{k}^{i}(p,w^{i})=\sum_{i\in N}x_{k}^{i}(p,\bar{w}^{i})$
\end_inset


\end_layout

\begin_layout Standard
Thus, 
\begin_inset Formula $SD(p,w)=SD(p,\bar{w})$
\end_inset


\end_layout

\begin_layout Standard
Therefore, 
\begin_inset Formula $AD(p,\mu)$
\end_inset

 is well defined
\end_layout

