\begin_layout Problem
Suppose that there is a risk free asset that returns 
\begin_inset Formula $r>0$
\end_inset

 dollars for each dollar invested and a risky asset that for each dollar
 invested returns 0 dollars with probability 
\begin_inset Formula $\frac{1}{2}$
\end_inset

 and 
\begin_inset Formula $3r>0$
\end_inset

 with probability 
\begin_inset Formula $\frac{1}{2}$
\end_inset

.
 Let 
\begin_inset Formula $\succsim$
\end_inset

 be an expected utility maximizer whose associated index is 
\begin_inset Formula $u$
\end_inset

.
 Assume that the agent is risk averse and has 
\begin_inset Formula $w$
\end_inset

 dollars to allocate between these two assets.
\end_layout

\begin_deeper
\begin_layout Enumerate
Characterize the agent's optimal portfolio.
\end_layout

\begin_layout Enumerate
Assume that the agent exhibits decreasing relative risk aversion.
 Prove that her demand of the risky asset as a proportion of total wealth
 increases with wealth.
\end_layout

\begin_layout Enumerate
Select 
\begin_inset Formula $u$
\end_inset

 that exhibits constant relative risk aversion (find one).
 Calculate the demand of the risky asset as a proportion of total wealth.
 Is it constant?
\end_layout

\end_deeper
\begin_layout Proof
Let 
\begin_inset Formula $\succsim$
\end_inset

 be an expected utility maximizer whose associated index is 
\begin_inset Formula $u$
\end_inset

.
 Assume that the agent is risk averse and has 
\begin_inset Formula $w$
\end_inset

 dollards to allocate between these two assets.
\end_layout

\begin_layout Proof

\bar under
Part A.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Let 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $x$
\end_inset

 be the percentage of wealth invested in the risky asset.
 To characterize the agent's optimal portfolio, we maximize her expected
 utility
\begin_inset Formula 
\[
\max_{0\leq x\leq w}\frac{1}{2}u\left(2xrw+rw\right)+\frac{1}{2}u\left(wr-xrw\right)
\]

\end_inset

We derive the first order condition of 
\begin_inset Formula $E_{F}u$
\end_inset

 with respect to 
\begin_inset Formula $x$
\end_inset

 to characterize the optimal amount of 
\begin_inset Formula $x$
\end_inset

 to invest.
\begin_inset Formula 
\[
2u^{\prime}(2xrw+rw)=u^{\prime}(wr-xrw)
\]

\end_inset

The optimal 
\begin_inset Formula $x^{*}$
\end_inset

 satisfies this first-order condition
\end_layout

\begin_layout Proof

\bar under
Part B.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Assume that the agent exhibits decreasing relative risk aversion.
 Prove that her demand of the risky asset as a proportion of total wealth
 increases with wealth.
 Take 
\begin_inset Formula $\{w_{1},w_{2}\}\in\mathbb{R}$
\end_inset

 such that 
\begin_inset Formula $w_{2}>w_{1}$
\end_inset

.
 Since the agent exhibits decreasing relative risk aversion, then by Theorem
 26, there exists an increasing and concave function 
\begin_inset Formula $\psi$
\end_inset

 such that 
\begin_inset Formula $u(w_{1}\cdot)=\psi(u_{2}(w_{2}\cdot))$
\end_inset

.
 So, 
\begin_inset Formula 
\begin{equation}
D_{x}\left[u(w_{1}x)\right]=D_{x}\left[\psi(u(w_{2}x))\right]=w_{2}u^{\prime}(w_{2}x)\psi^{\prime}(u(w_{2}x))
\end{equation}

\end_inset

Let 
\begin_inset Formula $x_{1}$
\end_inset

 and 
\begin_inset Formula $x_{2}$
\end_inset

 be the optimal percentage invested in the risky assets under wealths 
\begin_inset Formula $w_{1}$
\end_inset

 and 
\begin_inset Formula $w_{2}$
\end_inset

, respectively.
 We want to show that 
\begin_inset Formula $x_{2}>x_{1}$
\end_inset

.
 From part A, the first-order condition for 
\begin_inset Formula $x_{1}$
\end_inset

 is
\begin_inset Formula 
\[
2u^{\prime}(2x_{1}rw_{1}+rw_{1})=u^{\prime}(w_{1}r-x_{1}rw_{1})
\]

\end_inset

Substituting expression (2) into the equation above yields
\begin_inset Formula 
\[
2w_{2}u^{\prime}(2x_{1}rw_{2}+rw_{2})\psi^{\prime}\left(u(2x_{1}rw_{2}+rw_{2})\right)=w_{2}u^{\prime}(w_{2}r-x_{1}rw_{2})\psi^{\prime}\left(u(w_{2}r-x_{1}rw_{2})\right)
\]

\end_inset

Since 
\begin_inset Formula $u$
\end_inset

 is an increasing function, then 
\begin_inset Formula $u(2x_{1}rw_{2}+rw_{2})>u(w_{2}r-x_{1}rw_{2})$
\end_inset

.
 Since 
\begin_inset Formula $\psi$
\end_inset

 is a concave function, then
\begin_inset Formula 
\begin{eqnarray*}
\psi^{\prime}\left(u(w_{2}r-x_{1}rw_{2})\right) & > & \psi^{\prime}\left(u(2x_{1}rw_{2}+rw_{2})\right)\\
\frac{\psi^{\prime}\left(u(w_{2}r-xrw_{2})\right)}{\psi^{\prime}\left(u(2xrw_{2}+rw_{2})\right)} & > & 1
\end{eqnarray*}

\end_inset

Thus, we have
\begin_inset Formula 
\[
2u^{\prime}(2x_{1}rw_{2}+rw_{2})>u^{\prime}(w_{2}r-x_{1}rw_{2})
\]

\end_inset

From part A, 
\begin_inset Formula $x_{2}$
\end_inset

 must satisfy the F.O.C.
 of agent 2
\begin_inset Formula 
\[
2u^{\prime}(2x_{2}rw_{2}+rw_{2})=u^{\prime}(w_{2}r-x_{2}rw_{2})
\]

\end_inset

Since 
\begin_inset Formula $u$
\end_inset

 is a concave function with decreasing marginal utility, then 
\begin_inset Formula $x_{2}>x_{1}$
\end_inset

.
\end_layout

\begin_layout Proof

\bar under
Part C.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Assume 
\begin_inset Formula $\succsim$
\end_inset

 is represented by 
\begin_inset Formula $E\left\{ u(x)\right\} $
\end_inset

 where 
\begin_inset Formula $u(x)=\ln(x)$
\end_inset

.
 We show that 
\begin_inset Formula $\succsim$
\end_inset

 exhibits constant relative risk aversion.
\begin_inset Formula 
\[
r_{R}^{u}(x)=-x\frac{u^{\prime\prime}(x)}{u^{\prime}(x)}
\]

\end_inset

Since 
\begin_inset Formula $u^{\prime}(x)=\nicefrac{1}{x}$
\end_inset

 and 
\begin_inset Formula $u^{\prime\prime}(x)=-\nicefrac{1}{x^{2}}$
\end_inset

, then
\begin_inset Formula 
\[
r_{R}^{u}=x\frac{x}{x^{2}}=1
\]

\end_inset

Thus, 
\begin_inset Formula $\succsim$
\end_inset

 exhibits constant relative risk aversion.
 
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Now, we can obtain an expression for the demand of the risky asset as a
 proportion of total wealth.
 From part A, we know that the optimal 
\begin_inset Formula $x^{*}$
\end_inset

 satisfies the first-order condition
\begin_inset Formula 
\[
2u^{\prime}(2xrw+rw)=u^{\prime}(wr-xrw)
\]

\end_inset

Using 
\begin_inset Formula $u(x)=\ln(x)$
\end_inset

 as the utility funciton yields
\begin_inset Formula 
\begin{eqnarray*}
2\frac{1}{2xrw+rw} & = & \frac{1}{wr-xrw}\\
2(wr-xrw) & = & 2xrw+rw\\
2wr-2xrw & = & 2xrw+rw\\
4xrw & = & wr\\
x & = & \frac{1}{4}
\end{eqnarray*}

\end_inset

Therefore, the demand of the risky asset as a proportion of total wealth
 is constant.
\end_layout

\begin_layout Problem
An expected utility maximizer over lotteries of money has utility index
 
\begin_inset Formula $u$
\end_inset

 and initial wealth 
\begin_inset Formula $w$
\end_inset

.
 Lottery 
\begin_inset Formula $l$
\end_inset

 offers a payoff of 
\begin_inset Formula $x>0$
\end_inset

 dollars with probability 
\begin_inset Formula $\alpha$
\end_inset

 and a payoff of 
\begin_inset Formula $y>x$
\end_inset

 dollars with probability 
\begin_inset Formula $(1-\alpha)$
\end_inset

.
