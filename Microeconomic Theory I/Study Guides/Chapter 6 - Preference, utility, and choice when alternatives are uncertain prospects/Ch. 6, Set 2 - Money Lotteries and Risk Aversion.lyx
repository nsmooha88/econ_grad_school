\begin_layout Section*
6.7
\begin_inset space \quad{}
\end_inset

Problems
\end_layout

\begin_layout Problem
Let 
\begin_inset Formula $u:\mathbb{R}\rightarrow\mathbb{R}$
\end_inset

 be a non-decreasing and concave function.
 Prove that for each 
\begin_inset Formula $x\in\mathbb{R}$
\end_inset

, 
\begin_inset Formula $r_{A}(x,u)=a>0$
\end_inset

, if and only if 
\begin_inset Formula $u$
\end_inset

 is an affine linear transformation of the function 
\begin_inset Formula $x\in\mathbb{R}\mapsto\tilde{u}(x)\equiv-e^{-ax}$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $u:\mathbb{R}\rightarrow\mathbb{R}$
\end_inset

 be a non-decreasing and concave function.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Rightarrow)$
\end_inset

 Assume 
\begin_inset Formula $\forall\ x\in\mathbb{R}:r_{A}(x,u)=a>0$
\end_inset

.
 We want to show that 
\begin_inset Formula $u$
\end_inset

 is an affine linear transformation of the function 
\begin_inset Formula $x\in\mathbb{R}\mapsto\tilde{u}(x)\equiv-e^{-ax}$
\end_inset

.
 The coefficient of absolute risk aversion of 
\begin_inset Formula $u$
\end_inset

 at 
\begin_inset Formula $x$
\end_inset

 is
\begin_inset Formula 
\begin{eqnarray*}
r_{A}(x,u) & = & -\frac{u^{\prime\prime}(x)}{u^{\prime}(x)}\\
-\frac{u^{\prime\prime}(x)}{u^{\prime}(x)} & = & a\\
u^{\prime\prime}(x)+au^{\prime}(x) & = & 0
\end{eqnarray*}

\end_inset

To solve this second-order differential equation, we must first find the
 roots of the characteristic equation: 
\begin_inset Formula $\lambda^{2}+\alpha\lambda=0$
\end_inset

.
 Thus, 
\begin_inset Formula $\lambda\in\{0,-a\}$
\end_inset

.
 The general solution to the second-order homogenuous linear differential
 equation is:
\begin_inset Formula 
\[
u(x)=-c_{1}e^{-ax}+c_{2}
\]

\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Leftarrow)$
\end_inset

 Assume 
\begin_inset Formula $u$
\end_inset

 is an affine linear transformation of 
\begin_inset Formula $\tilde{u}(x)=-e^{-ax}$
\end_inset

.
 We want to show that 
\begin_inset Formula $\forall\ x\in\mathbb{R}:r_{A}(x,u)=a>0$
\end_inset

.
 Take 
\begin_inset Formula $x\in\mathbb{R}$
\end_inset

.
 Let 
\begin_inset Formula $u(x)=\alpha\left(-e^{-ax}\right)+\beta$
\end_inset

 where 
\begin_inset Formula $\{\alpha,\beta\}\subseteq\mathbb{R}$
\end_inset

.
\begin_inset Formula 
\begin{eqnarray*}
u^{\prime}(x) & = & \alpha ae^{-ax}\\
u^{\prime\prime}(x) & = & -\alpha a^{2}e^{-ax}
\end{eqnarray*}

\end_inset

Thus, the coefficient of absolute risk aversion of 
\begin_inset Formula $u$
\end_inset

 at 
\begin_inset Formula $x$
\end_inset

 is
\begin_inset Formula 
\[
r_{A}(x,u)=-\frac{u^{\prime\prime}(x)}{u^{\prime}(x)}=-\frac{-\alpha\cdot a^{2}\cdot e^{-ax}}{\alpha\cdot a\cdot e^{-ax}}=a>0
\]

\end_inset


\end_layout

\begin_layout Problem
Suppose that there is a risk free asset that returns 
\begin_inset Formula $r>0$
\end_inset

 dollars for each dollar invested and a risky asset that for each dollar
 invested returns 
\begin_inset Formula $0$
\end_inset

 dollars with probability 
\begin_inset Formula $\frac{1}{2}$
\end_inset

 and 
\begin_inset Formula $3r>0$
\end_inset

 dollars with probability 
\begin_inset Formula $\frac{1}{2}$
\end_inset

.
 Let 
\begin_inset Formula $\succsim_{1}$
\end_inset

 and 
\begin_inset Formula $\succsim_{2}$
\end_inset

 be two expected utility maximizers with indices 
\begin_inset Formula $u_{1}$
\end_inset

 and 
\begin_inset Formula $u_{2}$
\end_inset

, respectively.
 Assume that both agents are risk averse and that each of them has a budget
 of one hundred dollars to allocate between these two assets.
\end_layout

\begin_deeper
\begin_layout Enumerate
Characterize the agents' optimal portfolio.
\end_layout

\begin_layout Enumerate
Prove that at their optimal portfolio, the agents buy a non-zero amount
 of the risky asset.
\end_layout

\begin_layout Enumerate
Prove that if agent 1 is more risk averse than agent 2, then at her optimal
 portfolio, agent 2's optimal share of the risky asset is greater than or
 equal to agent 1's.
\end_layout

\end_deeper
\begin_layout Proof
We solve each part independently.
\end_layout

\begin_layout Proof

\bar under
Part A.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Let 
\begin_inset Formula $x_{1}$
\end_inset

 and 
\begin_inset Formula $x_{2}$
\end_inset

 be the respective investments for agents 1 and 2 in the risky asset.
 Each agent is an expected utility maximizer.
\begin_inset Formula 
\[
\max_{0\leq x_{i}\leq100}\ \frac{1}{2}u_{i}\left[(100-x_{i})r+x_{i}3r\right]+\frac{1}{2}u_{i}\left[(100-x_{i})r\right]
\]

\end_inset

To find the optimal portfolio, we derive the first-order condition with
 respect to 
\begin_inset Formula $x_{i}$
\end_inset

 
\begin_inset Formula 
\begin{eqnarray*}
\frac{1}{2}u_{i}^{\prime}\left(100r+2x_{i}r\right)2r-\frac{1}{2}u_{i}^{\prime}\left(100r-x_{i}r\right)r & = & 0\\
2u_{i}^{\prime}(100r+2x_{i}r) & = & u_{i}^{\prime}(100r-x_{i}r)
\end{eqnarray*}

\end_inset


\bar under
Part B.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

We want to show that at their optimal portfolio, the agents buy a non-zero
 amount of the risky asset, i.e., 
\begin_inset Formula $\forall\ i\in\{1,2\}:x_{i}^{*}\neq0$
\end_inset

.
 From the first-order condition, we have
\begin_inset Formula 
\[
u_{i}^{\prime}(100r-x_{i}r)>u_{i}^{\prime}(100r+2x_{i}r)
\]

\end_inset

Since 
\begin_inset Formula $u$
\end_inset

 is a concave function, then
\begin_inset Formula 
\begin{eqnarray*}
100r-x_{i}r & < & 100r+2x_{i}r\\
3x_{i}r & > & 0
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $r>0$
