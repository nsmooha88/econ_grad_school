\begin_layout Proof
\begin_inset space \quad{}
\end_inset

(Method 1): For each 
\begin_inset Formula $x\in X$
\end_inset

, let 
\begin_inset Formula $u(x)\in\mathbb{R}_{+}$
\end_inset

 be such that 
\begin_inset Formula $x\sim(u(x),\ldots,u(x))$
\end_inset

.
 From the proof of Theorem 8, it was shown that 
\begin_inset Formula $u$
\end_inset

 is a well-defined function, i.e., for each 
\begin_inset Formula $x$
\end_inset

 there is always such a real number and it is unique.
 Also, one can prove that 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, and it can be proved that 
\begin_inset Formula $u$
\end_inset

 is a continuous function.
 Now, we show that 
\begin_inset Formula $u$
\end_inset

 is homogenous of degree one, i.e., 
\begin_inset Formula $\forall\ \alpha\in\mathbb{R}_{+}:u(\alpha x)=\alpha u(x)$
\end_inset

.
 Take 
\begin_inset Formula $x\in\mathbb{R}_{+}^{L}$
\end_inset

 and 
\begin_inset Formula $\alpha\in\mathbb{R}_{+}$
\end_inset

.
 By the definition of 
\begin_inset Formula $u$
\end_inset

, 
\begin_inset Formula $x\sim(u(x),\ldots,u(x))$
\end_inset

 and 
\begin_inset Formula $\alpha x\sim(u(\alpha x),\ldots u(\alpha x))$
\end_inset

.
 Since 
\begin_inset Formula $\succsim$
\end_inset

 is homothetic, then 
\begin_inset Formula $x\sim(u(x),\ldots,u(x))\implies\alpha x\sim(\alpha u(x),\ldots,\alpha u(x))$
\end_inset

.
 So, by transitivity of 
\begin_inset Formula $\succsim$
\end_inset

, 
\begin_inset Formula $(u(\alpha x),\ldots,u(\alpha x))\sim\alpha x\sim(\alpha u(x),\ldots,\alpha u(x))\implies(u(\alpha x),\ldots,u(\alpha x))\sim(\alpha u(x),\ldots,\alpha u(x))$
\end_inset

.
 Thus, 
\begin_inset Formula $u(\alpha x)=\alpha u(x)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

(Method 2): Since 
\begin_inset Formula $\succsim$
\end_inset

 is a continuous preference, then by Theorem 9, there is a continuous function
 
\begin_inset Formula $v:X\rightarrow\mathbb{R}$
\end_inset

 representing 
\begin_inset Formula $\succsim$
\end_inset

.
 Since 
\begin_inset Formula $\succsim$
\end_inset

 is monotone, then 
\begin_inset Formula $v$
\end_inset

 is monotone.
 First, let us define the function 
\begin_inset Formula $f$
\end_inset

:
\begin_inset Formula 
\[
\begin{array}[t]{cccl}
f: & \mathbb{R}_{} & \rightarrow & \mathbb{R}\\
 & t & \rightarrow & f(t)\equiv v(tz)
\end{array}
\]

\end_inset

Since 
\begin_inset Formula $v$
\end_inset

 is continuous and monotone, then 
\begin_inset Formula $f$
\end_inset

 is continuous and stricly increasing.
 Next, let us define the function 
\begin_inset Formula $u$
\end_inset

:
\begin_inset Formula 
\[
\begin{array}[t]{cccl}
u: & \mathbb{R}_{+}^{L} & \rightarrow & \mathbb{R}\\
 & x & \rightarrow & u(x)\equiv f^{-1}(v(x))
\end{array}
\]

\end_inset

Since 
\begin_inset Formula $f$
\end_inset

 is continuous and strictly increasing, then its inverse 
\begin_inset Formula $f^{-1}$
\end_inset

 exists, and 
\begin_inset Formula $f^{-1}$
\end_inset

 is continuous and strictly increasing.
 So, 
\begin_inset Formula $u$
\end_inset

 is well-defined, and by Proposition 2 in the notes, 
\begin_inset Formula $u\equiv f^{-1}\circ v$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

.
 We now have that 
\begin_inset Formula $f(u(x))=v(x)$
\end_inset

.
 Then, by the definition of 
\begin_inset Formula $f$
\end_inset

, 
\begin_inset Formula $v(u(x)z)=v(x)$
\end_inset

.
 Since 
\begin_inset Formula $v$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, then 
\begin_inset Formula $v(u(x)z)=v(x)\iff u(x)z\sim x\ $
\end_inset

.
 Take 
\begin_inset Formula $\alpha\in\mathbb{R}_{+}$
\end_inset

.
 By the previous argument, 
\begin_inset Formula $u(\alpha x)z\sim\alpha x$
\end_inset

.
 Since 
\begin_inset Formula $\succsim$
\end_inset

 is homothetic, then 
\begin_inset Formula $u(x)z\sim x\implies\alpha u(x)z\sim\alpha x$
\end_inset

.
 Hence, 
\begin_inset Formula $u(\alpha x)z\sim\alpha x\sim\alpha u(x)z$
\end_inset

, and by the transitivity of 
\begin_inset Formula $\succsim$
\end_inset

, this implies that 
\begin_inset Formula $u(\alpha x)z\sim\alpha u(x)z$
\end_inset

.
 Finally, since 
\begin_inset Formula $\succsim$
\end_inset

 is monotone, then 
\begin_inset Formula $u(\alpha x)=\alpha u(x)$
\end_inset

.
 Thus, 
\begin_inset Formula $u$
\end_inset

 is homogenous of degree one.
\end_layout

\begin_layout Proof

\series bold
