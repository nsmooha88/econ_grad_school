, 
\begin_inset Formula $y^{\prime}\succ x^{\prime}$
\end_inset

.
\end_layout

\begin_layout Case
\begin_inset Formula $\nexists\ z\in X$
\end_inset

 such that 
\begin_inset Formula $y\succ z\succ x$
\end_inset

.
 Let 
\begin_inset Formula $V(y)\equiv\{y^{\prime}\in X:y^{\prime}\succ x\}=U(\succ,x)$
\end_inset

 and 
\begin_inset Formula $V(x)\equiv\{x^{\prime}\in X:y\succ x^{\prime}\}=L(\succ,y)$
\end_inset

.
 Now, 
\begin_inset Formula $y\succ x$
\end_inset

 
\begin_inset Formula $\implies$
\end_inset

 
\begin_inset Formula $y\in V(y)$
\end_inset

 and 
\begin_inset Formula $x\in V(x)$
\end_inset

.
 Since 
\begin_inset Formula $\succsim$
\end_inset

 is continuous*, 
\begin_inset Formula $L(\succsim,x)$
\end_inset

 and 
\begin_inset Formula $U(\succsim,y)$
\end_inset

 are closed 
\begin_inset Formula $\iff$
\end_inset

 
\begin_inset Formula $V(y)$
\end_inset

 and 
\begin_inset Formula $V(x)$
\end_inset

 are open.
 Take 
\begin_inset Formula $y^{\prime}\in V(y)$
\end_inset

.
 Then, 
\begin_inset Formula $y^{\prime}\succ x$
\end_inset

.
 Take 
\begin_inset Formula $x^{\prime}\in V(x)$
\end_inset

.
 Then, 
\begin_inset Formula $y\succ x^{\prime}$
\end_inset

.
 Since 
\begin_inset Formula $\nexists\ z\in X$
\end_inset

 such that 
\begin_inset Formula $y\succ z\succ x$
\end_inset

 and 
\begin_inset Formula $\succsim$
\end_inset

 is complete, then 
\begin_inset Formula $y^{\prime}\succsim y\succ x\ \wedge\ y\succ x\succsim x^{\prime}\implies y^{\prime}\succ x^{\prime}$
\end_inset

.
 
\end_layout

\end_deeper
\begin_layout Proof
Now, 
\begin_inset Formula $x^{t}\underset{t\to\infty}{\longrightarrow}x\implies\left[\exists\ \bar{t}\in\mathbb{N},\forall\ t\geq\bar{t}:x^{t}\in V(x)\right]$
\end_inset

 and 
\begin_inset Formula $y^{t}\underset{t\to\infty}{\longrightarrow}y\implies\left[\exists\ \hat{t}\in\mathbb{N},\forall\ t\geq\hat{t}:y^{t}\in V(y)\right]$
\end_inset

.
 Let 
\begin_inset Formula $t^{*}=\max\{\hat{t},\bar{t}\}$
\end_inset

.
 When 
\begin_inset Formula $t\geq t^{*}$
\end_inset

, 
\begin_inset Formula $x^{t}\in V(x)$
\end_inset

 and 
\begin_inset Formula $y^{t}\in V(y)$
\end_inset

.
 So, 
\begin_inset Formula $\left[\forall\ x^{\prime}\in V(x),\forall\ y^{\prime}\in V(y):y^{\prime}\succ x^{\prime}\right]\implies y^{t}\succ x^{t}$
\end_inset

.
 However, this contradicts 
\begin_inset Formula $\forall\ t\in\mathbb{N}:x^{t}\succsim y^{t}$
\end_inset

 
\begin_inset Formula $(\rightarrow\leftarrow)$
\end_inset

.
 Therefore, 
\begin_inset Formula $\succsim$
\end_inset

 is continuous.
\end_layout

\begin_layout Remark*
If a binary relation 
\begin_inset Formula $\succsim$
\end_inset

 is continuous, then it is continuous*.
 However, in general, a binary relation 
\begin_inset Formula $\succsim$
\end_inset

 that is continuous* may not be continuous.
 From Theorem 7, if a binary relation 
\begin_inset Formula $\succsim$
\end_inset

 is complete and transitive, then 
\begin_inset Formula $\succsim$
\end_inset

 is continuous if and only if 
\begin_inset Formula $\succsim$
\end_inset

 is continuous*.
\end_layout

\begin_layout Corollary*

\series bold
\emph on
(1).
 
\series default
\emph default
A preference relation 
\begin_inset Formula $\succsim$
\end_inset

 on 
\begin_inset Formula $X$
\end_inset

 is continuous if and only if for each 
\begin_inset Formula $x\in X$
\end_inset

, 
\begin_inset Formula $U(\succ,x)$
\end_inset

 and 
\begin_inset Formula $L(\succ,x)$
\end_inset

 are open in 
\begin_inset Formula $X$
\end_inset

.
\end_layout

\begin_layout Proof
From Theorem 1, a preference relation 
\begin_inset Formula $\succsim$
\end_inset

 is continuous if and only if 
\begin_inset Formula $\succsim$
\end_inset

 is continuous*.
 So, for each 
\begin_inset Formula $x\in X$
\end_inset

, 
\begin_inset Formula $U(\succsim,x)$
\end_inset

 and 
\begin_inset Formula $L(\succsim,x)$
\end_inset

 are closed.
 Note, a set 
\begin_inset Formula $A\subseteq X$
\end_inset

 is closed in 
\begin_inset Formula $X$
\end_inset

 if and only if its complement in 
\begin_inset Formula $X$
\end_inset

 is open.
 Also, 
\begin_inset Formula $U(\succsim,x)=L(\succ,x)^{c}$
\end_inset

 and 
\begin_inset Formula $L(\succsim,x)=U(\succ,x)^{c}$
\end_inset

.
 Therefore, for each 
\begin_inset Formula $x\in X$
\end_inset

, 
\begin_inset Formula $U(\succ,x)$
\end_inset

 and 
\begin_inset Formula $L(\succ,x)$
\end_inset

 are open.
\end_layout

\begin_layout Proposition*

\series bold
\emph on
(7).
 
\series default
\emph default
If 
\begin_inset Formula $\succsim$
\end_inset

 is represented by a continuous utility function, then 
\begin_inset Formula $\succsim$
\end_inset

 is continuous.
\end_layout

\begin_layout Proof
Assume 
\begin_inset Formula $\succsim$
\end_inset

 is represented by a continuous utility funciton.
 We want to show that 
\begin_inset Formula $\succsim$
\end_inset

 is continuous, i.e., for any two convergent sequences 
\begin_inset Formula $x^{t}\underset{t\to\infty}{\longrightarrow}x$
\end_inset

 and 
\begin_inset Formula $y^{t}\underset{t\to\infty}{\longrightarrow}y$
\end_inset

 such that for each 
\begin_inset Formula $t\in\mathbb{N},x^{t}\succsim y^{t}$
\end_inset

, we have that 
\begin_inset Formula $x\succsim y.$
\end_inset

 
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Take two convergent sequences 
\begin_inset Formula $x^{t}\underset{t\to\infty}{\longrightarrow}x$
\end_inset

 and 
\begin_inset Formula $y^{t}\underset{t\to\infty}{\longrightarrow}y$
\end_inset

 in 
\begin_inset Formula $X$
\end_inset

 such that 
\begin_inset Formula $\forall\ t\in\mathbb{N},\ x^{t}\succsim y^{t}$
\end_inset

.
 Since 
\begin_inset Formula $\succsim$
\end_inset

 is represented by 
\begin_inset Formula $u:X\rightarrow\mathbb{R}$
\end_inset

, then 
\begin_inset Formula $\forall\ t\in\mathbb{N}:u(x^{t})\ge u(y^{t})$
\end_inset

.
 Since limits preserve weak inequalities, then 
\begin_inset Formula $\underset{t\to\infty}{\lim}\ u(x^{t})\geq\underset{t\to\infty}{\lim}\ u(y^{t})$
\end_inset

.
 Since 
\begin_inset Formula $u$
\end_inset

 is a continuous function, then 
\begin_inset Formula $u(x^{t})\underset{t\to\infty}{\longrightarrow}u(x)$
\end_inset

 and 
\begin_inset Formula $u(y^{t})\underset{t\to\infty}{\longrightarrow}u(y)$
\end_inset

.
 Hence, we have that 
\begin_inset Formula $u(x)\geq u(y)$
\end_inset

.
 Since 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, then 
\begin_inset Formula $u(x)\geq u(y)\iff x\succsim y$
\end_inset

 .
 Thus, 
\begin_inset Formula $\forall\; x^{t}\underset{t\to\infty}{\longrightarrow}x,\ \forall\ y^{t}\underset{t\to\infty}{\longrightarrow}y:(\forall t\in\mathbb{N}:x^{t}\succsim y^{t})\implies x\succsim y$
\end_inset

.
 Therefore, 
\begin_inset Formula $\succsim$
\end_inset

 is continuous.
\end_layout

