\begin_layout Problem
Prove that continuity and continuity* are not necessarily equivlatent for
 binary relations that are complete but not, transitive, that is construct
 a complete and continuous* binary relation that is not continuous.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $X\equiv\left[0,1\right]$
\end_inset

.
 We will now define a binary relation on 
\begin_inset Formula $X$
\end_inset

 that is complete, intransitive, continuous*, but not continuous.
 
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Let 
\begin_inset Formula $\succsim\equiv\left\{ (x,y)\in X^{2}:x_{1}\geq x_{2}\right\} \cup\left\{ (x,y)\in X^{2}:y=1-x,\ x>\frac{1}{4}\right\} $
\end_inset

.
 So, 
\begin_inset Formula $\forall\ \left\{ x,y\right\} \subseteq X$
\end_inset

, 
\begin_inset Formula $x\succsim y\iff[x\geq y]\ \vee\ \left[(y=1-x)\ \wedge\ \left(x>\frac{1}{4}\right)\right]$
\end_inset

.
 The upper and lower contour sets are defined as follows:
\begin_inset Formula 
\[
\forall\ x\in[0,1],\ L\left(\succsim,x\right)\equiv\left\{ \begin{array}{cc}
[0,x] & \mbox{if}\ x\leq\frac{1}{4}\\
{}[0,x]\cup\{1-x\} & \mbox{if}\ x>\frac{1}{4}
\end{array}\right\} 
\]

\end_inset


\begin_inset Formula 
\[
\forall\ y\in[0,1],\ U(\succsim,y)\equiv\left\{ \begin{array}{cc}
[y,1] & \mbox{if}\ y\geq\frac{3}{4}\\
{}[y,1]\cup\{1-y\} & \mbox{if}\ y<\frac{3}{4}
\end{array}\right\} 
\]

\end_inset

Important to note, 
\begin_inset Formula $a\in U(\succsim,b)\iff a\succsim b\iff(a,b)\in X$
\end_inset

, where 
\begin_inset Formula $b$
\end_inset

 is fixed.
 So, upper contour sets are represented by horizontoal lines in 
\begin_inset Formula $X^{2}$
\end_inset

.
 Also, 
\begin_inset Formula $a\in L(\succsim,b)\iff b\succsim a\iff(b,a)\in X$
\end_inset

, where 
\begin_inset Formula $b$
\end_inset

 is fixed.
 So, lower contour sets are represented by vertical lines in 
\begin_inset Formula $X^{2}$
\end_inset

.
 Now, 
\begin_inset Formula $\forall\ x\in[0,1],\ U(\succsim,x)$
\end_inset

 and 
\begin_inset Formula $L(\succsim,x)$
\end_inset

 are closed sets.
 Thus, 
\begin_inset Formula $\succsim$
\end_inset

 is continuous*.
 Now, 
\begin_inset Formula $\forall\ t\in\mathbb{N}$
\end_inset

, let 
\begin_inset Formula $\left(x^{t},y^{t}\right)=\left(\frac{1}{4},\frac{3}{4}\right)+\left(\frac{1}{2t},-\frac{1}{2t}\right)=\left(\frac{1}{4}+\frac{1}{2t},\frac{3}{4}-\frac{1}{2t}\right)$
\end_inset

.
 Since 
\begin_inset Formula $x^{t}>\frac{1}{4}$
\end_inset

 and 
\begin_inset Formula $y^{t}=1-x^{t}$
\end_inset

, then 
\begin_inset Formula $\forall\ t\in\mathbb{N},\ x^{t}\succsim y^{t}$
\end_inset

.
 However, 
\begin_inset Formula $\left(x^{t},y^{t}\right)\rightarrow\left(\frac{1}{4},\frac{3}{4}\right)=(x,y)$
\end_inset

 as 
\begin_inset Formula $t\rightarrow\infty$
\end_inset

, and 
\begin_inset Formula $\left(\frac{1}{4},\frac{3}{4}\right)\notin\ \succsim$
\end_inset

.
 Therefore, 
\begin_inset Formula $\succsim$
\end_inset

 is not continuous.
\end_layout

