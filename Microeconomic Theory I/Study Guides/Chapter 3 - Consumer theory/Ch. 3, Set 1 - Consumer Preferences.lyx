\begin_layout Problem
Let 
\begin_inset Formula $\succsim$
\end_inset

 be a monotone and continuous preference relation on 
\begin_inset Formula $\mathbb{R}_{+}^{L}$
\end_inset

.
 Let 
\begin_inset Formula $p\in\mathbb{R}_{++}^{L}$
\end_inset

, 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

, and 
\begin_inset Formula $\{x,y\}\subseteq\mathbb{R}_{+}^{L}$
\end_inset

 be such that 
\begin_inset Formula $p\cdot x<p\cdot y$
\end_inset

 and 
\begin_inset Formula $x\succsim y$
\end_inset

.
 Prove that there is 
\begin_inset Formula $x^{\prime}\in\mathbb{R}_{+}^{L}$
\end_inset

 such that 
\begin_inset Formula $p\cdot x^{\prime}<p\cdot y$
\end_inset

 and 
\begin_inset Formula $x^{\prime}\succ y$
\end_inset

.
 
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $\succsim$
\end_inset

 be a monotone and continuous preference relation on 
\begin_inset Formula $\mathbb{R}_{+}^{L}$
\end_inset

.
 Let 
\begin_inset Formula $p\in\mathbb{R}_{++}^{L}$
\end_inset

, 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

, and 
\begin_inset Formula $\{x,y\}\subseteq\mathbb{R}_{+}^{L}$
\end_inset

 be such that 
\begin_inset Formula $p\cdot x<p\cdot y$
\end_inset

 and 
\begin_inset Formula $x\succsim y$
\end_inset

.
 We want to show that 
\begin_inset Formula $\exists\ x^{\prime}\in\mathbb{R}_{+}^{L}:p\cdot x^{\prime}<p\cdot y\ \wedge\ x^{\prime}\succ y$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Since 
\begin_inset Formula $p\cdot x<p\cdot y$
\end_inset

 and 
\begin_inset Formula $p\gg0$
\end_inset

, then 
\begin_inset Formula $0<p\cdot y$
\end_inset

.
 Important to note, 
\begin_inset Formula $\{(p\cdot x),(p\cdot y)\}\subseteq\mathbb{R}_{+}$
\end_inset

.
 Let 
\begin_inset Formula $\tau\in\mathbb{R}_{++}^{L}$
\end_inset

 such that 
\begin_inset Formula $\forall\ l=1,\ldots L:\tau_{l}=1$
\end_inset

.
 Take 
\begin_inset Formula $\alpha\in(0,1)$
\end_inset

 such that 
\begin_inset Formula $\alpha\approx0$
\end_inset

.
 Now, since the set of real numbers is complete, then 
\begin_inset Formula $p\cdot x<p\cdot y\implies p\cdot x<p\cdot(x+\alpha\tau)<p\cdot y$
\end_inset

.
 Define 
\begin_inset Formula $x^{\prime}\equiv x+\alpha\tau$
\end_inset

.
 By monotonicty of 
\begin_inset Formula $\succsim$
\end_inset

, 
\begin_inset Formula $x^{\prime}\gg x\implies x^{\prime}\succ x$
\end_inset

.
 By transitivity of 
\begin_inset Formula $\succsim$
\end_inset

, 
\begin_inset Formula $x^{\prime}\succ x\succsim y\implies x^{\prime}\succ y$
\end_inset

.
 Thus, there is 
\begin_inset Formula $x^{\prime}\in\mathbb{R}_{+}^{L}$
\end_inset

 such that 
\begin_inset Formula $p\cdot x^{\prime}<p\cdot y$
\end_inset

 and 
\begin_inset Formula $x^{\prime}\succ y$
\end_inset

.
\end_layout

