\begin_layout Problem
Consider the following function:
\begin_inset Formula 
\[
\begin{array}{cccl}
u_{i}: & \mathbb{R}_{+}^{2} & \rightarrow & \mathbb{R}\\
 & x\equiv(x_{1},x_{2}) & \mapsto & u_{i}(x)\equiv-S(\succsim_{i},x)
\end{array}
\]

\end_inset

Prove that if 
\begin_inset Formula $\succsim_{i}$
\end_inset

 is rational, monotone, and continuous, then 
\begin_inset Formula $u_{i}$
\end_inset

 represents 
\begin_inset Formula $\succsim_{i}$
\end_inset

 in 
\begin_inset Formula $\mbox{rec}\{0,\Omega\}$
\end_inset

.
 That is, for each pair 
\begin_inset Formula $\{x,y\}\subseteq\mbox{rec}\{0,\Omega\}$
\end_inset

, 
\begin_inset Formula $x\succsim_{i}y$
\end_inset

 if and only if 
\begin_inset Formula $u_{i}(x)\ge u_{i}(y)$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $i\in N$
\end_inset

 and 
\begin_inset Formula $\succsim_{i}$
\end_inset

 be a preference relation on 
\begin_inset Formula $X\equiv\mathbb{R}_{+}^{2}$
\end_inset

.
 Assume 
\begin_inset Formula $\succsim_{i}$
\end_inset

 is monotone and continuous.
 We want to show that for each pair 
\begin_inset Formula $\{x,y\}\subseteq\mbox{rec}\{0,\Omega\}$
\end_inset

, 
\begin_inset Formula $x\succsim_{i}y$
\end_inset

 if and only if 
\begin_inset Formula $u_{i}(x)\ge u_{i}(y)$
\end_inset

.
 Take 
\begin_inset Formula $\{x,y\}\subseteq\mbox{rec}\{0,\Omega\}$
\end_inset

.
 Note, 
\begin_inset Formula $S(\succsim_{i},z)=\mbox{size}\left(U(\succsim_{i},z)\right)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Rightarrow)$
\end_inset

 Assume 
\begin_inset Formula $x\succsim_{i}y$
\end_inset

.
 Then, 
\begin_inset Formula $U(\succsim_{i},x)\subseteq U(\succsim_{i},y)$
\end_inset

.
 So, 
\begin_inset Formula $S(\succsim_{i},x)\leq S(\succsim_{i},y)$
\end_inset

.
 Equivalently, 
\begin_inset Formula $-S(\succsim_{i},x)\geq-S(\succsim_{i},y)$
\end_inset

.
 Therefore, 
\begin_inset Formula $u_{i}(x)\geq u_{i}(y)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Leftarrow)$
\end_inset

 Assume 
\begin_inset Formula $u_{i}(x)\ge u_{i}(y)$
\end_inset

.
 Suppose for contradiction 
\begin_inset Formula $y\succ_{i}x$
\end_inset

.
 Then, 
\begin_inset Formula $y\in U(\succ_{i},x)$
\end_inset

, 
\begin_inset Formula $x\in L(\succ_{i},y)$
\end_inset

, and 
\begin_inset Formula $U(\succsim_{i},y)\subseteq U(\succsim_{i},x)$
\end_inset

.
 In addition, since 
\begin_inset Formula $\succsim_{i}$
\end_inset

 is monotone and continuous, then 
\begin_inset Formula $y\succ_{i}x\implies y\neq0$
\end_inset

.
 Let 
\begin_inset Formula $A\equiv L(\succ_{i},y)\cap U(\succ_{i},x)$
\end_inset

.
 By Corollary 1, since 
\begin_inset Formula $\succsim_{i}$
\end_inset

 is continuous, 
\begin_inset Formula $U(\succ_{i},x)$
\end_inset

 and 
\begin_inset Formula $L(\succ_{i},y)$
\end_inset

 are open sets in 
\begin_inset Formula $X$
\end_inset

.
 
\begin_inset Formula $A$
\end_inset

 is open as well since the finite intersection of open sets is open.
 By the definition of open sets, 
\begin_inset Formula $\exists\ \varepsilon>0:B_{\varepsilon}(x)\subseteq L(\succ_{i},y)$
\end_inset

.
 Let 
\begin_inset Formula $\tau\in\mathbb{R}_{++}^{L}$
\end_inset

 such that 
\begin_inset Formula $\forall\ l=1,\ldots,L,\ \tau_{l}=1$
\end_inset

.
 Define 
\begin_inset Formula $\hat{x}\equiv x+\frac{\varepsilon}{2}\tau$
\end_inset

.
 Note, 
\begin_inset Formula $\hat{x}\in B_{\epsilon}(x)\subseteq L(\succ_{i},y)\implies\hat{x}\in L(\succ_{i},y)$
\end_inset

.
 By monotonicity of 
\begin_inset Formula $\succsim_{i}$
\end_inset

, 
\begin_inset Formula $\hat{x}\gg x\implies\hat{x}\succ_{i}x$
\end_inset

, so 
\begin_inset Formula $\hat{x}\in U(\succ_{i},x)$
\end_inset

.
 Since 
\begin_inset Formula $\hat{x}\in L(\succ_{i},y)$
\end_inset

 and 
\begin_inset Formula $\hat{x}\in U(\succ_{i},x)$
\end_inset

, then 
\begin_inset Formula $\hat{x}\in A$
\end_inset

.
 Since 
\begin_inset Formula $A$
\end_inset

 is open, then 
\begin_inset Formula $\exists\ \alpha>0:B_{\alpha}(\hat{x})\subseteq A$
\end_inset

.
 Since 
\begin_inset Formula $A\subseteq U(\succ_{i},x)\subseteq U(\succsim_{i},x)$
\end_inset

, then 
\begin_inset Formula $B_{\alpha}(\hat{x})\subseteq U(\succsim_{i},x).$
\end_inset

 Moreover, since 
\begin_inset Formula $A\subseteq L(\succ_{i},y)\subseteq L(\succsim_{i},y)$
\end_inset

, then 
\begin_inset Formula $B_{\alpha}(\hat{x})\cap U(\succsim_{i},y)=\emptyset$
\end_inset

.
 Now, we have that 
\begin_inset Formula $U(\succsim_{i},y)\subseteq U(\succsim_{i},x)$
\end_inset

, 
\begin_inset Formula $\mbox{size}\left(B_{\alpha}(\hat{x})\right)>0$
\end_inset

, 
\begin_inset Formula $B_{\alpha}(\hat{x})\subseteq U(\succsim_{i},x)$
\end_inset

, and 
\begin_inset Formula $B_{\alpha}(\hat{x})\cap U(\succsim_{i},y)=\emptyset$
\end_inset

.
 Thus, by the condition above, 
\begin_inset Formula $S(\succsim_{i},x)>S(\succsim_{i},y)$
\end_inset

, which is equivalent to 
\begin_inset Formula $-S(\succsim_{i},x)<-S(\succsim_{i},y)$
\end_inset

.
 Hence, 
\begin_inset Formula $u_{i}(y)>u_{i}(x)$
\end_inset

, but this contradicts 
\begin_inset Formula $u_{i}(x)\ge u_{i}(y)$
\end_inset

 
\begin_inset Formula $(\rightarrow\leftarrow)$
\end_inset

.
 Therefore, 
\begin_inset Formula $x\succsim_{i}y$
\end_inset

.
\end_layout

