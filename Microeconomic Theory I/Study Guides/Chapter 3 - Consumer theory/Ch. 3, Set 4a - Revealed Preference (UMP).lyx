\frac{\alpha}{p_{1}}\frac{(1-\alpha)}{p_{2}}w & -\frac{(1-\alpha)w}{p_{2}^{2}}+\frac{(1-\alpha)^{2}w}{p_{2}^{2}}
\end{array}\right]
\]

\end_inset


