\end_inset

 is such 
\begin_inset Formula $x^{\succsim^{u}}=x^{lex}$
\end_inset

 is given by
\begin_inset Formula 
\[
u(x_{1},x_{2})=x_{1}
\]

\end_inset


\end_layout

\begin_layout Problem
Consider the problem of maximizing the funciton 
\begin_inset Formula $x\equiv(x_{1},x_{2})\in\mathbb{R}^{2}\mapsto u(x)\equiv-(x_{1}-\nicefrac{9}{4})^{2}-(x_{2}-2)^{2}$
\end_inset

 subject to: (1) 
\begin_inset Formula $x_{2}-x_{1}^{2}\geq0$
\end_inset

; (2) 
\begin_inset Formula $x_{1}+x_{2}\leq6$
\end_inset

; (3) 
\begin_inset Formula $x\in\mathbb{R}_{+}^{2}$
\end_inset

, i.e., 
\begin_inset Formula $x_{1}\geq0$
\end_inset

 and 
\begin_inset Formula $x_{2}\geq0$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Enumerate
Write the Kunh-Tucker F.O.C.
 for this problem.
\end_layout

\begin_layout Enumerate
Verify that at 
\begin_inset Formula $x^{*}\equiv(\nicefrac{3}{2},\nicefrac{9}{4})$
\end_inset

 the K-T F.O.C.
 are satisfied.
\end_layout

\begin_layout Enumerate
Prove that 
\begin_inset Formula $x^{*}$
\end_inset

 is the unique constrained maximizer.
\end_layout

\end_deeper
\begin_layout Proof
The Lagrangian of this problem is given by
\begin_inset Formula 
\[
L=-\left(x_{1}-\frac{9}{4}\right)^{2}-\left(x_{2}-2\right)^{2}+\lambda_{1}\left(x_{2}-x_{1}^{2}\right)+\lambda_{2}\left(6-x_{1}-x_{2}\right)+\lambda_{3}x_{1}+\lambda_{4}x_{2}
\]

\end_inset


\bar under
Part A.
\end_layout

\begin_layout Proof
The Kunh-Tucker conditions for this problem are given by
\begin_inset Formula 
\begin{gather*}
\frac{\partial L}{\partial x_{1}}=0\iff-2\left(x_{1}-\frac{9}{4}\right)-2x_{1}\lambda_{1}-\lambda_{2}+\lambda_{3}=0\\
\frac{\partial L}{\partial x_{2}}=0\iff-2\left(x_{2}-2\right)+\lambda_{1}-\lambda_{2}+\lambda_{4}=0\\
x_{2}-x_{1}^{2}\geq0\\
6-x_{1}-x_{2}\geq0\\
x_{3}\geq0\\
x_{4}\geq0
\end{gather*}

\end_inset

along with the Complementary Slackness conditions
\begin_inset Formula 
\begin{gather*}
\lambda_{1}\left(x_{2}-x_{1}^{2}\right)=0\\
\lambda_{2}\left(6-x_{1}-x_{2}\right)=0\\
\lambda_{3}x_{1}=0\\
\lambda_{4}x_{2}=0
\end{gather*}

\end_inset


\bar under
Part B.
\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset

We verify that at 
\begin_inset Formula $x^{*}\equiv(\nicefrac{3}{2},\nicefrac{9}{4})$
\end_inset

 the K-T F.O.C.
 are satisfied.
 Since 
\begin_inset Formula $x_{1}>0$
\end_inset

 and 
\begin_inset Formula $x_{2}>0$
\end_inset

, then 
\begin_inset Formula $\lambda_{3}=0$
\end_inset

 and 
\begin_inset Formula $\lambda_{4}=0$
\end_inset

.
 
\begin_inset Formula $6-(\nicefrac{3}{2})-(\nicefrac{9}{4})>0\implies\lambda_{2}=0$
\end_inset

.
 Thus, the first-order conditions become
\begin_inset Formula 
\begin{gather*}
-2\left(x_{1}-\frac{9}{4}\right)-2\lambda_{1}x_{1}=0\implies\lambda_{1}=\frac{9}{4x_{1}}-1\\
-2\left(x_{2}-2\right)+\lambda_{1}=0\implies\lambda_{1}=2\left(x_{2}-2\right)
\end{gather*}

\end_inset

Equating the two equations for 
\begin_inset Formula $\lambda_{1}$
\end_inset

 and plugging in 
\begin_inset Formula $x^{*}$
\end_inset

 yields
\begin_inset Formula 
\[
\lambda_{1}=\frac{9}{4x_{1}}-1=2\left(x_{2}-2\right)\implies\lambda_{1}>\frac{1}{2}
\]

\end_inset

This implies that 
\begin_inset Formula $(\nicefrac{9}{4})-(\nicefrac{3}{2})^{2}=0$
\end_inset

, which is true.
 Therefore, at the given 
\begin_inset Formula $x^{*}$
\end_inset

, the K-T F.O.C.
 are satisfied.
\end_layout

\begin_layout Standard

\bar under
Part C.
\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset

To prove that 
\begin_inset Formula $x^{*}$
\end_inset

 is the unique constrained maximizer, we will show that 
\begin_inset Formula $u(x)$
\end_inset

 is a strictly concave function.
\begin_inset Formula 
\begin{gather*}
\frac{\partial u(x)}{\partial x_{1}}=-2\left(x_{1}-\frac{9}{4}\right)\\
\frac{\partial u(x)}{\partial x_{2}}=-2\left(x_{2}-2\right)\\
\frac{\partial^{2}u(x)}{\partial x_{1}^{2}}=-2\\
\frac{\partial^{2}u(x)}{\partial x_{2}^{2}}=-2\\
\frac{\partial u(x)}{\partial x_{1}\partial x_{2}}=\frac{\partial u(x)}{\partial x_{2}\partial x_{2}}=0
\end{gather*}

\end_inset

Since 
\begin_inset Formula $\nicefrac{\partial^{2}u(x)}{\partial x_{1}^{2}}=-2<0$
\end_inset

 and
\begin_inset Formula 
\[
\frac{\partial^{2}u(x)}{\partial x_{1}^{2}}\frac{\partial^{2}u(x)}{\partial x_{2}^{2}}-\left(\frac{\partial u(x)}{\partial x_{1}\partial x_{2}}\right)^{2}=4-0>0
\]

\end_inset

then the Hessian matrix of 
\begin_inset Formula $u(x)$
\end_inset

 is negative definite.
 This implies that 
\begin_inset Formula $u(x)$
\end_inset

 is a strictly concave function.
 Thus, the K-T F.O.C.
 are sufficient to establish that 
\begin_inset Formula $x^{*}$
\end_inset

 is a solution, and by Proposition 18, 
\begin_inset Formula $x^{*}$
\end_inset

 is unique.
\end_layout

\begin_layout Problem
Let 
\begin_inset Formula $\succsim$
\end_inset

 be a monotone and continuous preference on 
\begin_inset Formula $\mathbb{R}\times\mathbb{R}_{+}^{L-1}$
\end_inset

 that is quasi-linear with respect to commodity 
\begin_inset Formula $k$
\end_inset

 and whose associated demand correspondence is single-valued.
 Let 
\begin_inset Formula $x$
\end_inset

 be the associated demand function.
\end_layout

\begin_layout Problem
Let 
\begin_inset Formula $l\neq k$
\end_inset

.
 The 
\series bold
Marshallian demand for good l
\series default
 is the funciton denoted 
\begin_inset Formula $x_{l}^{M}$
\end_inset

, defined by:
\begin_inset Formula 
\[
\begin{array}{cccl}
x_{l}^{M}: & \mathbb{R}_{++}^{L} & \rightarrow & \mathbb{R}_{+}\\
 & p & \mapsto & x_{l}^{M}(p)\equiv x_{l}(p,w)\ \mbox{for some}\ w\in\in\mathbb{R}_{++}
\end{array}
\]

\end_inset

Prove that the Marshallian demand for good 
\begin_inset Formula $l$
\end_inset

 is well-defined, i.e., 
\begin_inset Formula $\forall\ p\gg0,\ \forall\ \{w,w^{\prime}\}\subseteq\mathbb{R}_{++}:x_{l}(p,w)=x_{l}(p,w^{\prime})$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $\succsim$
\end_inset

 be a monotone and continuous preference on 
\begin_inset Formula $\mathbb{R}\times\mathbb{R}_{+}^{L-1}$
\end_inset

 that is quasi-linear with respect to commodity 
\begin_inset Formula $k$
\end_inset

 and whose associated demand correspondence is single-valued.
 Let 
\begin_inset Formula $x$
\end_inset

 be the associated demand function.
 We prove that 
\begin_inset Formula $\forall\ p\gg0,\ \forall\ \{w,w^{\prime}\}\subseteq\mathbb{R}_{++}:\ x_{l}(p,w)=x_{l}(p,w^{\prime})$
\end_inset

.
 
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Take 
\begin_inset Formula $p\gg0$
\end_inset

 and take 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $\{w,w^{\prime}\}\subseteq\mathbb{R}_{++}$
\end_inset

 such that 
\begin_inset Formula $w\neq w^{\prime}$
\end_inset

.
 Without loss of generality, let 
\begin_inset Formula $w<w^{\prime}$
\end_inset

.
 Define 
\begin_inset Formula $c\equiv\frac{w^{\prime}-w}{p_{k}}$
\end_inset

, and define 
\begin_inset Formula $z\in\mathbb{R}_{+}^{L}$
\end_inset

 at follows: 
\begin_inset Formula $z\equiv(\forall\ l\neq k:z_{l}=0;\ z_{k}=c)$
\end_inset

.
 We want to show that 
\begin_inset Formula $x_{l}(p,w)=x_{l}(p,w^{\prime})$
\end_inset

.
 Now, consider 
\begin_inset Formula $x(p,w)+z$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Itemize

\bar under
Claim
\bar default
:
\series bold
 
\series default

\begin_inset Formula $x(p,w)+z=x(p,w^{\prime})$
\end_inset


\end_layout

\begin_deeper
\begin_layout Standard
We prove the claim in two steps.
\end_layout

\begin_layout Standard
1.
 Show 
\series bold

\begin_inset Formula $x(p,w)+z\in B(p,w^{\prime})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset

Since 
\begin_inset Formula $\succsim$
\end_inset

 is monotone and continuous, then Walras' law is satisfied by Proposition
 18.
 So, we have
\begin_inset Formula 
\begin{eqnarray*}
p\cdot(x(p,w)+z) & = & p\cdot x(p,w)+p\cdot z\\
 & = & w+p_{k}c\\
 & = & w+p_{k}\left(\frac{w^{\prime}-w}{p_{k}}\right)\\
 & = & w^{\prime}
\end{eqnarray*}

\end_inset

Thus, 
\series bold

\begin_inset Formula $x(p,w)+z\in B(p,w^{\prime})$
\end_inset


\end_layout

\begin_layout Standard
2.
 Show 
\begin_inset Formula $x(p,w)+z$
\end_inset

 is a utility maximizer on 
\begin_inset Formula $B(p,w^{\prime})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset space \quad{}
\end_inset

By Proposition 9, a continuous preference relation 
\begin_inset Formula $\succsim$
\end_inset

 on 
\begin_inset Formula $\mathbb{R}\times\mathbb{R}_{+}^{L-1}$
\end_inset

 is quasi-linear with respect to commodity 
\begin_inset Formula $k$
\end_inset

 if and only if it admits a continuous utility representation of the form:
\begin_inset Formula 
\[
\forall\ x\in\mathbb{R}\times\mathbb{R}_{+}^{L-1}:u(x)\equiv x_{k}+\varphi(x_{-k})
\]

\end_inset

Suppose for contradiction that 
\begin_inset Formula $x(p,w)+z$
\end_inset

 does not maximize utility on 
\begin_inset Formula $B(p,w^{\prime})$
\end_inset

, i.e., 
\begin_inset Formula $x(p,w)+z\notin C^{\succsim}(p,w^{\prime})$
\end_inset

.
 Then, 
\begin_inset Formula $\exists\ v\in B(p,w^{\prime}):v\succ x(p,w)+z$
\end_inset

.
 Since 
\begin_inset Formula $u$
\end_inset

 represents the function, then 
\begin_inset Formula $v\succ x(p,w)+z\iff u(v)>u(x(p,w)+z)$
\end_inset

.
 By the definition of 
\begin_inset Formula $u$
\end_inset

,
\begin_inset Formula 
\begin{eqnarray*}
v_{k}+\varphi(v_{-k}) & > & \left(x_{k}+c\right)+\varphi(x_{-k})\\
\left(v_{k}-c\right)+\varphi(v_{-k}) & > & x_{k}+\varphi(x_{-k})\\
u(v-z) & > & u(x(p,w))
\end{eqnarray*}

\end_inset

Now,
\begin_inset Formula 
\begin{eqnarray*}
p\cdot(v-z) & = & p\cdot v-p\cdot z\\
 & = & p\cdot v-p_{k}c\\
 & = & p\cdot v-p_{k}\left(\frac{w^{\prime}-w}{p_{k}}\right)\\
 & = & p\cdot v-w^{\prime}+w\\
 & \leq & w^{\prime}-w^{\prime}+w\\
 & = & w
\end{eqnarray*}

\end_inset

So, we have shown that 
\begin_inset Formula $v-z\in B(p,w)$
\end_inset

 and 
\begin_inset Formula $u(v-z)>u(x(p,w))$
\end_inset

.
 However, this contradicts the fact that 
\begin_inset Formula $x(p,w)$
\end_inset

 is the unique utility maximizer on 
\begin_inset Formula $B(p,w)$
\end_inset

 
\begin_inset Formula $(\rightarrow\leftarrow)$
\end_inset

.
 Thus, 
\begin_inset Formula $x(p,w)+z$
\end_inset

 is the utility maximizer on 
\begin_inset Formula $B(p,w^{\prime})$
\end_inset

.
\end_layout

\end_deeper
\end_deeper
\begin_layout Proof
\begin_inset space \quad{}
\end_inset

We conclude that 
\begin_inset Formula $x(p,w)+z$
\end_inset

 maximizes utility for 
\begin_inset Formula $B(p,w^{\prime})$
\end_inset

, and since demand is single-valued, then 
\begin_inset Formula $x(p,w)+z=x(p,w^{\prime})$
\end_inset

.
 Hence, 
\begin_inset Formula $x(p,w)+z\equiv(\forall\ l\neq k:x_{l}(p,w);\ x_{k}(p,w)+c\ \mbox{for}\ k)=x(p,w^{\prime})$
\end_inset

.
 Thus, 
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $x_{l}(p,w)=x_{l}(p,w^{\prime})$
\end_inset

.
 Therefore, 
\begin_inset Formula $\forall\ p\gg0,\ \forall\ \{w,w^{\prime}\}\subseteq\mathbb{R}_{++}:\ x_{l}(p,w)=x_{l}(p,w^{\prime})$
\end_inset

.
\end_layout

