\uwave default
\noun default
\color inherit
or, written in matrix notation,
\begin_inset Formula 
\[
p\cdot D_{w}x(p,w)=1
\]

\end_inset


\end_layout

\begin_layout Proof
Assume 
\begin_inset Formula $x(p,w)$
\end_inset

 satisfies Walras' law.
 Differentiating equation (2) above with respect to 
\begin_inset Formula $w$
\end_inset

 yields:
\begin_inset Formula 
\[
\frac{\partial(p\cdot x(p,w))}{\partial w}=p_{1}\frac{\partial x_{1}(p,w)}{\partial w}+p_{2}\frac{\partial x_{2}(p,w)}{\partial w}+\dots+p_{L}\frac{\partial x_{L}(p,w)}{\partial w}=1
\]

\end_inset

This is equivalent to
\begin_inset Formula 
\[
{\displaystyle \sum_{l=1}^{L}}p_{l}\frac{\partial x_{l}(p,w)}{\partial w}=1
\]

\end_inset

or, written in matrix notation,
\begin_inset Formula 
\[
p\cdot D_{w}x(p,w)=1
\]

\end_inset


\end_layout

\begin_layout Exercise*

\series bold
2.E.2.
 
\series default
Show that the results of Propositions 2.E.2 and 2.E.3 lead to the following
 two elasticity formulas:
\begin_inset Formula 
\[
{\displaystyle \sum_{l=1}^{L}}b_{l}(p,w)\epsilon_{lk}(p,w)+b_{k}(p,w)=0
\]

\end_inset

and
\begin_inset Formula 
\[
{\displaystyle \sum_{l=1}^{L}}b_{l}(p,w)\epsilon_{lw}(p,w)=1
\]

\end_inset

where 
\begin_inset Formula $b_{l}(p,w)\equiv\nicefrac{p_{l}x_{l}(p,w)}{w}$
\end_inset

 is the budget share of the consumer's expenditure on good 
\begin_inset Formula $l$
\end_inset

 given prices 
\begin_inset Formula $p$
\end_inset

 and wealth 
\begin_inset Formula $w$
\end_inset

.
\end_layout

\begin_layout Proof
From Proposition 2.E.2, we have
\begin_inset Formula 
\begin{eqnarray*}
\sum_{l=1}^{L}p_{l}\frac{\partial x_{l}(p,w)}{\partial p_{k}}+x_{k}(p,w) & = & 0\\
\sum_{l=1}^{L}p_{l}\frac{\partial x_{l}(p,w)}{\partial p_{k}}\frac{p_{k}}{x_{l}(p,w)}+x_{k}(p,w)\frac{p_{k}}{x_{l}(p,w)} & = & 0\\
\sum_{l=1}^{L}p_{l}\frac{x_{l}(p,w)}{w}\epsilon_{lk}(p,w)+x_{k}(p,w)\frac{p_{k}}{x_{l}(p,w)}\frac{x_{l}(p,w)}{w} & = & 0\\
\sum_{l=1}^{L}b_{l}(p,w)\epsilon_{lk}(p,w)+b_{k}(p,w) & = & 0
\end{eqnarray*}

\end_inset

From Proposition 2.E.3, we have
\begin_inset Formula 
\begin{eqnarray*}
{\displaystyle \sum_{l=1}^{L}}p_{l}\frac{\partial x_{l}(p,w)}{\partial w} & = & 1\\
{\displaystyle \sum_{l=1}^{L}}p_{l}\frac{x_{l}(p,w)}{w}\frac{\partial x_{l}(p,w)}{\partial w}\frac{w}{x_{l}(p,w)} & = & 1\\
{\displaystyle \sum_{l=1}^{L}}b_{l}(p,w)\epsilon_{lw}(p,w) & = & 1
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Problem
