\uwave off
\noun off
\color none

\begin_inset Formula 
\[
{\displaystyle \sum_{l=1}^{L}}p_{l}\frac{\partial x_{l}(p,w)}{\partial w}=1
\]

\end_inset


\family default
\series default
\shape default
\size default
\emph default
\bar default
\strikeout default
