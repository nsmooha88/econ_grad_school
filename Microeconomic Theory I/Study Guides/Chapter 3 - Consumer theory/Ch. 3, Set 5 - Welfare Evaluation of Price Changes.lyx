\begin_layout Problem
Let 
\begin_inset Formula $\succsim$
\end_inset

 be a monotone and continuous preference whose associated choice correspondence
 is single-valued.
 Let 
\begin_inset Formula $p\gg0$
\end_inset

 and 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

.
 Prove that for each 
\begin_inset Formula $p^{\prime}\gg0$
\end_inset

,
\begin_inset Formula 
\[
EV^{\succsim}(p,p^{\prime},w)={\displaystyle \sum_{l=1}^{L}}(p_{l}-p_{l}^{\prime}){\displaystyle \intop_{0}^{1}}\ h_{l}\left(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w)\right)\ d\alpha
\]

\end_inset


\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $\succsim$
\end_inset

 be a monotone and continuous preference whose associated choice correspondence
 is single-valued.
 Let 
\begin_inset Formula $p\gg0$
\end_inset

 and 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

.
 Take 
\begin_inset Formula $p^{\prime}\gg0$
\end_inset

.
\begin_inset Formula 
\begin{eqnarray*}
EV^{\succsim}(p,p^{\prime},w) & = & m_{p}(x(p^{\prime},w))-m_{p}(x(p,w))\\
 & = & m_{p}(x(p^{\prime},w))-w\\
 & = & e(p,x(p^{\prime},w))-e(p^{\prime},x(p^{\prime},w))
\end{eqnarray*}

\end_inset


\shape up
Let 
\begin_inset Formula $\varphi$
\end_inset

 be the function defined by:
\begin_inset Formula 
\[
\begin{array}{cccl}
\varphi: & [0,1] & \rightarrow & \mathbb{R}\\
 & \alpha & \mapsto & \varphi(\alpha)\equiv e(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w))
\end{array}
\]

\end_inset

By the Fundamental Theorem of Calculus,
\begin_inset Formula 
\[
\varphi(1)-\varphi(0)={\displaystyle \intop_{0}^{1}}\ D_{\alpha}\varphi(\alpha)\ d\alpha
\]

\end_inset

Since for each 
\begin_inset Formula $\alpha\in[0,1]$
\end_inset

, then by the Chain Rule
\begin_inset Formula 
\begin{eqnarray*}
D_{\alpha}\varphi(\alpha) & = & D_{p}e(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w))\frac{\partial p(\alpha)}{\partial\alpha}\\
 & = & h(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w))^{T}(p-p^{\prime})\\
 & = & {\displaystyle \sum_{l=1}^{L}}h_{l}(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w))(p_{l}-p_{l}^{\prime})
\end{eqnarray*}

\end_inset

Thus,
\begin_inset Formula 
\begin{eqnarray*}
EV^{\succsim}(p,p^{\prime},w) & = & \intop_{0}^{1}{\displaystyle \sum_{l=1}^{L}}h_{l}(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w))(p_{l}-p_{l}^{\prime})\ d\alpha\\
 & = & {\displaystyle \sum_{l=1}^{L}}(p_{l}-p_{l}^{\prime}){\displaystyle \intop_{0}^{1}}\ h_{l}\left(\alpha p+(1-\alpha)p^{\prime},x(p^{\prime},w)\right)\ d\alpha
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Problem
Consider the Cobb-Douglas preference 
\begin_inset Formula $U(x_{1},x_{2})=x_{1}^{\alpha}x_{2}^{1-\alpha}$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Enumerate
Calculate the demand function associated with this preference (
\begin_inset Formula $x(p,w)$
\end_inset

 that maximizes preferences in budget set 
\begin_inset Formula $B(p,w)$
\end_inset

).
\end_layout

\begin_layout Enumerate
Calculate the Hicksian demand function associated with this preference (
\begin_inset Formula $h(p,\tilde{x})$
\end_inset

 that minimizes expenditure at prices 
\begin_inset Formula $p$
\end_inset

 among all bundles that are at least good as 
\begin_inset Formula $\tilde{x}$
\end_inset

).
\end_layout

\begin_layout Enumerate
Recall that the equivalent variation from 
\begin_inset Formula $p\in\mathbb{R}_{++}^{2}$
\end_inset

 to 
\begin_inset Formula $p^{\prime}\in\mathbb{R}_{++}^{2}$
\end_inset

 for 
\begin_inset Formula $U$
\end_inset

 at wealth level 
\begin_inset Formula $w$
\end_inset

 is
\begin_inset Formula 
\[
EV(p,p^{\prime},w)=e(p,x(p^{\prime},w))-e(p,x(p,w))
\]

\end_inset

where 
\begin_inset Formula $e$
\end_inset

 is the expenditure function for preference 
\begin_inset Formula $U$
\end_inset

.
 Prove that for 
\begin_inset Formula $p_{1}$
\end_inset

, 
\begin_inset Formula $\tilde{p}_{1}$
\end_inset

, 
\begin_inset Formula $p_{2}$
\end_inset

, and 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

,
\begin_inset Formula 
\[
EV^{\succsim}((p_{1},p_{2}),(\tilde{p}_{1},p_{2}),w)=(p_{1}-\tilde{p}_{1}){\displaystyle \intop_{0}^{1}}\ h_{1}\left((\theta p_{1}+(1-\theta)\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)\ d\theta
\]

\end_inset


\end_layout

\begin_layout Enumerate
Verify that (c) holds for a Cobb-Douglas preference.
 (Here, you have to calculate 
\begin_inset Formula $EV$
\end_inset

 from its definition and verify that it is equal to the right side of (c).)
\end_layout

\end_deeper
\begin_layout Proof
Consider the Cobb-Douglas preference 
\begin_inset Formula $U(x_{1},x_{2})=x_{1}^{\alpha}x_{2}^{1-\alpha}$
\end_inset

.
\end_layout

\begin_layout Proof

\bar under
Part A
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Since preferences are Cobb-Douglas, then they are monotone.
 Hence, preferences are locally non-satiated, so Walras' law is holds, i.e.,
\begin_inset Formula 
\[
p_{1}x_{1}+p_{2}x_{2}=w
\]

\end_inset

We wish to find the demand function associated with this preference, i.e.,
\begin_inset Formula 
\[
x(p,w)\equiv\arg{\displaystyle \max_{x\in B(p,w)}}\ x_{1}^{\alpha}x_{2}^{1-\alpha}
\]

\end_inset

The Lagrangian of the utility maximization problem is
\begin_inset Formula 
\[
L=x_{1}^{\alpha}x_{2}^{1-\alpha}+\lambda(w-p_{1}x_{1}-p_{2}x_{2})
\]

\end_inset

and the first-order conditions are
\begin_inset Formula 
\begin{gather*}
\frac{\partial L}{\partial x_{1}}=0\iff\alpha x_{1}^{\alpha-1}x_{2}^{1-\alpha}=\lambda p_{1}\\
\frac{\partial L}{\partial x_{2}}=0\iff(1-\alpha)x_{1}^{\alpha}x_{2}^{-\alpha}=\lambda p_{2}
\end{gather*}

\end_inset

Equating the two equations we have
\begin_inset Formula 
\[
\lambda=\frac{\alpha x_{1}^{\alpha-1}x_{2}^{1-\alpha}}{p_{1}}=\frac{(1-\alpha)x_{1}^{\alpha}x_{2}^{-\alpha}}{p_{2}}
\]

\end_inset

and solving for 
\begin_inset Formula $x_{2}$
\end_inset

 yields
\begin_inset Formula 
\[
x_{2}=\frac{p_{1}}{p_{2}}\frac{(1-\alpha)}{\alpha}x_{1}
\]

\end_inset

We plug this expression for 
\begin_inset Formula $x_{2}$
\end_inset

 into the budget constraint
\begin_inset Formula 
\[
w-p_{1}x_{1}-p_{2}\left(\frac{p_{2}}{p_{1}}\frac{(1-\alpha)}{\alpha}x_{1}\right)=0
\]

\end_inset

and solve for 
\begin_inset Formula $x_{1}$
\end_inset


\begin_inset Formula 
\[
x_{1}=\frac{\alpha}{p_{1}}w
\]

\end_inset

Finally, we obtain a function for 
\begin_inset Formula $x_{2}$
\end_inset


\begin_inset Formula 
\[
x_{2}=\frac{(1-\alpha)}{p_{2}}w
\]

\end_inset

Thus, the Walrasian demand function associated with Cobb-Douglas preference
 is
\begin_inset Formula 
\[
x(p,w)=\left[\begin{array}{c}
\frac{\alpha}{p_{1}}w\\
\frac{(1-\alpha)}{p_{2}}w
\end{array}\right]
\]

\end_inset


\end_layout

\begin_layout Proof

\bar under
Part B
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

The Hicksian demand function associated with this preference is defined
 by
\begin_inset Formula 
\[
h(p,x^{*})\equiv\arg{\displaystyle \min_{x\geq0,\ x_{1}^{\alpha}x_{2}^{1-\alpha}\geq\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}}}\ p_{1}x_{1}+p_{2}x_{2}
\]

\end_inset

The Lagrangian of the expenditure minimization problem is
\begin_inset Formula 
\[
L=-p_{1}x_{1}-p_{2}x_{2}+\lambda(-\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}+x_{1}^{\alpha}x_{2}^{1-\alpha})
\]

\end_inset

and the first-order conditions are
\begin_inset Formula 
\begin{gather*}
\frac{\partial L}{\partial x_{1}}=-p_{1}+\lambda\alpha x_{1}^{\alpha-1}x_{2}^{1-\alpha}=0\iff\lambda=\frac{p_{1}}{\alpha x_{1}^{\alpha-1}x_{2}^{1-\alpha}}\\
\frac{\partial L}{\partial x_{2}}=-p_{2}+\lambda(1-\alpha)x_{1}^{\alpha}x_{2}^{-\alpha}=0\iff\lambda=\frac{p_{2}}{(1-\alpha)x_{1}^{\alpha}x_{2}^{-\alpha}}
\end{gather*}

\end_inset

Equating the two equations we have
\begin_inset Formula 
\begin{eqnarray*}
\frac{p_{1}}{\alpha x_{1}^{\alpha-1}x_{2}^{1-\alpha}} & = & \frac{p_{2}}{(1-\alpha)x_{1}^{\alpha}x_{2}^{-\alpha}}\\
p_{2}\alpha x_{1}^{\alpha}x_{2}^{1+\alpha} & = & p_{1}(1-\alpha)x_{1}^{1+\alpha}x_{2}^{\alpha}\\
p_{2}\alpha x_{2} & = & p_{1}(1-\alpha)x_{1}\\
x_{2} & = & \frac{p_{1}(1-\alpha)}{p_{2}\alpha}x_{1}
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $\lambda>0$
\end_inset

, then 
\begin_inset Formula 
\[
-\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}+x_{1}^{\alpha}x_{2}^{1-\alpha}=0\iff\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}=x_{1}^{\alpha}x_{2}^{1-\alpha}
\]

\end_inset

We plug this expression for 
\begin_inset Formula $x_{2}$
\end_inset

 into the constrain above to obtain
\begin_inset Formula 
\begin{eqnarray*}
\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha} & = & x_{1}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{1-\alpha}\\
x_{1} & = & \tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha-1}\\
x_{2} & = & \tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha}
\end{eqnarray*}

\end_inset

Thus, the Hicksian demand function associated with the Cobb-Douglas preference
 is
\begin_inset Formula 
\[
h(p,\tilde{x})=\left[\begin{array}{c}
\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha-1}\\
\tilde{x}_{1}^{\alpha}\tilde{x}_{2}^{1-\alpha}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha}
\end{array}\right]
\]

\end_inset


\bar under
Part C
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Take 
\begin_inset Formula $\{p,\tilde{p}\}\subseteq\mathbb{R}_{++}^{L}$
\end_inset

 such that 
\begin_inset Formula $p_{1}\neq\tilde{p}_{1}$
\end_inset

 and 
\begin_inset Formula $p_{2}=\tilde{p}_{2}$
\end_inset

, and take 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

.
\begin_inset Formula 
\begin{eqnarray*}
EV(p,p^{\prime},w) & = & e(p,x(\tilde{p},w))-e(p,x(p,w))\\
 & = & e(p,x(\tilde{p},w))-w\\
 & = & e\left((p_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)-e\left((\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)
\end{eqnarray*}

\end_inset


\shape up
Let 
\begin_inset Formula $\varphi$
\end_inset

 be the function defined by:
\begin_inset Formula 
\[
\begin{array}{cccl}
\varphi: & [0,1] & \rightarrow & \mathbb{R}\\
 & \theta & \mapsto & \varphi(\theta)\equiv e\left((\theta p_{1}+(1-\theta)\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)
\end{array}
\]

\end_inset

By the Fundamental Theorem of Calculus,
\begin_inset Formula 
\[
\varphi(1)-\varphi(0)={\displaystyle \intop_{0}^{1}}\ \frac{\partial\varphi(\theta)}{\partial\theta}\ d\theta
\]

\end_inset

Since for each 
\begin_inset Formula $\alpha\in[0,1]$
\end_inset

, then by the Chain Rule
\begin_inset Formula 
\begin{eqnarray*}
\frac{\partial\varphi(\theta)}{\partial\theta} & = & \frac{\partial e}{\partial p_{1}}\left((\theta p_{1}+(1-\theta)\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)\frac{\partial p_{1}(\theta)}{\partial\theta}\\
 & = & h_{1}\left((\theta p_{1}+(1-\theta)\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)(p_{1}-\tilde{p}_{1})
\end{eqnarray*}

\end_inset

Thus,
\begin_inset Formula 
\[
EV^{\succsim}((p_{1},p_{2}),(\tilde{p}_{1},p_{2}),w)=(p_{1}-\tilde{p}_{1}){\displaystyle \intop_{0}^{1}}\ h_{1}\left((\theta p_{1}+(1-\theta)\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)\ d\theta
\]

\end_inset


\shape default
\bar under
Part D
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Take 
\begin_inset Formula $\{p,\tilde{p}\}\subseteq\mathbb{R}_{++}^{L}$
\end_inset

 such that 
\begin_inset Formula $p_{1}\neq\tilde{p}_{1}$
\end_inset

 and 
\begin_inset Formula $p_{2}=\tilde{p}_{2}$
\end_inset

, and take 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

.
 We wish to verify that (c) holds for a Cobb-Douglas prefernce.
 To do this, we calculate EV from its definition and verify that it is equal
 to the right side of (c).
 Since 
\begin_inset Formula $e(p,x(p,w))=p\cdot h(p,x(p,w))$
\end_inset

, then
\begin_inset Formula 
\begin{eqnarray*}
EV(p,p^{\prime},w) & = & e(p,x(\tilde{p},w))-e(p,x(p,w))\\
 & = & e(p,x(\tilde{p},w))-w\\
 & = & e(p,x(\tilde{p},w))-e(\tilde{p},x(\tilde{p},w))\\
 & = & p\cdot h\left((p_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)-\tilde{p}\cdot h\left((\tilde{p}_{1},p_{2}),x(\tilde{p}_{1},p_{2},w)\right)
\end{eqnarray*}

\end_inset

Expanding the expression on the right yields
\begin_inset Formula 
\begin{gather*}
p_{1}\left[\left(\frac{\alpha}{\tilde{p}_{1}}w\right)^{\alpha}\left(\frac{(1-\alpha)}{p_{2}}w\right)^{1-\alpha}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha-1}\right]+p_{2}\left[\left(\frac{\alpha}{\tilde{p}_{1}}w\right)^{\alpha}\left(\frac{(1-\alpha)}{p_{2}}w\right)^{1-\alpha}\left(\frac{p_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha}\right]\\
-\tilde{p}_{1}\left[\left(\frac{\alpha}{\tilde{p}_{1}}w\right)^{\alpha}\left(\frac{(1-\alpha)}{p_{2}}w\right)^{1-\alpha}\left(\frac{\tilde{p}_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha-1}\right]-p_{2}\left[\left(\frac{\alpha}{\tilde{p}_{1}}w\right)^{\alpha}\left(\frac{(1-\alpha)}{p_{2}}w\right)^{1-\alpha}\left(\frac{\tilde{p}_{1}(1-\alpha)}{p_{2}\alpha}\right)^{\alpha}\right]
\end{gather*}

\end_inset


\end_layout

