\begin_layout Proof

\bar under
Part A.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

A preference 
\begin_inset Formula $\succsim$
\end_inset

 is quasi-linear with respect to good one if and only if it satisfies the
 following two properties:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\forall\ \{x,y\}\subseteq\mathbb{R}\times\mathbb{R}_{+},\ \forall\ \alpha\in\mathbb{R}:x\sim y\implies(x_{1}+\alpha,x_{2})\sim(y+\alpha,y_{2})$
\end_inset

 
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall\ x\in\mathbb{R}\times\mathbb{R}_{+},\ \forall\ \alpha\in\mathbb{R}_{++}:(x_{1}+\alpha,x_{2})\succ(x_{1},x_{2})$
\end_inset


\end_layout

\end_deeper
\begin_layout Proof

\bar under
Part B.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Take 
\begin_inset Formula $\{x,y\}\subseteq\mathbb{R}\times\mathbb{R}_{+}$
\end_inset

 and 
\begin_inset Formula $\alpha\in\mathbb{R}$
\end_inset

.
 Assume 
\begin_inset Formula $x\sim y$
\end_inset

.
 Since 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, then 
\begin_inset Formula $x\sim y\iff u(x)=u(y)$
\end_inset

.
 So, we have
\begin_inset Formula 
\[
u(x_{1},x_{2})=x_{1}+\varphi(x_{2})=y_{1}+\varphi(y_{2})=u(y_{1},y_{2})
\]

\end_inset

If we add 
\begin_inset Formula $\alpha$
\end_inset

 to both sides, then
\begin_inset Formula 
\begin{eqnarray*}
(x_{1}+\alpha)+\varphi(x_{2}) & = & (y_{1}+\alpha)+\varphi(y_{2})\\
u((x_{1}+\alpha),x_{2}) & = & u((y_{1}+\alpha),y_{2})
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, then 
\begin_inset Formula $u((x_{1}+\alpha),x_{2})=u((y_{1}+\alpha),y_{2})\iff(x_{1}+\alpha,x_{2})\sim(y_{1}+\alpha,y_{2})$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Take 
\begin_inset Formula $x\in\mathbb{R}\times\mathbb{R}_{+}$
\end_inset

 and 
\begin_inset Formula $\alpha\in\mathbb{R}_{++}$
\end_inset

.
 Then,
\begin_inset Formula 
\begin{eqnarray*}
(x_{1}+\alpha)+\varphi(x_{2}) & > & x_{1}+\varphi(x_{2})\\
u((x_{1}+\alpha),x_{2}) & > & u(x_{1},x_{2})
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, then 
\begin_inset Formula $u((x_{1}+\alpha),x_{2})>u(x_{1},x_{2})\iff(x_{1}+\alpha,x_{2})\succ(x_{1},x_{2})$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Therefore, the preference represented by 
\begin_inset Formula $u$
\end_inset

 is quasi-linear.
\end_layout

\begin_layout Proof

\bar under
Part C.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Let 
\begin_inset Formula $(p,w)\in\mathbb{R}_{++}^{2}\times\mathbb{R}_{+}$
\end_inset

 and 
\begin_inset Formula $w^{\prime}\in\mathbb{R}_{+}$
\end_inset

 such that 
\begin_inset Formula $w^{\prime}>w$
\end_inset

.
 We prove that that 
\begin_inset Formula $x_{2}(p,w^{\prime})=x_{2}(p,w)$
\end_inset

.
 Define 
\begin_inset Formula $c=\frac{w^{\prime}-w}{p_{1}}$
\end_inset

.
 We wish to show that 
\begin_inset Formula $\left(x_{1}(p,w^{\prime}),x_{2}(p,w^{\prime})\right)=\left(x_{1}(p,w)+c,x_{2}(p,w)\right)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

First, we show that 
\begin_inset Formula $\left(x_{1}(p,w)+c,x_{2}(p,w)\right)\in B(p,w^{\prime})$
\end_inset

.
\begin_inset Formula 
\[
p_{1}x_{1}(p,w)+p_{2}x_{2}(p,w)+p_{1}c=w+w^{\prime}-w=w
\]

\end_inset

Thus, we have proved our desired result,
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Next, we show that 
\begin_inset Formula $\left(x_{1}(p,w)+c,x_{2}(p,w)\right)\in C^{\succsim}(p,w^{\prime})$
\end_inset

.
 Suppose for contradiction that 
\begin_inset Formula $\left(x_{1}(p,w)+c,x_{2}(p,w)\right)\notin C^{\succsim}(p,w^{\prime})$
\end_inset

.
 Then, 
\begin_inset Formula $\exists\ (\bar{x}_{1}(p,w^{\prime}),\bar{x}_{2}(p,w^{\prime}))\in B(p,w^{\prime})$
\end_inset

 such that
\begin_inset Formula 
\[
\left(\bar{x}_{1}(p,w^{\prime}),\bar{x}_{2}(p,w^{\prime})\right)\succ\left(x_{1}(p,w)+c,x_{2}(p,w)\right)
\]

\end_inset

Since 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, then
\begin_inset Formula 
\begin{eqnarray*}
\bar{x}_{1}(p,w^{\prime})+\varphi(\bar{x}_{2}(p,w^{\prime})) & > & x_{1}(p,w)+c+\varphi(x_{2}(p,w))\\
\bar{x}_{1}(p,w^{\prime})-c+\varphi(\bar{x}_{2}(p,w^{\prime})) & > & x_{1}(p,w)+\varphi(x_{2}(p,w))\\
u((\bar{x}_{1}(p,w^{\prime})-c),\bar{x}_{2}(p,w^{\prime})) & > & u(x_{1}(p,w),x_{2}(p,w))
\end{eqnarray*}

\end_inset

which implies that
\begin_inset Formula 
\[
\left(\bar{x}_{1}(p,w^{\prime})-c,\bar{x}_{2}(p,w^{\prime})\right)\succ\left(x_{1}(p,w),x_{2}(p,w)\right)
\]

\end_inset

We claim that 
\begin_inset Formula $\left(\bar{x}_{1}(p,w^{\prime})-c,\bar{x}_{2}(p,w)\right)\in B(p,w)$
\end_inset

.
\begin_inset Formula 
\[
p_{1}\bar{x}_{1}(p,w^{\prime})+p_{2}\bar{x}_{2}(p,w^{\prime})-p_{1}c=w^{\prime}+w-w^{\prime}=w
\]

\end_inset

But, we have just contradicted that fact that 
\begin_inset Formula $\left(x_{1}(p,w),x_{2}(p,w)\right)\in C^{\succsim}(p,w)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Thus, 
\begin_inset Formula $\left(x_{1}(p,w)+c,x_{2}(p,w)\right)\in C^{\succsim}(p,w^{\prime})$
\end_inset

, and since 
\begin_inset Formula $x$
\end_inset

 is single valued, we must have 
\begin_inset Formula $\left(x_{1}(p,w^{\prime}),x_{2}(p,w^{\prime})\right)=\left(x_{1}(p,w)+c,x_{2}(p,w)\right)$
\end_inset

.
 Therefore, 
\begin_inset Formula $x_{2}(p,w^{\prime})=x_{2}(p,w)$
\end_inset

.
\end_layout

\begin_layout Proof

\bar under
Part D.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

A demand function 
\begin_inset Formula $x$
\end_inset

 satisfies the Compensated Law of Demand iff 
\begin_inset Formula $\forall\ \{p,p^{\prime}\}\subseteq\mathbb{R}_{+}^{L},\ \forall\ w\in\mathbb{R}_{+}$
\end_inset

,
\begin_inset Formula 
\[
\left(p^{\prime}-p\right)\cdot\left(x(p^{\prime},p^{\prime}\cdot x(p,w))-x(p,w)\right)\leq0
\]

\end_inset

with strict inequality when 
\begin_inset Formula $x(p^{\prime},p^{\prime}\cdot x(p,w))\neq x(p,w)$
\end_inset


\end_layout

\begin_layout Proof

\bar under
Part E.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Let 
\begin_inset Formula $(\mathcal{B}_{++}^{W},C^{\succsim})$
\end_inset

 be the single-valued choice structure associated with the demand function
 
\begin_inset Formula $x$
\end_inset

.
 We know 
\begin_inset Formula $x$
\end_inset

 is the 
\series bold
unique
\series default
 bundle that maximizes 
\begin_inset Formula $u$
\end_inset

 in 
\begin_inset Formula $B(p,w)$
\end_inset

 for each 
\begin_inset Formula $(p,w)\in\mathbb{R}_{++}^{2}\times\mathbb{R}_{+}$
\end_inset

.
 So, by Proposition 5, 
\begin_inset Formula $(\mathcal{B}_{++}^{W},C^{\succsim})$
\end_inset

 satisfies WARP.
 Since preferences are locally non-satiated, then by Proposition 18, 
\begin_inset Formula $(\mathcal{B}_{++}^{W},C^{\succsim})$
\end_inset

 satisfies Walras' law.
 Thus, by Proposition 11, 
\begin_inset Formula $(\mathcal{B}_{++}^{W},C^{\succsim})$
\end_inset

