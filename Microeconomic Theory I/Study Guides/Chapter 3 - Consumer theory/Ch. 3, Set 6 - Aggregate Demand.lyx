\begin_layout Problem
Assume that 
\begin_inset Formula $X\equiv\mathbb{R}_{+}^{2}$
\end_inset

 and 
\begin_inset Formula $\succsim$
\end_inset

 is a Cobb-Douglas preference relation.
 Provide a direct calculation that shows the associated demand function
 satisfies the uncompensated law of demand.
\end_layout

\begin_layout Proof
Since preferences are Cobb-Douglas, then the demand function associated
 with these preferences is 
\begin_inset Formula 
\[
x(p,w)=\left[\begin{array}{c}
\frac{\alpha w}{p_{1}}\\
\frac{(1-\alpha)w}{p_{2}}
\end{array}\right]
\]

\end_inset

Take 
\begin_inset Formula $\{p,p^{\prime}\}\subseteq\mathbb{R}_{++}^{L}$
\end_inset

 and 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

.
 We prove that
\begin_inset Formula 
\[
(p^{\prime}-p)\cdot(x(p^{\prime},w)-x(p,w))<0
\]

\end_inset

when 
\begin_inset Formula $x(p^{\prime},w)\neq x(p,w)$
\end_inset

.
\end_layout

\begin_layout Problem
Assume that 
\begin_inset Formula $X\equiv\mathbb{R}_{+}^{2}$
\end_inset

 and 
\begin_inset Formula $\succsim$
\end_inset

 is a Leontief preference relation.
 Provide a direct calculation that shows the associated demand funciton
 satisfies the uncompensated law of demand.
\end_layout

\begin_layout Proof
Since preferences are Leontief, then the utility function takes the following
 form
\begin_inset Formula 
\[
u(x_{1},x_{2})\equiv\mbox{min}\{x_{1},x_{2}\}
\]

\end_inset

Important to note, preferences are monotone and stricly convex, so the demand
 correspondence is single-valued, and the associated demand function satifies
 Walras' Law.
 The demand function is given by:
\begin_inset Formula 
\[
x^{\succsim}(p,w)\equiv\left(\frac{w}{p_{1}+p_{2}},\frac{w}{p_{1}+p_{2}}\right)
\]

\end_inset

Take 
\begin_inset Formula $\{p,p^{\prime}\}\subseteq\mathbb{R}_{++}^{2}$
\end_inset

 and 
\begin_inset Formula $w\in\mathbb{R}_{+}$
\end_inset

.
 Now, consider
\begin_inset Formula 
\begin{eqnarray*}
(p^{\prime}-p)\cdot\left[x^{\succsim}(p^{\prime},w)-x^{\succsim}(p,w)\right] & = & (p_{1}^{\prime}-p_{1})\left[\frac{w}{p_{1}^{\prime}+p_{2}^{\prime}}-\frac{w}{p_{1}+p_{2}}\right]+(p_{2}^{\prime}-p_{2})\left[\frac{w}{p_{1}^{\prime}+p_{2}^{\prime}}-\frac{w}{p_{1}+p_{2}}\right]\\
 & = & \left[\frac{w}{p_{1}^{\prime}+p_{2}^{\prime}}-\frac{w}{p_{1}+p_{2}}\right](p_{1}^{\prime}-p_{1}+p_{2}^{\prime}-p_{2})\\
 & = & w\left[\frac{p_{1}-p_{1}^{\prime}+p_{2}-p_{2}^{\prime}}{(p_{1}^{\prime}+p_{2}^{\prime})(p_{1}+p_{2})}\right](p_{1}^{\prime}-p_{1}+p_{2}^{\prime}-p_{2})\\
 & = & -w\frac{(p_{1}+p_{2}-p_{1}^{\prime}-p_{2}^{\prime})^{2}}{(p_{1}^{\prime}+p_{2}^{\prime})(p_{1}+p_{2})}\leq0
\end{eqnarray*}

\end_inset

with strict inequality if 
\begin_inset Formula $p_{1}+p_{2}\neq p_{1}^{\prime}+p_{2}^{\prime}\iff x^{\succsim}(p,w)\neq x^{\succsim}(p^{\prime},w)$
\end_inset

.
 Thus, the associated demand function of a Leontief preference relation
 on 
\begin_inset Formula $X\equiv\mathbb{R}_{+}^{2}$
\end_inset

 satisfies the uncompensated law of demand.
\end_layout

