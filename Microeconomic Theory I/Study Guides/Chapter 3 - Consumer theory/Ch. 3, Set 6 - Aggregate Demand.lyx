\begin_layout Proposition*

\shape up
\emph on
where for each 
\begin_inset Formula $i\in N$
\end_inset

,
\begin_inset Formula 
\[
A_{i}=\left[D_{w^{i}}x^{i}(p,\alpha_{i}\mu)-D_{\mu}AD^{\omega}(p,\mu)\right]
\]

