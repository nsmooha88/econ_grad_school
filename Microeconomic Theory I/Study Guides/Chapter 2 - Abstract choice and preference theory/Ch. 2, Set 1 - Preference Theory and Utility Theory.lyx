\begin_layout Theorem*

\series bold
\emph on
(3).

\series default
\emph default
 Assume 
\begin_inset Formula $X$
\end_inset

 is finite.
 Let 
\begin_inset Formula $\succsim$
\end_inset

 be a binary relation on 
\begin_inset Formula $X$
\end_inset

.
 If 
\begin_inset Formula $\succsim$
\end_inset

 is complete and transitive, then there exists a function 
\begin_inset Formula $u:X\rightarrow\mathbb{R}$
\end_inset

 that represents 
\begin_inset Formula $\succsim$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $X$
\end_inset

 be a finite set and 
\begin_inset Formula $\succsim$
\end_inset

 be a binary relation on 
\begin_inset Formula $X$
\end_inset

.
 Assume 
\begin_inset Formula $\succsim$
\end_inset

 is complete and transitive.
 Define the function 
\begin_inset Formula $u$
\end_inset

 as follows:
\begin_inset Formula 
\[
\begin{array}{cccl}
u: & X & \rightarrow & \mathbb{R}\\
 & x & \mapsto & u(x)\equiv|\{z\in X:x\succsim z\}|
\end{array}
\]

\end_inset

Take 
\begin_inset Formula $\{x,y\}\subseteq X$
\end_inset

.
 Let 
\begin_inset Formula $A\equiv\{z:x\succsim z\}$
\end_inset

 and 
\begin_inset Formula $B\equiv\{z:y\succsim z\}$
\end_inset

.
 We want to show that 
\begin_inset Formula $u$
\end_inset

 represents 
\begin_inset Formula $\succsim$
\end_inset

, i.e., 
\begin_inset Formula $x\succsim y\iff u(x)\geq u(y)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Rightarrow)$
\end_inset

 Assume 
\begin_inset Formula $x\succsim y$
\end_inset

.
 We claim that 
\begin_inset Formula $B\subseteq A$
\end_inset

.
 Take 
\begin_inset Formula $z\in B$
\end_inset

.
 Then, 
\begin_inset Formula $y\succsim z$
\end_inset

.
 Since 
\begin_inset Formula $x\succsim y$
\end_inset

 and 
\begin_inset Formula $y\succsim z$
\end_inset

, then by transitivity of 
\begin_inset Formula $\succsim$
\end_inset

, 
\begin_inset Formula $x\succsim z$
\end_inset

.
 Thus, 
\begin_inset Formula $z\in A$
\end_inset

.
 Since 
\begin_inset Formula $B\subseteq A$
\end_inset

, then 
\begin_inset Formula $|B|\leq|A|$
\end_inset

.
 Since 
\begin_inset Formula $u(x)=|A|$
\end_inset

 and 
\begin_inset Formula $u(y)=|B|$
\end_inset

, then 
\begin_inset Formula $u(y)\leq u(x)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Leftarrow)$
\end_inset

 Assume 
\begin_inset Formula $u(x)\geq u(y)$
\end_inset

.
 Suppose for contradiction that 
\begin_inset Formula $\neg(x\succsim y)$
\end_inset

.
 Since 
\begin_inset Formula $\succsim$
\end_inset

 is complete, then 
\begin_inset Formula $y\succsim x$
\end_inset

.
 By the definition of 
\begin_inset Formula $\succ$
\end_inset

, 
\begin_inset Formula $\neg(x\succsim y)$
\end_inset

 and 
\begin_inset Formula $y\succsim x$
\end_inset

 if and only if 
\begin_inset Formula $y\succ x$
\end_inset

.
 We claim that 
\begin_inset Formula $A\subsetneq B$
\end_inset

, i.e., 
\begin_inset Formula $A\subseteq B$
\end_inset

 and 
\begin_inset Formula $B\setminus A\neq\emptyset$
\end_inset

.
 First, we prove that 
\begin_inset Formula $A\subseteq B$
\end_inset

.
 Let 
\begin_inset Formula $z\in A$
\end_inset

.
 So, 
\begin_inset Formula $x\succsim z$
\end_inset

.
 Since 
\begin_inset Formula $y\succ x$
\end_inset

 and 
\begin_inset Formula $x\succsim z$
\end_inset

, then by transitivity of 
\begin_inset Formula $\succsim$
\end_inset

, 
\begin_inset Formula $y\succ z$
\end_inset

.
 Thus, 
\begin_inset Formula $z\in B$
\end_inset

.
 Finally, we prove that 
\begin_inset Formula $y\in B\setminus A$
\end_inset

.
 By completeness of 
\begin_inset Formula $\succsim$
\end_inset

, 
\begin_inset Formula $y\succsim y$
\end_inset

.
 So, 
\begin_inset Formula $y\in B.$
\end_inset

 Now, since 
\begin_inset Formula $\neg(x\succsim y)$
\end_inset

, then 
\begin_inset Formula $y\notin A$
\end_inset

.
 So, 
\begin_inset Formula $y\in B\setminus A$
\end_inset

.
 Thus, 
\begin_inset Formula $A\subsetneq B$
\end_inset

, and this implies that 
\begin_inset Formula $|A|<|B|$
\end_inset

.
 Since 
\begin_inset Formula $u(x)=|A|$
\end_inset

 and 
\begin_inset Formula $u(y)=|B|$
\end_inset

, then 
\begin_inset Formula $u(x)<u(y)\ (\rightarrow\leftarrow).$
\end_inset

 Thus, 
\begin_inset Formula $x\succsim y$
\end_inset

.
\end_layout

