 is complete.
\end_layout

\begin_layout Problem
(c) State the definition of transitivity of 
\begin_inset Formula $W$
\end_inset

.
\end_layout

\begin_layout Problem
(d) Prove that 
\begin_inset Formula $W$
\end_inset

 is transitive.
\end_layout

\begin_layout Problem
(e) Prove that there is an element of 
\begin_inset Formula $x^{*}\in X$
\end_inset

 such that for each 
\begin_inset Formula $y\in X,\neg(y\ B\ x^{*})$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $X$
\end_inset

 be a non-empty finite set and 
\begin_inset Formula $B$
\end_inset

 a binary relation on 
\begin_inset Formula $X$
\end_inset

.
 Assume that 
\begin_inset Formula $B$
\end_inset

 satisfies the following two properties:
\end_layout

\begin_layout Proof
(a) If 
\begin_inset Formula $x\ B\ y$
\end_inset

, then 
\begin_inset Formula $\neg(y\ B\ x)$
\end_inset

.
\end_layout

\begin_layout Proof
(b) If 
\begin_inset Formula $\neg(x\ B\ y)$
\end_inset

 and 
\begin_inset Formula $\neg(y\ B\ z)$
\end_inset

, then 
\begin_inset Formula $\neg(xBz)$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $W$
\end_inset

 be the binary relation on 
\begin_inset Formula $X$
\end_inset

 defined by: 
\begin_inset Formula $x\ W\ y$
\end_inset

 if 
\begin_inset Formula $\neg(y\ B\ x)$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $\forall\ \{x,y\}\subseteq X$
\end_inset

, 
\begin_inset Formula $xWy$
\end_inset

 or 
\begin_inset Formula $yWx$
\end_inset

 or both.
\end_layout

\begin_layout Enumerate
Suppose 
\begin_inset Formula $\neg(xWy)$
\end_inset

, then by the definition of 
\begin_inset Formula $W$
\end_inset

, 
\begin_inset Formula $\neg(\neg(yBx))$
\end_inset

, which is equivalent to 
\begin_inset Formula $yBx$
\end_inset

.
 By proposition (a), 
\begin_inset Formula $yBx\implies\neg(xBy)$
\end_inset

.
 Then, by the definition of 
\begin_inset Formula $W$
\end_inset

, 
\begin_inset Formula $yWx$
\end_inset

.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\forall\ \{x,y,z\}\subseteq X:xWy\ \wedge\ yWz\implies xWz$
\end_inset

.
\end_layout

\begin_layout Enumerate
Assume 
\begin_inset Formula $xWy$
\end_inset

 and 
\begin_inset Formula $yWz$
\end_inset

.
 Then, by the definition of 
\begin_inset Formula $W$
\end_inset

, 
\begin_inset Formula $\neg(yBx)$
\end_inset

 and 
\begin_inset Formula $\neg(zBy)$
\end_inset

.
 By proposition (b), 
\begin_inset Formula $\neg(yBx)\ \wedge\ \neg(zBy)\implies\neg(zBx)$
\end_inset

, which is equivalent to 
\begin_inset Formula $xWz$
\end_inset

.
\end_layout

\begin_layout Enumerate
Since 
\begin_inset Formula $X$
\end_inset

 is finite and 
\begin_inset Formula $W$
\end_inset

 is complete and transitive, then by Theorem 3, 
\begin_inset Formula $\exists\ u:X\rightarrow\mathbb{R}$
\end_inset

 that represents 
\begin_inset Formula $W$
\end_inset

.
 Let 
\begin_inset Formula $A\equiv\arg{\displaystyle \max_{x\in X}}\ u(x)$
\end_inset

.
 Since 
\begin_inset Formula $X$
\end_inset

 is finite, then 
\begin_inset Formula $A\neq\emptyset$
\end_inset

.
 So, 
\begin_inset Formula $\exists\ x^{*}\in A,\forall\ y\in X:u(x^{*})\geq u(y)$
\end_inset

.
 Thus, 
\begin_inset Formula $\forall\ y\in X:x^{*}Wy\iff\forall\ y\in X:\neg(yBx^{*})$
\end_inset

.
\end_layout

\end_deeper
