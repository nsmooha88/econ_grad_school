\color inherit
 Let 
\begin_inset Formula $f(\alpha z)=\tilde{q}\in\mathbb{R}_{+}$
\end_inset

.
 By definition, 
\begin_inset Formula $(-\alpha z,\tilde{q})\in Y$
\end_inset

.
 Since 
\begin_inset Formula $Y$
\end_inset

 satisfies CRS, then 
\begin_inset Formula $\left(-z,\frac{\tilde{q}}{\alpha}\right)\in Y$
\end_inset

.
 So, 
\begin_inset Formula $\frac{\tilde{q}}{\alpha}\leq f(z)=q$
\end_inset

.
 Now, 
\begin_inset Formula $q\leq\frac{\tilde{q}}{a}$
\end_inset

 and 
\begin_inset Formula $q\geq\frac{\tilde{q}}{a}$
\end_inset

 imply that 
\begin_inset Formula $q=\frac{\tilde{q}}{a}$
\end_inset

.
 Thus, 
\begin_inset Formula $\alpha f(z)=f(\alpha z)$
\end_inset

.
 Therefore, 
\begin_inset Formula $\forall\ \alpha\in\mathbb{R}_{+},\ \forall\ z\in\mathbb{R}^{L-1}:\alpha f(z)=f(\alpha z)$
\end_inset

.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(\Leftarrow)$
\end_inset

 Assume 
\begin_inset Formula $\forall\ \alpha\in\mathbb{R}_{+},\ \forall\ z\in\mathbb{R}^{L-1}:\alpha f(z)=f(\alpha z)$
\end_inset

.
 Take 
\begin_inset Formula $y\in Y$
\end_inset

 and 
\begin_inset Formula $\alpha\in\mathbb{R}_{+}$
\end_inset

.
 We want to show that 
\begin_inset Formula $\alpha y\in Y$
\end_inset

.
 Now, 
\begin_inset Formula $y\in Y$
\end_inset

 implies that 
\begin_inset Formula $y=(-z,q)\in\mathbb{R}^{L}$
\end_inset

 such that 
\begin_inset Formula $z\in\mathbb{R}^{L-1}$
\end_inset

 and 
\begin_inset Formula $q-f(z)\leq0$
\end_inset

.
 So, 
\begin_inset Formula $q\leq f(z)$
\end_inset

, and multiplying both sides by 
\begin_inset Formula $\alpha$
\end_inset

 yields 
\begin_inset Formula $\alpha q\leq\alpha f(z)$
\end_inset

.
 Since 
\begin_inset Formula $f(z)$
\end_inset

 is homogeneous of degree one, then 
\begin_inset Formula $\alpha q\leq f(\alpha z)$
\end_inset

.
 By definition, 
\begin_inset Formula $(-\alpha z,\alpha q)\in Y$
\end_inset

, which implies that 
\begin_inset Formula $\alpha(-z,q)\in Y$
\end_inset

.
 Thus, 
\begin_inset Formula $\alpha y\in Y$
\end_inset

.
 Therefore, 
\begin_inset Formula $\forall\ y\in Y,\ \forall\ \alpha\in\mathbb{R}_{+}:\alpha y\in Y$
\end_inset

.
\end_layout

