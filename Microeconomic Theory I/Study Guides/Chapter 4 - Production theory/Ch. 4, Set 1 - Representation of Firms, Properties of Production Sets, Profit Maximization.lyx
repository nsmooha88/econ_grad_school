\uwave off
\noun off
\color none

\begin_inset Formula $\alpha q\leq f(\alpha z)$
\end_inset

, and thus, 
\begin_inset Formula $q\leq\frac{\tilde{q}}{\alpha}$
\end_inset

.

\family default
\series default
\shape default
\size default
\emph default
