\uwave off
\noun off
\color none
\begin_inset Formula $x_{1}(p)=\left(\begin{array}{cc}
x_{11} & \frac{1}{2}-\frac{x_{11}}{2}\end{array}\right)^{\prime},\ x_{11}\in[0,1]$
\end_inset

 and 
\begin_inset Formula $x_{2}(p)=\left(\begin{array}{cc}
\frac{1}{2}+p & \frac{1}{2p}+1\end{array}\right)^{\prime}$
\end_inset

.
 Since 
\begin_inset Formula $\hat{x}_{1}(p)>\hat{w}$
\end_inset

, then no competitive equilibrium exists in this case.
\end_layout

\begin_layout Standard

\emph on
\bar under
Case:
\emph default
\bar default
 
\begin_inset Formula $p>2$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $x_{1}(p)=\left(\begin{array}{cc}
1 & 0\end{array}\right)^{\prime}$
\end_inset

 and 
\begin_inset Formula $x_{2}(p)=\left(\begin{array}{cc}
\frac{1}{2}+p & \frac{1}{2p}+1\end{array}\right)^{\prime}$
\end_inset

.
 Let us consider the market for good 2.
 By the market clearing condition, we have
\begin_inset Formula 
\begin{eqnarray*}
\frac{1}{2p}+1 & = & 2\\
2p & = & 1\\
p & = & \frac{1}{2}
\end{eqnarray*}

\end_inset

Note, 
\begin_inset Formula $p$
\end_inset

 does not fall in the required interval.
 Thus, a competitive equilibrium fails to exist in this case.
\end_layout

\begin_layout Standard
Therefore, a competitive equilibrium fails to exist at all prices.
 Since 
\begin_inset Formula $w_{1}\notin\mbox{Int}(X_{1})$
\end_inset

 and 
\begin_inset Formula $\hat{z}(p)$
\end_inset

 is discontinuous 
\begin_inset Formula $(x_{1}(p)$
\end_inset

 is discontinuous in the interval 
\begin_inset Formula $1<p<2)$
\end_inset

, then a competitive equilibrium is not required to exist.
\end_layout

\begin_layout Problem
Consider a pure-exchange economy with 
\begin_inset Formula $n=2$
\end_inset

, 
\begin_inset Formula $X_{A}=X_{B}=\mathbb{R}_{+}^{2}$
\end_inset

, 
\begin_inset Formula $w_{A}=(4,0)$
\end_inset

, 
\begin_inset Formula $w_{B}=(2,8)$
\end_inset

.
 Suppose the consumers have the following utility funcitons:
\begin_inset Formula 
\[
u_{A}(x_{A1},x_{A2})=x_{A1}+2x_{A2}\ \mbox{and}\ u_{B}(x_{B1},x_{B2})=2x_{B1}+x_{B2}
\]

\end_inset


\end_layout

