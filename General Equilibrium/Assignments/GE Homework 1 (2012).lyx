Part b.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $p\equiv\frac{p_{y}}{p_{x}}$
\end_inset

.
 Since each agent's preferences are strictly monotone, then they are locally
 non-satiatied.
 So, the budget constraint holds with equality for both consumers, and thus,
 Walras's Law holds.
 We derive an agent's demand function by maximizing his utility over his
 budget set.
\end_layout

\begin_layout Standard
The maximizaiton problem for agent 1 is
\begin_inset Formula 
\begin{eqnarray*}
\max & u_{1}(x_{1},y_{1})=x_{1}+2y_{1}\\
\mbox{s.t.} & x_{1}+py_{1}=1+\frac{p}{2}
\end{eqnarray*}

\end_inset

The demand function for agent 1 is given by
\begin_inset Formula 
\[
x_{1}(p)=\begin{cases}
\left(\begin{array}{c}
0\\
\frac{1}{p}+\frac{1}{2}
\end{array}\right) & \mbox{if}\ p<2\\
\left(\begin{array}{c}
x_{1}\\
\frac{1}{2}+\frac{1-x_{1}}{p}
\end{array}\right),x_{1}\in[0,1] & \mbox{if}\ p=2\\
\left(\begin{array}{c}
1\\
0
\end{array}\right) & \mbox{if}\ p>2
\end{cases}
\]

\end_inset

The maximizaiton problem for agent is
\begin_inset Formula 
\begin{eqnarray*}
\max & \succsim_{2,lex}\\
\mbox{s.t.} & x_{2}+py_{2}=1+\frac{p}{2}
\end{eqnarray*}

\end_inset

Since agent 2's preferences are lexicographic, with 
\begin_inset Formula $x$
\end_inset

 being the primary commodity, he will spend all of his wealth on the first
 good.
 So, the demand function for agent 2 is given by
\begin_inset Formula 
\[
x_{2}(p)=\left(\begin{array}{c}
1+\frac{p}{2}\\
0
\end{array}\right)\ p>0
\]

\end_inset


\series bold
\bar under
Part c.
\end_layout

\begin_layout Standard
By Walras' Law, it is enough to show only one market clearing for 
\begin_inset Formula $L=2$
\end_inset

.
 Let us consider the various cases for 
\begin_inset Formula $p$
\end_inset

.
\end_layout

\begin_layout Standard

\emph on
\bar under
Case:
\emph default
\bar default
 
\begin_inset Formula $p<2$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $x_{1}(p)=\left(\begin{array}{cc}
0 & \frac{1}{p}+\frac{1}{2}\end{array}\right)^{\prime}$
\end_inset

 and 
\begin_inset Formula $x_{2}(p)=\left(\begin{array}{cc}
1+\frac{p}{2} & 0\end{array}\right)^{\prime}$
\end_inset

.
 Let us consider the market for good 2.
 By the market clearing condition, we have
\begin_inset Formula 
\begin{eqnarray*}
\frac{1}{p}+\frac{1}{2} & = & 1\\
p & = & 2
\end{eqnarray*}

\end_inset

Thus, the competitive equilibrium is given by
\begin_inset Formula 
\[
\left[x_{1}^{*},x_{2}^{*},p^{*}\right]=\left[\left(\begin{array}{c}
0\\
1
\end{array}\right),\left(\begin{array}{c}
2\\
0
\end{array}\right),\left(\begin{array}{c}
1\\
2
\end{array}\right)\right]
\]

\end_inset


\emph on
\bar under
Case:
\emph default
\bar default
 
\begin_inset Formula $p=2$
\end_inset


\end_layout

\begin_layout Standard
Unless 
\begin_inset Formula $x_{1}=0$
\end_inset

, then 
\begin_inset Formula $\hat{x}_{1}(2)>\hat{w}_{1}$
\end_inset

.
 Thus, a competitive equilibrium fails to exist for this case.
\end_layout

\begin_layout Standard

\emph on
\bar under
Case:
\bar default
 
\begin_inset Formula $p>2$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\hat{x}_{1}(p)>\hat{w}_{1}$
\end_inset

.
 Thus, a competitive equilibrium fails to exist for this case.
\end_layout

\begin_layout Problem
Consider an exchange economy with two commodities and two consumers.
 The utility funcitons 
\begin_inset Formula $u_{i}:\mathbb{R}_{+}^{2}\rightarrow\mathbb{R}$
\end_inset

 are given by
\begin_inset Formula 
\begin{eqnarray*}
u_{1}(x_{11},x_{12}) & = & \left[x_{11}{}^{-2}+\left(\frac{12}{37}\right)^{3}x_{12}{}^{-2}\right]^{\nicefrac{1}{2}}\\
u_{2}(x_{21},x_{22}) & = & \left[\left(\frac{12}{37}\right)^{3}x_{21}{}^{-2}+x_{22}{}^{-2}\right]^{\nicefrac{1}{2}}
\end{eqnarray*}

\end_inset

The endowments are 
\begin_inset Formula $w_{1}=(1,0)$
\end_inset

 and 
\begin_inset Formula $w_{2}=(0,1)$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Enumerate
Compute the aggregate excess demand funciton of this economy.
\end_layout

\begin_layout Enumerate
Verify that there are multiple equilibria.
\end_layout

\end_deeper
\begin_layout Standard

\series bold
\bar under
Part a.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $p\equiv\frac{p_{y}}{p_{x}}$
\end_inset

 and 
\begin_inset Formula $k\equiv\frac{12}{37}$
\end_inset

.
 Since each agent's preferences are strictly monotone, then they are locally
 non-satiatied.
 So, the budget constraint holds with equality for both consumers, and thus,
 Walras's Law holds.
 To compute the aggregate excess demand function, we must first obtain each
 agent's individual demand function.
 We derive an agent's demand function by maximizing his utility over his
 budget set.
 Finally, since a monotonic transformation on utility represents the same
 preferences, we will consider the functions 
\begin_inset Formula $(u_{i}(\cdot))^{2}$
\end_inset

.
\end_layout

\begin_layout Standard
The maximizaiton problem for agent 1 is
\begin_inset Formula 
\begin{eqnarray*}
\max & (u_{1}(x_{11},x_{12}))^{2}=x_{11}{}^{-2}+k^{3}x_{12}{}^{-2}\\
\mbox{s.t.} & x_{11}+px_{12}=1
\end{eqnarray*}

\end_inset

The Lagrangian is
\begin_inset Formula 
\[
L=x_{11}^{-2}+k^{3}x_{12}^{-2}+\lambda(1-x_{11}-px_{12})
\]

\end_inset

After calculating the partial derivatives, we obtain the following first-order
 conditions
\begin_inset Formula 
\begin{eqnarray*}
-2x_{11}^{-3} & = & \lambda\\
-2k^{3}x_{12}^{-3}p^{-1} & = & \lambda
\end{eqnarray*}

\end_inset

From the two equations above, as well as the budget constraint, we have
\begin_inset Formula 
\begin{eqnarray*}
-2x_{11}^{-3} & = & -2k^{3}x_{12}^{-3}p^{-1}\\
kx_{11} & = & x_{12}p^{\nicefrac{1}{3}}\\
k(1-px_{12}) & = & x_{12}p^{\nicefrac{1}{3}}\\
x_{12} & = & \frac{k}{p^{\nicefrac{1}{3}}+kp}\\
x_{11} & = & \frac{p^{\nicefrac{1}{3}}}{p^{\nicefrac{1}{3}}+kp}
\end{eqnarray*}

\end_inset

The maximization problem for agent 2 is
\begin_inset Formula 
\begin{eqnarray*}
\max & (u_{2}(x_{21},x_{22}))^{2}=k^{3}x_{21}{}^{-2}+x_{22}{}^{-2}\\
\mbox{s.t.} & x_{21}+px_{22}=p
\end{eqnarray*}

\end_inset

The Lagrangian is
\begin_inset Formula 
\[
L=k^{3}x_{21}{}^{-2}+x_{22}^{-2}+\lambda(p-x_{21}-px_{22})
\]

\end_inset

After calculating the partial derivatives, we obtian the following first-order
 conditions
\begin_inset Formula 
\begin{eqnarray*}
-2k^{3}x_{21}^{-3} & = & \lambda\\
-2x_{22}^{-3}p^{-1} & = & \lambda
\end{eqnarray*}

\end_inset

From the two equations above, as well as the budget constraints, we have
\begin_inset Formula 
\begin{eqnarray*}
-2k^{3}x_{21}^{-3} & = & -2x_{22}^{-3}p^{-1}\\
x_{21} & = & kx_{22}p^{\nicefrac{1}{3}}\\
(p-px_{22}) & = & kx_{22}p^{\nicefrac{1}{3}}\\
x_{22} & = & \frac{p}{kp^{\nicefrac{1}{3}}+p}\\
x_{21} & = & \frac{kp^{\nicefrac{4}{3}}}{kp^{\nicefrac{1}{3}}+p}
\end{eqnarray*}

\end_inset

Thus, the aggregate excess demand functions are given by
\begin_inset Formula 
\begin{eqnarray*}
\hat{z}_{1}(p) & = & \frac{p^{\nicefrac{1}{3}}}{p^{\nicefrac{1}{3}}+kp}+\frac{kp^{\nicefrac{4}{3}}}{kp^{\nicefrac{1}{3}}+p}-1\\
\hat{z}_{2}(p) & = & \frac{k}{p^{\nicefrac{1}{3}}+kp}+\frac{p}{kp^{\nicefrac{1}{3}}+p}-1
\end{eqnarray*}

\end_inset


\series bold
\bar under
Part b.
\end_layout

\begin_layout Standard
By Walras' Law, it is enough to show only one market clearing for 
\begin_inset Formula $L=2$
\end_inset

.
 Let us consider the parket for the second good.
 By the market clearing condition, we have
\begin_inset Formula 
\begin{eqnarray*}
\frac{k}{p^{\nicefrac{1}{3}}+kp}+\frac{p}{kp^{\nicefrac{1}{3}}+p} & = & 1\\
\frac{k(kp^{\nicefrac{1}{3}}+p)}{(p^{\nicefrac{1}{3}}+kp)(kp^{\nicefrac{1}{3}}+p)}+\frac{p(p^{\nicefrac{1}{3}}+kp)}{(p^{\nicefrac{1}{3}}+kp)(kp^{\nicefrac{1}{3}}+p)} & = & 1\\
\frac{k^{2}p^{\nicefrac{1}{3}}+kp+p^{\nicefrac{4}{3}}+kp^{2}}{kp^{\nicefrac{2}{3}}+p^{\nicefrac{4}{3}}+k^{2}p^{\nicefrac{4}{3}}+kp^{2}} & = & 1\\
k^{2}p^{\nicefrac{1}{3}}+kp+p^{\nicefrac{4}{3}}+kp^{2} & = & kp^{\nicefrac{2}{3}}+p^{\nicefrac{4}{3}}+k^{2}p^{\nicefrac{4}{3}}+kp^{2}\\
kp^{\nicefrac{1}{3}}+p & = & p^{\nicefrac{2}{3}}+kp^{\nicefrac{4}{3}}
\end{eqnarray*}

\end_inset

Let 
\begin_inset Formula $m\equiv p^{\nicefrac{1}{3}}$
\end_inset

.
 Then, we have
\begin_inset Formula 
\begin{eqnarray*}
km+m^{3} & = & m^{2}+km^{4}\\
km^{3}-m^{2}+m^{2}-k & = & 0\\
(m-1)(12m^{2}+37m-37) & = & 0\\
m & \in & \left\{ 1,\frac{3}{4},\frac{4}{3}\right\} 
\end{eqnarray*}

\end_inset

Therefore, 
\begin_inset Formula $p\in\left\{ 1,\frac{27}{64},\frac{64}{27}\right\} $
\end_inset

, so multiple equilibria exist.
\end_layout

\begin_layout Problem
\begin_inset Formula $X_{1}=X_{2}=\mathbb{R}_{+}^{2}$
\end_inset

, 
\begin_inset Formula $w_{1}=w_{2}=\left(2,2\right)$
