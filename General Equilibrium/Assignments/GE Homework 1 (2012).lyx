\bar under
Part a.
\end_layout

\begin_layout Standard
Phone, car, laptop, etc.
\end_layout

\begin_layout Standard

\series bold
\bar under
Part b.
\end_layout

\begin_layout Standard
For this economy, the asusmption that preferences are continuous is innocuous.
 This is because every subset of 
\begin_inset Formula $X_{i}\times X_{i}$
\end_inset

 is closed, so preferences are trivially continuous.
\end_layout

\begin_layout Standard

\series bold
\bar under
Part c.
\end_layout

\begin_layout Standard
Strict monotonicity: 
\begin_inset Formula $\forall\ \{x_{i},x_{i}^{\prime}\}\subseteq X_{i}:x_{i}\gneq x_{i}^{\prime}\implies x_{i}\succ_{i}x_{i}^{\prime}$
\end_inset


\end_layout

\begin_layout Standard
Monotonicity: 
\begin_inset Formula $\forall\ \{x_{i},x_{i}^{\prime}\}\subseteq X_{i}:x_{i}\gg x_{i}^{\prime}\implies x_{i}\succ_{i}x_{i}^{\prime}$
\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
Part d.
\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $X_{i}$
\end_inset

 is indivisible, then 
\begin_inset Formula $\forall x_{i}\in X_{i},\forall\ \lambda\in(0,1):\lambda x_{i}\notin X_{i}$
\end_inset

.
 So, 
\begin_inset Formula $\forall\ \{x_{i},x_{i}^{\prime}\}\subseteq X_{I},\forall\ \lambda\in(0,1):\lambda x_{i}+(1-\lambda)x_{i}^{\prime}\notin X_{i}$
\end_inset

.
 Thus, a definition of convexity cannot be given because goods are indivisible.
\end_layout

\begin_layout Standard

\series bold
\bar under
Part e.
\end_layout

\begin_layout Standard
In this economy, it is not reasonable to assume that preferences are locally
 non-satiated because 
\begin_inset Formula $X_{i}$
\end_inset

 is indivisible.
 To elaborate, 
\begin_inset Formula $\forall\ x_{i}\in X_{i}$
\end_inset

 and any neighborhood 
\begin_inset Formula $N(x_{i})$
\end_inset

, where 
\begin_inset Formula $\forall\ \epsilon>0:N(x_{i})=\{x_{i}^{\prime}\in X_{i}:|x_{i}-x_{i}^{\prime}|<\epsilon\}$
\end_inset

, there may not exist 
\begin_inset Formula $x_{i}^{\prime}\in N(x_{i}):x_{i}^{\prime}\succ_{i}x_{i}$
\end_inset

 for some 
\begin_inset Formula $\epsilon>0$
\end_inset

.
 For example, if 
\begin_inset Formula $\epsilon=\nicefrac{1}{2}$
\end_inset

, then 
\begin_inset Formula $N(x_{i})=\{x_{i}\}$
\end_inset

 and 
\begin_inset Formula $x_{i}\nsucc_{i}x_{i}$
\end_inset

.
\end_layout

\begin_layout Standard

\series bold
\bar under
Part f.
\end_layout

\begin_layout Standard
Suppose 
\begin_inset Formula $N=L=2$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $w_{i1}=w_{i2}=1$
\end_inset

, so 
\begin_inset Formula $\hat{w}=(2,2)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $u_{1}(x_{11},x_{12})=x_{11}^{2}+2x_{12}^{2}$
\end_inset

 and 
\begin_inset Formula $u_{2}(x_{21},x_{22})=x_{21}^{2}+2x_{22}^{2}$
\end_inset


\end_layout

\begin_layout Standard
Preferences are continuous and strictly monotone.
 Let 
\begin_inset Formula $p\in\mathbb{R}_{+}^{2}$
\end_inset

.
\end_layout

\begin_layout Standard
Note, 
\begin_inset Formula $\forall\ i=1,2:u_{i}(0,2)>u_{i}(2,0)>u_{i}(1,1)$
\end_inset


\end_layout

\begin_layout Standard
If 
\begin_inset Formula $p_{1}\geq p_{2}$
\end_inset

, then 
\begin_inset Formula $x_{12}(p)=x_{22}(p)\geq2$
\end_inset

.
 Hence, 
\begin_inset Formula $\hat{z}_{2}(p)=\hat{x}_{2}(p)-\hat{w}_{2}>2$
\end_inset

.
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $p_{1}<p_{2}$
\end_inset

, then 
\begin_inset Formula $x_{11}(p)=x_{21}(p)\geq2$
\end_inset

.
 Hence, 
\begin_inset Formula $\hat{z}_{i}(p)=\hat{x}_{1}(p)-\hat{w}_{1}>2$
\end_inset

.
\end_layout

\begin_layout Standard
Thus, 
\begin_inset Formula $\nexists\ p\in\mathbb{R}_{+}^{2}:\hat{z}(p)\leq0$
\end_inset

.
 Therefore, such an economy does not necessarily have a competitive equilibrium.
\end_layout

\begin_layout Problem
Consider a pure exchange economy with two persons and two commodities.
 The consumption spaces are given by 
\begin_inset Formula $X_{i}=\mathbb{R}_{+}^{2}$
\end_inset

.
 Consumer 1 has a utility function 
\begin_inset Formula $u_{1}:\mathbb{R}_{+}^{2}\rightarrow\mathbb{R}$
\end_inset

 given by
\begin_inset Formula 
\[
u_{1}(x_{1},y_{1})=x_{1}+2y_{1}
\]

\end_inset

and consumer 2's prefernces are lexicographic, with 
\begin_inset Formula $x$
\end_inset

 as the primary commodity, over the set of bundles 
\begin_inset Formula $(x_{2},y_{2})$
\end_inset

.
 Let each consumer's initial endowment be 
\begin_inset Formula $w_{i}=\left(1,\nicefrac{1}{2}\right)$
\end_inset

 for 
\begin_inset Formula $i=1,2$
\end_inset

.
\end_layout

