\frac{13+4p}{2p+3}+\frac{6p-3}{3p+2} & = & 4\\
\frac{(13+4p)(3p+2)+(6p-3)(2p+3)}{(2p+3)(3p+2)} & = & 4\\
39p+26+12p^{2}+8p+12p^{2}+18p-6p-9 & = & 24p^{2}+16p+36p+24\\
24p^{2}+59p+17 & = & 24p^{2}+52p+24\\
7p & = & 7\\
p & = & 1
\end{eqnarray*}

