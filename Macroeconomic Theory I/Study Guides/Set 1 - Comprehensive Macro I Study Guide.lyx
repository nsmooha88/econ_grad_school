\begin{eqnarray*}
Tv(\lambda k_{1}+(1-\lambda)k_{2}) & = & {\displaystyle \max_{\lambda k_{1}^{\prime}+(1-\lambda)k_{2}^{\prime}}}\ u\left(f\left[\lambda k_{1}+(1-\lambda)k_{2}\right]-\left[\lambda k_{1}^{\prime}+(1-\lambda)k_{2}^{\prime}\right]\right)\\
 &  & +\beta v(\lambda k_{1}^{\prime}+(1-\lambda)k_{2}^{\prime})\\
 & \geq & u\left(f\left[\lambda k_{1}+(1-\lambda)k_{2}\right]-\left[\lambda h(k_{1})+(1-\lambda)h(k_{2})\right]\right)\\
 &  & +\beta v\left(\left[\lambda h(k_{1})+(1-\lambda)h(k_{2})\right]\right)\\
 & > & u\left(\lambda f(k_{1})+(1-\lambda)f(k_{2})-\lambda h(k_{1})-(1-\lambda)h(k_{2})\right)\\
 &  & +\beta v\left(\lambda h(k_{1})+(1-\lambda)h(k_{2})\right)\\
 & > & \lambda u\left(f(k_{1})-h(k_{1})\right)+(1-\lambda)u\left(f(k_{2})-h(k_{2})\right)\\
 &  & +\beta\lambda v(h(k_{1}))+\beta(1-\lambda)v(h(k_{2}))\\
