\begin_layout Title
Macroeconomic Theory I: Exam 2 Solutions (2011)
\end_layout

\begin_layout Problem
Consider a growth model, where 
\begin_inset Formula $u(c)=\log(c)$
\end_inset

 and 
\begin_inset Formula $f(k)=Ak$
\end_inset

, 
\begin_inset Formula $\delta=1$
\end_inset

.
 The planner chooses 
\begin_inset Formula $\{c_{t},k_{t+1}\}$
\end_inset

 to maximize
\begin_inset Formula 
\begin{eqnarray*}
\max & {\displaystyle \sum_{t=0}^{\infty}}\beta^{t}\log(c_{t})\\
\mbox{s.t.} & c_{t}+k_{t+1}=Ak_{t}\\
 & k_{0}\ \mbox{is given}
\end{eqnarray*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Enumerate
Write down the Bellman equation for the value function.
\end_layout

\begin_layout Enumerate
Guess that the value function has a form 
\begin_inset Formula $V(k)=a+b\log(k)$
\end_inset

 and use the Bellman equation to determine parameters 
\begin_inset Formula $(a,b)$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Proof
In this problem, the state variable is 
\begin_inset Formula $k_{t}$
\end_inset

, the choice variable is 
\begin_inset Formula $k_{t+1}$
\end_inset

 and the period-period return function is
\begin_inset Formula 
\[
\log(Ak_{t}-k_{t+1})
\]

\end_inset

So, the Bellman equation can be written as
\begin_inset Formula 
\[
V(k)={\displaystyle \max_{k^{\prime}}}\left\{ \log(Ak-k^{\prime})+\beta V(k^{\prime})\right\} 
\]

\end_inset

Assume that the value funciton has a form 
\begin_inset Formula $V(k)=a+b\log(k)$
\end_inset

.
 Now, on the right side of the Bellman equation, we have
\begin_inset Formula 
\[
{\displaystyle \max_{k^{\prime}}\left\{ \log(Ak-k^{\prime})+\beta\left[a+b\log(k^{\prime})\right]\right\} }
\]

\end_inset

The first-order condition with respect to 
\begin_inset Formula $k^{\prime}$
\end_inset

 is given by
\begin_inset Formula 
\[
\frac{1}{Ak-k^{\prime}}=\frac{\beta b}{k^{\prime}}
\]

\end_inset

which is satisfied by the optimal 
\begin_inset Formula $k^{\prime}$
\end_inset


\begin_inset Formula 
\[
k^{\prime}=\frac{\beta b}{(1+\beta b)}Ak
\]

\end_inset

Plugging this expression for 
\begin_inset Formula $k^{\prime}$
\end_inset

 into the right side of the Bellman equaiton yields
\begin_inset Formula 
\begin{eqnarray*}
V(k) & = & \log\left[\left(\frac{A}{1+\beta b}\right)k\right]+\beta a+\beta b\log\left[\frac{\beta bA}{(1+\beta b)}k\right]\\
V(k) & = & \log\left(\frac{A}{1+\beta b}\right)+\log k+\beta\alpha+\beta b\log\left(\frac{\beta bA}{(1+\beta b)}\right)+\beta b\log k\\
a+b\log k & = & \left[\log\left(\frac{A}{1+\beta b}\right)+\beta b\log\left(\frac{\beta bA}{1+\beta b}\right)+\beta a\right]+\left[1+\beta b\right]\log k
\end{eqnarray*}

\end_inset

By equating the proper coefficients on either side of the above equation,
 we can determine the parameters 
\begin_inset Formula $(a,b)$
\end_inset

.
\begin_inset Formula 
\begin{eqnarray*}
b & = & 1+\beta b\\
b & = & \frac{1}{1-\beta}
\end{eqnarray*}

\end_inset

Finally, we determine the expression for parameter 
\begin_inset Formula $a$
\end_inset


\begin_inset Formula 
\begin{eqnarray*}
a & = & \left[\log\left(\frac{A}{1+\beta b}\right)+\beta b\log\left(\frac{\beta bA}{1+\beta b}\right)+\beta a\right]\\
a(1-\beta) & = & \left[\log\left(A(1-\beta)\right)+\frac{\beta}{1-\beta}\log\left(\beta\frac{1}{1-\beta}A(1-\beta)\right)\right]\\
a & = & \frac{\log\left[A(1-\beta)\right]}{1-\beta}+\frac{\beta}{(1-\beta)^{2}}\log(A\beta)
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Problem
An economy consists of two infinitely lived consumers named 
\begin_inset Formula $i=1,2$
\end_inset

.
 There is one nonstroable consumption good.
 Consumer 
\begin_inset Formula $i$
\end_inset

 consumes 
\begin_inset Formula $c_{t}^{i}$
\end_inset

 at time 
\begin_inset Formula $t$
\end_inset

.
 Consumer 
\begin_inset Formula $i$
\end_inset

 ranks consumption streams by
\begin_inset Formula 
\[
{\displaystyle \sum_{t=0}^{\infty}}\beta^{t}u(c_{t}^{i})
\]

\end_inset

where 
\begin_inset Formula $\beta\in(0,1)$
\end_inset

 and 
\begin_inset Formula $u(c)$
\end_inset

 is increasing, strictly concave, and twice continuously differentiable.
 Consumer 1 is endowed with a stream of the consumption good 
\begin_inset Formula $y_{t}^{1}=1,1,0,1,1,0,1,\ldots$
\end_inset

 Consumer 2 is endowed with a stream of the consumption good 
\begin_inset Formula $y_{t}^{2}=0,0,1,0,0,1,0,\ldots$
\end_inset

 Assume that there are complete markets with time-0 Arrow-Debreu trading.
\end_layout

\begin_deeper
\begin_layout Enumerate
Compute a competitive equilibrium
\end_layout

\begin_layout Enumerate
Suppose that one of the consumers markets a derivative asset that promises
 to pay 0.2 units of consumption each period.
 What would the price of the asset be?
\end_layout

\end_deeper
\begin_layout Proof
A competitive equilibrium is a feasible allocation 
\begin_inset Formula $c^{i}=\{c_{t}^{i}\}_{t=0}^{\infty}$
\end_inset

, one for each 
\begin_inset Formula $i$
\end_inset

, and a price system 
\begin_inset Formula $\{q_{t}^{0}\}_{t=0}^{\infty}$
\end_inset

 such that, given the price system, the allocaiton solves each household's
 maximization problem.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

In this economy, there is no aggregate uncertainty and aggregate endowment
 is constant.
 As a result, each consumer will smooth his consumption over time so that
 
\begin_inset Formula $\forall\ t:c_{t}^{i}=\bar{c}^{i}$
\end_inset

.
 The consumer wishes to maximzing his utility
\begin_inset Formula 
\[
{\displaystyle \sum_{t=0}^{\infty}}\beta^{t}u(c_{t}^{i})
\]

\end_inset

subject to his budget constraint
\begin_inset Formula 
\[
{\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}c_{t}^{i}\leq{\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}y_{t}^{i}
\]

\end_inset

The Lagrangian can be written as
\begin_inset Formula 
\[
L={\displaystyle \sum_{t=0}^{\infty}}\beta^{t}u(c_{t}^{i})+\mu^{i}\left[{\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}y_{t}^{i}-{\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}c_{t}^{i}\right]
\]

\end_inset

The first-order condition with respect to 
\begin_inset Formula $c_{t}^{i}$
\end_inset

 is given by
\begin_inset Formula 
\[
\beta^{t}u(c_{t}^{i})=\mu^{i}q_{t}^{0}
\]

\end_inset

We normalize prices such that 
\begin_inset Formula $q_{0}^{0}=1$
\end_inset

.
 So, at 
\begin_inset Formula $t=0$
\end_inset

, we have 
\begin_inset Formula 
\[
u(c_{t}^{i})=\mu^{i}
\]

\end_inset

Now, we can find the equilibrium price
\begin_inset Formula 
\begin{eqnarray*}
q_{t}^{0} & = & \beta^{t}\frac{u(c_{t}^{i})}{\mu^{i}}\\
q_{t}^{0} & = & \beta^{t}
\end{eqnarray*}

\end_inset

Plugging this price into the budget constraint yields
\begin_inset Formula 
\begin{eqnarray*}
{\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}c_{t}^{i} & = & {\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}y_{t}^{i}\\
\bar{c}^{i}{\displaystyle \sum_{t=0}^{\infty}}\beta^{t} & = & {\displaystyle \sum_{t=0}^{\infty}}\beta^{t}y_{t}^{i}\\
\bar{c}^{i} & = & (1-\beta){\displaystyle \sum_{t=0}^{\infty}}\beta^{t}y_{t}^{i}
\end{eqnarray*}

\end_inset

From consumer 2's endowment stream, we can find his optimal allocation
\begin_inset Formula 
\begin{eqnarray*}
\bar{c}^{2} & = & (1-\beta){\displaystyle \sum_{t=0}^{\infty}}\beta^{3t+2}\\
\bar{c}^{2} & = & \frac{(1-\beta)\beta^{2}}{1-\beta^{3}}
\end{eqnarray*}

\end_inset

while consumer 1's optimal allocaiton is
\begin_inset Formula 
\begin{eqnarray*}
\bar{c}^{1} & = & 1-\frac{(1-\beta)\beta^{2}}{1-\beta^{3}}\\
 & = & \frac{1-\beta^{3}-\beta^{2}+\beta^{3}}{1-\beta^{3}}\\
\bar{c}^{1} & = & \frac{1-\beta^{2}}{1-\beta^{3}}
\end{eqnarray*}

\end_inset

With the equilibrium price, we can also price the redudant asset that pays
 0.2 units of consumption from 
\begin_inset Formula $t=1$
\end_inset

 onward.
\begin_inset Formula 
\begin{eqnarray*}
p & = & {\displaystyle \sum_{t=0}^{\infty}}q_{t}^{0}d_{t}\\
 & = & {\displaystyle \sum_{t=0}^{\infty}}\beta^{t}(0.2)\\
p & = & \frac{(0.2)}{1-\beta}
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Problem
Consider a growth model with habit persistence, that is, period-t utility
 is a function of both 
\begin_inset Formula $c_{t}$
\end_inset

 and 
\begin_inset Formula $c_{t-1}$
\end_inset

.
 The planner chooses 
\begin_inset Formula $\{c_{t},k_{t+1}\}$
\end_inset

 to maximize
\begin_inset Formula 
\begin{eqnarray*}
\max & {\displaystyle \sum_{t=0}^{\infty}}\beta^{t}\log\left(c_{t}-\frac{c_{t-1}}{2}\right)\\
\mbox{s.t.} & c_{t}+k_{t+1}=k_{t}^{\alpha}\\
 & k_{0},c_{-1}\ \mbox{are given}
\end{eqnarray*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Enumerate
Derive the Euler equation in this setup.
\end_layout

\begin_layout Enumerate
Is the steady state level of capital in the habit-persistence model different
 from that in the standard model with 
\begin_inset Formula $u(c_{t})=\log(c_{t})$
\end_inset

?
\end_layout

\end_deeper
\begin_layout Proof
The Lagrangian of this maximizaiton problem is
\begin_inset Formula 
\[
L={\displaystyle \sum_{t=0}^{\infty}}\beta^{t}\left[\log\left(c_{t}-\frac{c_{t-1}}{2}\right)+\lambda_{t}\left(k_{t}^{\alpha}-c_{t}-k_{t+1}\right)\right]
\]

\end_inset

The first-order conditions are 
\begin_inset Formula 
\begin{eqnarray*}
\frac{1}{c_{t}-\frac{c_{t-1}}{2}}-\frac{1}{2}\frac{\beta}{c_{t+1}-\frac{c_{t}}{2}} & = & \lambda_{t}\\
\lambda_{t} & = & \lambda_{t+1}\alpha k_{t+1}^{\alpha-1}
\end{eqnarray*}

\end_inset

Combining the two equations above gives the Euler equation
\begin_inset Formula 
\[
\frac{1}{c_{t}-\frac{c_{t-1}}{2}}-\frac{1}{2}\frac{\beta}{c_{t+1}-\frac{c_{t}}{2}}=\left[\frac{\beta}{c_{t+1}-\frac{c_{t}}{2}}-\frac{1}{2}\frac{\beta^{2}}{c_{t+2}-\frac{c_{t+1}}{2}}\right]\alpha k_{t+1}^{\alpha-1}
\]

\end_inset

At the steady state, 
\begin_inset Formula $\forall\ t:c_{t}=c_{ss},\ k_{t}=k_{ss}$
\end_inset

.
 Thus,
\begin_inset Formula 
\begin{eqnarray*}
\frac{2}{c_{ss}}-\frac{\beta}{c_{ss}} & = & \left[\frac{2}{c_{ss}}-\frac{\beta}{c_{ss}}\right]\alpha\beta k_{ss}^{\alpha-1}\\
\alpha\beta k_{ss}^{\alpha-1} & = & 1\\
k_{ss} & = & \left[\alpha\beta\right]^{\frac{1}{1-\alpha}}
\end{eqnarray*}

\end_inset

If 
\begin_inset Formula $u(c_{t})=\log(c_{t})$
\end_inset

, then the Euler equation is given by
\begin_inset Formula 
\begin{eqnarray*}
\frac{1}{c_{t}} & = & \frac{\beta}{c_{t+1}}\alpha k_{t+1}^{\alpha-1}\\
k_{ss} & = & \left[\alpha\beta\right]^{\frac{1}{1-\alpha}}
\end{eqnarray*}

\end_inset

The steady state level of capital in the habit-persistence model is the
 same as in the standard model with 
\begin_inset Formula $u(c_{t})=\log(c_{t})$
\end_inset

.
\end_layout

