\color none

\begin_inset Formula 
\begin{eqnarray*}
w^{*} & = & \frac{\beta}{1-\beta}\left[\frac{1}{2}-\frac{w^{*2}}{2}-w^{*}+w^{*2}\right]\\
w^{*} & = & \frac{\beta}{1-\beta}\frac{1}{2}\left[1+w^{*2}-2w^{*}\right]\\
w^{*} & = & \frac{\beta}{1-\beta}\frac{\left(1-w^{*}\right)^{2}}{2}\\
2w^{*}-2\beta w^{*} & = & \beta(1-w^{*})^{2}\\
\beta(1-w^{*})^{2}+2\beta w^{*}-2w^{*} & = & 0\\
\beta-2\beta w^{*}+\beta w^{*2}+2\beta w^{*}-2w^{*} & = & 0\\
w^{*2}-\frac{2}{\beta}w^{*}+1 & = & 0\\
w^{*} & = & \frac{\frac{2}{\beta}\pm\sqrt{\left(-\frac{2}{\beta}\right)^{2}-4}}{2}\\
w^{*} & = & \frac{1}{\beta}-\sqrt{\frac{1}{\beta^{2}}-1}
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Problem
Consider an overlapping generations model in discrete time 
\begin_inset Formula $(t=0,1,2,\ldots)$
\end_inset

.
 An agent of generation 
\begin_inset Formula $t$
\end_inset

 is born in period 
\begin_inset Formula $t$
\end_inset

 and lives in period 
\begin_inset Formula $t$
\end_inset

 and 
\begin_inset Formula $t+1$
\end_inset

.
 There is a continuum of identical agents per generation.
 Normalize the size of each generation to 1.
 Let 
\begin_inset Formula $\frac{(c_{y}^{t})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\beta\frac{(c_{o}^{t})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}$
\end_inset

 denote the utility function of generation 
\begin_inset Formula $t$
\end_inset

, where the first argument is consumption when young, the second is consumption
 when old.
 Each agent is endowed with 1 unit of non-storable consumption when young
 and 0 when old.
 In addition, each initial old (old in generation 0) owns a tree, which
 yields a non-storable sequence of dividends 
\begin_inset Formula $\{x_{t}\}$
\end_inset

.
 
\begin_inset Formula $x_{t}$
\end_inset

 is either 1 or 0, and follows a markov chain, with 
\begin_inset Formula $\pi_{ij}=P(x_{t+1}=j|x_{t}=i),\ i,j=0,1$
\end_inset

.
 In each period 
\begin_inset Formula $t$
\end_inset

, each young agent decides the number of trees to purchase from the old
 generation; while each old agent sells his trees inelastically.
\end_layout

\begin_deeper
\begin_layout Enumerate
We consider a stationary situation where trees' price depends only on 
\begin_inset Formula $x_{t}$
\end_inset

, not directly on calendar time.
 The prices when 
\begin_inset Formula $x_{t}=0$
\end_inset

 and 
\begin_inset Formula $x_{t}=1$
\end_inset

 are denoted by 
\begin_inset Formula $p_{0}$
\end_inset

 and 
\begin_inset Formula $p_{1}$
\end_inset

, respectively.
 Define a staitonary competitive equilibrium for this economy.
\end_layout

\begin_layout Enumerate
Now assume that 
\begin_inset Formula $\{x_{t}\}$
\end_inset

 is i.i.d.
 across time (i.e., 
\begin_inset Formula $\pi_{ij}$
\end_inset

 is independent of 
\begin_inset Formula $i$
\end_inset

).
 In each period, the shock is either 1 with probability 
\begin_inset Formula $\pi_{1}$
\end_inset

 or 0 with probability 
\begin_inset Formula $\pi_{0}=1-\pi_{1}$
\end_inset

.
 Show that 
\begin_inset Formula $p_{1}=p_{0}$
\end_inset

.
\end_layout

\begin_layout Enumerate
Now assume that 
\begin_inset Formula $\{x_{t}\}$
\end_inset

 is persistent across time (i.e., 
\begin_inset Formula $\pi_{11}>\pi_{01}$
\end_inset

 and 
\begin_inset Formula $\pi_{10}<\pi_{00}$
\end_inset

).
 Show that 
\begin_inset Formula $p_{1}>p_{0}$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Proof
Since each agent is identical, then to find the competitive equilibrium,
 we can just focus on the maximization problem for the representative agent.
\end_layout

\begin_layout Proof
When 
\begin_inset Formula $x_{t}=0$
\end_inset

, the young agent's problem is
\begin_inset Formula 
\begin{eqnarray*}
\max_{\{s,c_{y},c_{o}(0),c_{o}(1)\}} & \frac{(c_{y})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\beta\left[\pi_{00}\frac{(c_{o}(0))^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\pi_{01}\frac{(c_{o}(1))^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}\right]\\
\mbox{s.t.} & c_{y}+sp_{0}=1\\
 & c_{o}(0)=sp_{0}\\
 & c_{o}(1)=s(p_{1}+1)
\end{eqnarray*}

\end_inset

This problem can be rewritten as
\begin_inset Formula 
\[
\frac{(1-sp_{0})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\beta\left[\pi_{00}\frac{(sp_{0})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\pi_{01}\frac{(s(p_{1}+1))^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}\right]
\]

\end_inset

When 
\begin_inset Formula $x_{t}=0$
\end_inset

, the young agent's problem is
\begin_inset Formula 
\begin{eqnarray*}
\max_{\{s,c_{y},c_{o}(0),c_{o}(1)\}} & \frac{(c_{y})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\beta\left[\pi_{10}\frac{(c_{o}(0))^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\pi_{11}\frac{(c_{o}(1))^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}\right]\\
\mbox{s.t.} & c_{y}+sp_{1}=1\\
 & c_{o}(0)=sp_{0}\\
 & c_{o}(1)=s(p_{1}+1)
\end{eqnarray*}

\end_inset

This problem can be rewritten as
\begin_inset Formula 
\[
\frac{(1-sp_{1})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\beta\left[\pi_{00}\frac{(sp_{0})^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}+\pi_{01}\frac{(s(p_{1}+1))^{\nicefrac{1}{2}}}{\nicefrac{1}{2}}\right]
\]

\end_inset

A stationary competitive equilibrium is an allocation 
\begin_inset Formula $\{c_{y},c_{o}(0),c_{o}(1)\}$
\end_inset

 and a set of prices 
\begin_inset Formula $\{p_{0},p_{1}\}$
\end_inset

 such that, given the prices, the allocation solves the household's maximizaiton
 problem.
\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

For each realization of 
\begin_inset Formula $x_{t}$
\end_inset

, we find the first-order condition of the young agent's problem with respect
 to 
\begin_inset Formula $s$
\end_inset

.
 When 
\begin_inset Formula $x_{t}=0$
\end_inset

, we have
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
(c_{y})^{-\nicefrac{1}{2}}p_{0}=\beta\left[\pi_{00}(c_{o}(0))^{-\nicefrac{1}{2}}p_{0}+\pi_{01}(c_{0}(1))^{-\nicefrac{1}{2}}(p_{1}+1)\right]
\]

\end_inset

and when 
\begin_inset Formula $x_{t}=1$
\end_inset

, we have
\begin_inset Formula 
\[
(c_{y})^{-\nicefrac{1}{2}}p_{1}=\beta\left[\pi_{10}(c_{o}(0))^{-\nicefrac{1}{2}}p_{0}+\pi_{11}(c_{0}(1))^{-\nicefrac{1}{2}}(p_{1}+1)\right]
\]

\end_inset

Since agents are homogenous, then 
\begin_inset Formula $s=1$
\end_inset

 in equilibrium.
 Thus, 
\begin_inset Formula $c_{y}=1-p_{0}$
\end_inset

 or 
\begin_inset Formula $c_{y}=1-p_{1}$
\end_inset

, and 
\begin_inset Formula $c_{o}(0)=p_{0}$
\end_inset

 and 
\begin_inset Formula $c_{o}(1)=p_{1}+1$
\end_inset

.
 Substituting these values into the first-order conditions yield
\begin_inset Formula 
\[
\frac{p_{0}}{\sqrt{1-p_{0}}}=\beta\left[\pi_{00}\sqrt{p_{0}}+\pi_{01}\sqrt{1+p_{1}}\right]
\]

\end_inset

and
\begin_inset Formula 
\[
\frac{p_{1}}{\sqrt{1-p_{1}}}=\beta\left[\pi_{10}\sqrt{p_{0}}+\pi_{11}\sqrt{1+p_{1}}\right]
\]

\end_inset

If 
\begin_inset Formula $\{x_{t}\}$
\end_inset

 is i.i.d., then 
\begin_inset Formula $\pi_{00}=\pi_{10}$
\end_inset

 and 
\begin_inset Formula $\pi_{01}=\pi_{11}$
\end_inset

.
 So, the two right-hand sides in the above equations are equal, Thus, we
 know 
\begin_inset Formula 
\[
\frac{p_{0}}{\sqrt{1-p_{0}}}=\frac{p_{1}}{\sqrt{1-p_{1}}}
\]

\end_inset

implying 
\begin_inset Formula $p_{0}=p_{1}$
\end_inset


\end_layout

\begin_layout Proof
\begin_inset space \quad{}
\end_inset

Now, we assume that 
\begin_inset Formula $\{x_{t}\}$
\end_inset

 is persistent across time (i.e., 
\begin_inset Formula $\pi_{01}<\pi_{11}$
\end_inset

 and 
\begin_inset Formula $\pi_{10}<\pi_{00}$
\end_inset

).
 Since we know that 
\begin_inset Formula $p_{0}<1<p_{1}+1$
\end_inset

, we get
\begin_inset Formula 
\[
\beta\left[\pi_{00}\sqrt{p_{0}}+\pi_{01}\sqrt{1+p_{1}}\right]<\beta\left[\pi_{10}\sqrt{p_{0}}+\pi_{11}\sqrt{1+p_{1}}\right]
\]

\end_inset

Thus, we know
\begin_inset Formula 
\[
\frac{p_{0}}{\sqrt{1-p_{0}}}<\frac{p_{1}}{\sqrt{1-p_{1}}}
\]

\end_inset

implying 
\begin_inset Formula $p_{0}<p_{1}$
\end_inset

.
\end_layout

