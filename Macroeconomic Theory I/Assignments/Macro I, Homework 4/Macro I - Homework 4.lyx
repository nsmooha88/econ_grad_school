\begin_layout Standard

\series bold
(b) Show that the reservation price at the mall satisfies 
\begin_inset Formula $\bar{p}_{2}=\sqrt{2B\epsilon}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard
Using equation 
\begin_inset Formula $(2.2)$
\end_inset

, we can convert the functional equation 
\begin_inset Formula $(2.1)$
\end_inset

 into an ordinary equation in the reservation price at the mall, 
\begin_inset Formula $\bar{p}_{2}$
\end_inset

.
 Evaluating 
\begin_inset Formula $v_{2}(\bar{p}_{2})$
\end_inset

 and using equation 
\begin_inset Formula $(2.2)$
\end_inset

, we have
\end_layout

\begin_layout Standard
\begin_inset Formula $\bar{p}_{2}=\epsilon+\int_{0}^{B}p^{\prime}dF(p^{\prime})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\bar{p}_{2}=\epsilon+\int_{0}^{\bar{p}_{2}}p^{\prime}dF(p^{\prime})+\int_{\bar{p}_{2}}^{B}\bar{p}_{2}dF(p^{\prime})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\bar{p}_{2}=\epsilon+\int_{0}^{\bar{p}_{2}}\frac{p^{\prime}}{B}dp^{\prime}+\int_{\bar{p}_{2}}^{B}\frac{\bar{p}_{2}}{B}dp^{\prime}$
\end_inset


\begin_inset space \quad{}
\end_inset

since 
\begin_inset Formula $dF(p^{\prime})=d\left[\int_{-\infty}^{p^{\prime}}\frac{1}{B}\right]=\frac{1}{B}dp^{\prime}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\bar{p}_{2}=\epsilon+\frac{\bar{p}_{2}^{2}}{2B}+\frac{\bar{p}_{2}}{B}(B-\bar{p}_{2})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\bar{p}_{2}^{2}}{2B}=\epsilon$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\bar{p}_{2}=\sqrt{2B\epsilon}$
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(2.3)$
\end_inset


\end_layout

\begin_layout Standard
We can now rewrite the value function 
\begin_inset Formula $v_{2}(p)$
\end_inset

 as 
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $v_{2}(p)=\begin{cases}
p & \mbox{if}\ p\leq\bar{p}_{2}\\
\bar{p}_{2} & \mbox{if}\ p\geq\bar{p}_{2}
\end{cases}$
\end_inset


\begin_inset space \quad{}
\end_inset


\begin_inset Formula $(2.4)$
\end_inset


\end_layout

