\begin_layout Section*

\bar under
Problem 1
\end_layout

\begin_layout Standard
In our lecture, we have considered the growth model with Cobb-Douglas production
 function and log utility.
 We have shown that if 
\begin_inset Formula $v_{0}(k)\equiv0$
\end_inset

, then
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $T^{j}v_{0}(k)=E_{j}+F_{j}\mbox{log}(k)$
\end_inset


\end_layout

\begin_layout Standard
where
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $E_{j}=\mbox{log}\left(\frac{A}{1+\beta F_{j-1}}\right)+\beta\mbox{log}\left(\frac{A}{1+\beta F_{j-2}}\right)+\beta^{2}\mbox{log}\left(\frac{A}{1+\beta F_{j-3}}\right)+\ldots+\beta F_{j-1}\mbox{log}\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)+\beta\left(\beta F_{j-2}\mbox{log}\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)\right)+\ldots$
\end_inset


\end_layout

\begin_layout Standard
Show that
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}E_{j}=\frac{\mbox{log}\left(\frac{A}{1+\beta F_{\infty}}\right)}{1-\beta}+\frac{\beta F_{\infty}\mbox{log}\left(\frac{A\beta F_{\infty}}{1+\beta F_{\infty}}\right)}{1-\beta}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
Solution:
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
Want to show:
\series default
\emph default
 
\begin_inset Formula $E_{j}\rightarrow E$
\end_inset

 as 
\begin_inset Formula $j\rightarrow\infty$
\end_inset

, where
\begin_inset Formula 
\[
E=\frac{\ln\left(\frac{A}{1+\beta F}\right)}{1-\beta}+\frac{\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)}{1-\beta}
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow E=\ln\left(\frac{A}{1+\beta F}\right)\left(1+\beta+\beta^{2}+\cdots\right)+\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\left(1+\beta+\beta^{2}+\cdots\right)
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula $F={\displaystyle \lim_{j\rightarrow\infty}}F_{j}$
\end_inset

.
\end_layout

\begin_layout Standard
This is equivalent to showing that 
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}|E_{j}-E|=0$
\end_inset

 
\end_layout

\begin_layout Standard
Consider
\end_layout

\begin_layout Standard
\begin_inset Formula $|E_{j}-E|\leq\left|\ln\left(\frac{A}{1+\beta F_{j-1}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|+\left|\beta\ln\left(\frac{A}{1+\beta F_{j-2}}\right)-\beta\ln\left(\frac{A}{1+\beta F}\right)\right|+\cdots$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $+\left|\beta^{j-1}\ln\left(\frac{A}{1+\beta F_{0}}\right)-\beta^{j-1}\ln\left(\frac{A}{1+\beta F}\right)\right|+\left|\ln\left(\frac{A}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $+\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+\left|\beta^{2}F_{j-2}\ln\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)-\beta^{2}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+\cdots$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $+\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+\left|\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
Therefore,
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|E_{j}-E\right|\leq\begin{array}[t]{c}
\mbox{lim}\\
j\rightarrow\infty
\end{array}\left|\ln\left(\frac{A}{1+\beta F_{j-1}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta\ln\left(\frac{A}{1+\beta F_{j-2}}\right)-\beta\ln\left(\frac{A}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\ldots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}\ln\left(\frac{A}{1+\beta F_{0}}\right)-\beta^{j-1}\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\ln\left(\frac{A}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{2}F_{j-2}\ln\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)-\beta^{2}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\ldots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
This implies that,
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|E_{j}-E\right|\leq\begin{array}[t]{c}
\mbox{lim}\\
j\rightarrow\infty
\end{array}\left|\ln\left(\frac{A}{1+\beta F_{j-1}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta\ln\left(\frac{A}{1+\beta F_{j-2}}\right)-\beta\ln\left(\frac{A}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\ldots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}\ln\left(\frac{A}{1+\beta F_{0}}\right)-\beta^{j-1}\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{2}F_{j-2}\ln\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)-\beta^{2}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+\ldots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
This is because with 
\begin_inset Formula $\beta\in(0,1)$
\end_inset

, we have:
\end_layout

\begin_layout Standard
\begin_inset Formula $\left|\ln\left(\frac{A}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|=\beta^{j}\left|\frac{\ln\left(\frac{A}{1+\beta F}\right)}{1-\beta}\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies{\displaystyle \lim_{j\rightarrow\infty}}\left|\ln\left(\frac{A}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|=\left|\frac{\ln\left(\frac{A}{1+\beta F}\right)}{1-\beta}\right|{\displaystyle \lim_{j\rightarrow\infty}\ }\beta^{j}=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\left(\beta^{j}+\beta^{j+1}+\cdots\right)\right|=\left|\frac{\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)}{1-\beta}\right|{\displaystyle \lim_{j\rightarrow\infty}}\ \beta^{j}=0$
\end_inset


\end_layout

\begin_layout Standard
Now, consider
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|E_{j}-E\right|\leq{\displaystyle \lim_{j\rightarrow\infty}}\left|\ln\left(\frac{A}{1+\beta F_{j-1}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta\ln\left(\frac{A}{1+\beta F_{j-2}}\right)-\beta\ln\left(\frac{A}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\ldots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}\ln\left(\frac{A}{1+\beta F_{0}}\right)-\beta^{j-1}\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{2}F_{j-2}\ln\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)-\beta^{2}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+\ldots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|\ \ (1)$
\end_inset


\end_layout

\begin_layout Standard
Consider the first series in 
\begin_inset Formula $(1)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\left|\ln\left(\frac{A}{1+\beta F_{j-1}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|+\left|\beta\ln\left(\frac{A}{1+\beta F_{j-2}}\right)-\beta\ln\left(\frac{A}{1+\beta F}\right)\right|+\cdots+\left|\beta^{j-1}\ln\left(\frac{A}{1+\beta F_{0}}\right)-\beta^{j-1}\ln\left(\frac{A}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
This expression has two types of terms, i.e., 
\begin_inset Formula $\left|\beta^{c-1}\ln\left(\frac{A}{1+\beta F_{j-c}}\right)-\beta^{c-1}\ln\left(\frac{A}{1+\beta F}\right)\right|$
\end_inset

 
\end_layout

\begin_layout Standard
and 
\begin_inset Formula $\left|\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F_{c}}\right)-\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F}\right)\right|$
\end_inset

, where 
\begin_inset Formula $c\in\left\{ 0,1,2,\cdots\right\} $
\end_inset

.
 
\end_layout

\begin_layout Standard
We know that 
\begin_inset Formula $F_{j}\rightarrow F$
\end_inset

 as 
\begin_inset Formula $j\rightarrow\infty$
\end_inset

 and since natural logarithm is a continuous function, 
\end_layout

\begin_layout Standard
\begin_inset Formula $\ln\left(\frac{A}{1+\beta F_{j-c}}\right)\rightarrow\ln\left(\frac{A}{1+\beta F}\right)$
\end_inset

 as 
\begin_inset Formula $j\rightarrow\infty$
\end_inset

.
 
\end_layout

\begin_layout Standard
So, we have
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{c-1}\ln\left(\frac{A}{1+\beta F_{j-c}}\right)-\beta^{c-1}\ln\left(\frac{A}{1+\beta F}\right)\right|=\beta^{c-1}{\displaystyle \lim_{j\rightarrow\infty}}\left|\ln\left(\frac{A}{1+\beta F_{j-c}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|=0$
\end_inset


\end_layout

\begin_layout Standard
Now, consider the other term
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F_{c}}\right)-\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F}\right)\right|\leq{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F_{c}}\right)\right|+\lim_{j\rightarrow\infty}\left|\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F_{c}}\right)-\beta^{j-1-c}\ln\left(\frac{A}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\leq\left|\ln\left(\frac{A}{1+\beta F_{c}}\right)\right|{\displaystyle \lim_{j\rightarrow\infty}}\beta^{j-1-c}+\left|\ln\left(\frac{A}{1+\beta F}\right)\right|{\displaystyle \lim_{j\rightarrow\infty}}\beta^{j-1-c}=0$
\end_inset


\end_layout

\begin_layout Standard
So, we have
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|\ln\left(\frac{A}{1+\beta F_{j-1}}\right)-\ln\left(\frac{A}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta\ln\left(\frac{A}{1+\beta F_{j-2}}\right)-\beta\ln\left(\frac{A}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\cdots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}\ln\left(\frac{A}{1+\beta F_{0}}\right)-\beta^{j-1}\ln\left(\frac{A}{1+\beta F}\right)\right|=0\ \ (2)$
\end_inset


\end_layout

\begin_layout Standard
This implies that
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|E_{j}-E\right|\leq{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{2}F_{j-2}\ln\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)-\beta^{2}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\ldots+\lim_{j\rightarrow\infty}\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
Consider the term on the right hand side
\end_layout

\begin_layout Standard
\begin_inset Formula $\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+\left|\beta^{2}F_{j-2}\ln\left(\frac{A\beta F_{j-2}}{1+\beta F_{j-2}}\right)-\beta^{2}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\cdots+\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset


\end_layout

\begin_layout Standard
This expression also has two types of terms: 
\end_layout

\begin_layout Standard
\begin_inset Formula $\left|\beta^{c}F_{j-c}\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)-\beta^{c}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset

 and 
\begin_inset Formula $\left|\beta^{j-c}F_{c}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-c}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset

.
\end_layout

\begin_layout Standard
Consider 
\begin_inset Formula $\left|\beta^{c}F_{j-c}\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)-\beta^{c}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula $F_{j-c}\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)$
\end_inset

 is a product of two sequences, 
\begin_inset Formula $F_{j-c}$
\end_inset

 and 
\begin_inset Formula $\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)$
\end_inset

.
 
\end_layout

\begin_layout Standard
We know that 
\begin_inset Formula $F_{j}$
\end_inset

 is convergent then 
\begin_inset Formula $\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)$
\end_inset

 is also convergent because natural logarithm is a continuous function and
 
\begin_inset Formula $\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)\rightarrow\ln\left(\frac{A\beta F}{1+\beta F}\right)$
\end_inset

 as 
\begin_inset Formula $j\rightarrow\infty$
\end_inset

.
\end_layout

\begin_layout Standard
So, 
\begin_inset Formula $F_{j-c}\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)\rightarrow F\ln\left(\frac{A\beta F}{1+\beta F}\right)$
\end_inset

 as 
\begin_inset Formula $j\rightarrow\infty$
\end_inset

, because the product of two convergent sequences converges to the product
 of their limits.
\end_layout

\begin_layout Standard
Thus, 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\strikeout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{c}F_{j-c}\ln\left(\frac{A\beta F_{j-c}}{1+\beta F_{j-c}}\right)-\beta^{c}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|=0$
\end_inset


\end_layout

\begin_layout Standard
Now, let us consider the second type of term, i.e.,
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-c}F_{c}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-c}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|\leq\left|F_{c}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)\right|{\displaystyle \lim_{j\rightarrow\infty}}\beta^{j-c}+\left|F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|{\displaystyle \lim_{j\rightarrow\infty}}\beta^{j-c}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\implies{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-c}F_{c}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-c}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|=0$
\end_inset


\end_layout

\begin_layout Standard
So, we have
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|\beta F_{j-1}\ln\left(\frac{A\beta F_{j-1}}{1+\beta F_{j-1}}\right)-\beta F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|+$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\cdots+{\displaystyle \lim_{j\rightarrow\infty}}\left|\beta^{j-1}F_{1}\ln\left(\frac{A\beta F_{1}}{1+\beta F_{1}}\right)-\beta^{j-1}F\ln\left(\frac{A\beta F}{1+\beta F}\right)\right|=0$
\end_inset


\end_layout

\begin_layout Standard
Therefore,
\end_layout

\begin_layout Standard
\begin_inset Formula ${\displaystyle \lim_{j\rightarrow\infty}}\left|E_{j}-E\right|\leq0\Rightarrow{\displaystyle \lim_{j\rightarrow\infty}}\left|E_{j}-E\right|=0\Rightarrow{\displaystyle \lim_{j\rightarrow\infty}}E_{j}=E$
\end_inset


\end_layout

\begin_layout Section*

\bar under
Problem 2
\end_layout

\begin_layout Standard
(2012 Macro qualifier) Consider the following growth model where the planner
 chooses a sequence of consumption in order to
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $\begin{array}{cl}
\mbox{max} & {\displaystyle \sum_{t=0}^{\infty}\beta^{t}\mbox{ln}(c_{t})}\\
s.t. & c_{t}+k_{t+1}\le A_{t}k_{t}^{\alpha},\ t\ge0\\
 & k_{0}>0
\end{array}$
\end_inset


\end_layout

\begin_layout Standard
Suppose that the sequnce 
\begin_inset Formula $\left\{ A_{t};t\geq0\right\} $
\end_inset

 follows a periodic pattern, that is, 
\begin_inset Formula $A_{t}=1$
\end_inset

 for 
\begin_inset Formula $t=0,2,4,\ldots$
\end_inset

 and 
\begin_inset Formula $A_{t}=\lambda>1$
\end_inset

 for 
\begin_inset Formula $t=1,3,5,\ldots$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
(a) Set up the Bellman functional equations associated with odd periods
 and even periods.
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $V_{o}(k)=\begin{array}[t]{c}
\mbox{max}\\
c
