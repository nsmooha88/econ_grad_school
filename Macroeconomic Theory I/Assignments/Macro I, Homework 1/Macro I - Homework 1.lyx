\begin_layout Title
Macroeconomic Theory I: Homework 1
\end_layout

\begin_layout Author
Nathan Smooha
\end_layout

\begin_layout Section*

\bar under
Problem 1
\end_layout

\begin_layout Standard
Derive the Euler equation
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $u^{\prime}[c_{t}]=\beta u^{\prime}[c_{t+1}]f^{\prime}(k_{t+1})$
\end_inset

; 
\begin_inset Formula $t=0,\ldots,T-1$
\end_inset


\end_layout

\begin_layout Standard
by applying the Kuhn-Tucker condition to the following problem,
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $\begin{array}{cc}
\mbox{max} & {\displaystyle \sum_{t=0}^{T}\beta^{t}u(c_{t})}\\
\mbox{s.t.} & c_{t}+k_{t+1}\leq f(k_{t}),\ t=0,\ldots,T\\
 & -k_{T+1}\leq0
\end{array}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
Solution:
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
The Lagrangian:
\end_layout

\begin_layout Standard
\begin_inset Formula $L={\displaystyle \sum_{t=0}^{T}\beta^{t}u(c_{t})}+{\displaystyle \sum_{t=0}^{T}\lambda_{t}(f(k_{t})-c_{t}-k_{t+1})+\mu(k_{T+1})}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
First order conditions:
\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial L}{\partial c_{t}}=\beta^{t}u^{\prime}(c_{t})-\lambda_{t}=0\Longleftrightarrow\lambda_{t}=\beta^{t}u^{\prime}(c_{t})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial L}{\partial k_{t+1}}=-\lambda_{t}+\lambda_{t+1}f^{\prime}(k_{t+1})=0\Longleftrightarrow\lambda_{t}=\lambda_{t+1}f(k_{t+1})$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial L}{\partial k_{T+1}}=\mu=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Box Frameless
position "t"
hor_pos "c"
has_inner_box 1
inner_pos "t"
use_parbox 0
use_makebox 0
width "100col%"
special "none"
height "1in"
height_special "totalheight"
status open

\begin_layout Plain Layout

\series bold
Complementary slackness condition:
\end_layout

\begin_layout Plain Layout
\begin_inset Formula ${\displaystyle \sum_{t=0}^{T}}\lambda_{t}(f(k_{t})-c_{t}-k_{t+1})=0$
\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Plain Layout
At the optimal point, 
\begin_inset Formula $\lambda_{t}>0\ \forall\ t=0,\ldots,T-1$
\end_inset

, so 
\begin_inset Formula $f(k_{t})-c_{t}-k_{t+1}=0\ \forall\ t=0,\ldots,T-1$
\end_inset

 from the complementary slackness condition.
\end_layout

\begin_layout Plain Layout
\begin_inset Formula $\implies\beta^{t}u^{\prime}(c_{t})=\beta^{t+1}u^{\prime}(c_{t+1})f^{\prime}(k_{t+1})$
\end_inset


\begin_inset space \quad{}
\end_inset

by the first two first order conditions above.
\end_layout

\begin_layout Plain Layout
Also, since saving is no longer required after period 
\begin_inset Formula $T$
\end_inset

, 
\begin_inset Formula $k_{T+1}=0$
\end_inset

.
\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

