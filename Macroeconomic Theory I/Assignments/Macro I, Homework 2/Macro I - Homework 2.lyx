\align left
\begin_inset Formula $\left.\begin{array}{c}
c_{0}+b_{1}\le y_{0}\\
c_{1}+b_{2}\leq Rb_{1}+y_{1}\\
c_{2}+b_{3}\leq Rb_{2}+y_{2}\\
\vdots\\
c_{T-1}+b_{T}\le Rb_{T-1}+y_{T-1}\\
c_{T}+b_{T+1}\le Rb_{T}+y_{T}
\end{array}\right)\longrightarrow\begin{array}{c}
c_{0}+b_{1}\le y_{0}\\
R^{-1}c_{1}+R^{-1}b_{2}\leq b_{1}+R^{-1}y_{1}\\
R^{-2}c_{2}+R^{-2}b_{3}\leq R^{-1}b_{2}+R^{-2}y_{2}\\
\vdots\\
R^{-T+1}c_{T-1}+R^{-T+1}b_{T}\le R^{-T+2}b_{T-1}+R^{-T+1}y_{T-1}\\
R^{-T}c_{T}+R^{-T}b_{T+1}\le R^{-T+1}b_{T}+R^{-T}y_{T}
\end{array}$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $\implies{\displaystyle \sum_{t=0}^{T}}R^{-t}c_{t}+R^{-T}b_{T+1}\le{\displaystyle \sum_{t=0}^{T}}R^{-t}y_{t}$
\end_inset


