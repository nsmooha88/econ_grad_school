\begin_layout Standard
\noindent
\begin_inset Formula $\frac{\partial L}{\partial c_{t}}=\beta^{t}u^{\prime}(c_{t})-\lambda R^{-t}=0$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\begin_inset Formula $\beta^{t}u^{\prime}(c_{t})=\lambda R^{-t}$
\end_inset


\end_layout

\begin_layout Standard
\noindent
