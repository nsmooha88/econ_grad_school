\end_inset


\end_layout

\begin_layout Standard
\noindent
\begin_inset Formula $u^{\prime}(c_{t})=\lambda$
\end_inset

 since 
\begin_inset Formula $\left(R\beta\right)=1$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\begin_inset Formula $\implies u^{\prime}(c_{t})=u^{\prime}(c_{s})\ \forall\ t\neq s$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\begin_inset Formula $\implies c_{t}=\bar{c}\ \forall\ t$
\end_inset

, i.e., 
\begin_inset Formula $c_{t}$
