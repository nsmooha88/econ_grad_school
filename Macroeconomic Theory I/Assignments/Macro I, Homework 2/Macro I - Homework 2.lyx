\begin_layout Section*

\bar under
Problem 2
\end_layout

\begin_layout Standard
Consider an economy with two price-taking firms.
 Firm 1 has a production technology 
\begin_inset Formula $f(k_{1},n_{1})=k_{1}^{\frac{1}{3}}n_{1}^{\frac{2}{3}}+k_{1}$
\end_inset

, while firm 2 has 
\begin_inset Formula $g(k_{2},n_{2})=k_{2}^{\frac{2}{3}}n_{2}^{\frac{1}{3}}+n_{2}$
\end_inset

.
 Suppose the total supply of capital is 
\begin_inset Formula $(k_{1}+k_{2}=5)$
\end_inset

, and the total supply of labor is 
\begin_inset Formula $(n_{1}+n_{2}=3)$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
(a) Formulate the social planner's output maximization problem.
 Derive the Kuhn-Tucker conditions for the problem.
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
The social planner wishes to maximize total output
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $\begin{array}{c}
\mbox{max}\\
\left\{ k_{1},k_{2},n_{1},n_{2}\right\} 
\end{array}\left(k_{1}^{\frac{1}{3}}n_{1}^{\frac{2}{3}}+k_{1}\right)+\left(k_{2}^{\frac{2}{3}}n_{2}^{\frac{1}{3}}+n_{2}\right)$
\end_inset


\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $\begin{array}{cc}
\mbox{s.t.} & 5-k_{1}-k_{2}=0\\
 & 3-n_{1}-n_{2}=0
\end{array}$
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
Solve the maximization problem
\end_layout

\begin_layout Standard
The Lagrangian is
\end_layout

\begin_layout Standard
\noindent
\align center
\begin_inset Formula $L=\left(k_{1}^{\frac{1}{3}}n_{1}^{\frac{2}{3}}+k_{1}\right)+\left(k_{2}^{\frac{2}{3}}n_{2}^{\frac{1}{3}}+n_{2}\right)+\lambda\left(5-k_{1}-k_{2}\right)+\mu\left(3-n_{1}-n_{2}\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\left.\begin{array}{c}
\frac{\partial L}{\partial k_{1}}=\frac{1}{3}k_{1}^{-\frac{2}{3}}n_{1}^{\frac{2}{3}}+1-\lambda=0\\
\frac{\partial L}{\partial k_{2}}=\frac{2}{3}k_{2}^{-\frac{1}{3}}n_{2}^{\frac{1}{3}}-\lambda=0
\end{array}\right)\implies\frac{1}{3}k_{1}^{-\frac{2}{3}}n_{1}^{\frac{2}{3}}+1=\frac{2}{3}k_{2}^{-\frac{1}{3}}n_{2}^{\frac{1}{3}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\left.\begin{array}{c}
\frac{\partial L}{\partial n_{1}}=\frac{2}{3}k_{1}^{\frac{1}{3}}n_{1}^{-\frac{1}{3}}-\mu=0\\
\frac{\partial L}{\partial n_{2}}=\frac{1}{3}k_{2}^{\frac{2}{3}}n_{1}^{-\frac{2}{3}}+1-\mu=0
\end{array}\right)\implies\frac{2}{3}k_{1}^{\frac{1}{3}}n_{1}^{-\frac{1}{3}}=\frac{1}{3}k_{2}^{\frac{2}{3}}n_{1}^{-\frac{2}{3}}+1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial L}{\partial\lambda}=5-k_{1}-k_{2}=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $ $
\end_inset


\begin_inset Formula $\frac{\partial L}{\partial\mu}=3-n_{1}-n_{2}=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
The Kuhn-Tucker conditions for the problem
\end_layout

\begin_layout Itemize
\begin_inset Formula $\frac{1}{3}k_{1}^{-\frac{2}{3}}n_{1}^{\frac{2}{3}}+1=\frac{2}{3}k_{2}^{-\frac{1}{3}}n_{2}^{\frac{1}{3}}$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $\frac{2}{3}k_{1}^{\frac{1}{3}}n_{1}^{-\frac{1}{3}}=\frac{1}{3}k_{2}^{\frac{2}{3}}n_{1}^{-\frac{2}{3}}+1$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $5-k_{1}-k_{2}=0$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $3-n_{1}-n_{2}=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\bar under
(b) Show that the KT conditions coincide with the equilibrium conditions
 in Question 2, Assignment 1.
 This means that the first and the second welfare theorems hold in this
 environment as well.
\end_layout

\begin_layout Standard
\begin_inset VSpace medskip
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
Competitive Equilibrium
\end_layout

\begin_layout Standard
A competitive equilibrium is a sequence of prices and allocations, such
 that:
\end_layout

\begin_layout Enumerate
All the decision makers maximize their utility and profit
\end_layout

\begin_layout Enumerate
Quantity supplied = Quantity demanded in every market
\end_layout

\begin_layout Standard

\series bold
\emph on
1.
 Firms maximize profit
\end_layout

\begin_layout Standard

\series bold
Firm 1:
\end_layout

\begin_layout Standard
\begin_inset Formula $\Pi_{1}=f(k_{1},n_{1})=k_{1}^{\frac{1}{3}}n_{1}^{\frac{2}{3}}+k_{1}-R\cdot k_{1}-W\cdot n_{1}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial\Pi_{1}}{\partial k_{1}}=\frac{1}{3}k_{1}^{-\frac{2}{3}}n_{1}^{\frac{2}{3}}+1-R=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Longleftrightarrow R=\frac{1}{3}k_{1}^{-\frac{2}{3}}n_{1}^{\frac{2}{3}}+1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial\Pi_{1}}{\partial n_{1}}=\frac{2}{3}k_{1}^{\frac{1}{3}}n_{1}^{-\frac{1}{3}}-W=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Longleftrightarrow W=\frac{2}{3}k_{1}^{\frac{1}{3}}n_{1}^{-\frac{1}{3}}$
\end_inset


\end_layout

\begin_layout Standard

\series bold
Firm 2:
\end_layout

\begin_layout Standard
\begin_inset Formula $\Pi_{2}=k_{2}^{\frac{2}{3}}n_{2}^{\frac{1}{3}}+n_{2}-R\cdot k_{2}-W\cdot n_{2}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial\Pi_{1}}{\partial k_{2}}=\frac{2}{3}k_{2}^{-\frac{1}{3}}n_{2}^{\frac{1}{3}}-R=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Longleftrightarrow R=\frac{2}{3}k_{2}^{-\frac{1}{3}}n_{2}^{\frac{1}{3}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{\partial\Pi_{1}}{\partial n_{2}}=\frac{1}{3}k_{2}^{\frac{2}{3}}n_{1}^{-\frac{2}{3}}+1-W=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Longleftrightarrow W=\frac{1}{3}k_{2}^{\frac{2}{3}}n_{2}^{-\frac{2}{3}}+1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Standard

\series bold
Now we have,
\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{1}{3}k_{1}^{-\frac{2}{3}}n_{1}^{\frac{2}{3}}+1=R=\frac{2}{3}k_{2}^{-\frac{1}{3}}n_{2}^{\frac{1}{3}}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{2}{3}k_{1}^{\frac{1}{3}}n_{1}^{-\frac{1}{3}}=W=\frac{1}{3}k_{2}^{\frac{2}{3}}n_{2}^{-\frac{2}{3}}+1$
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
2.
 Quantity supplied = Quantity demanded in all markets
\end_layout

\begin_layout Standard
\begin_inset Formula $5-k_{1}-k_{2}=0\iff k_{1}+k_{2}=5$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $3-n_{1}-n_{2}=0\iff n_{1}+n_{2}=3$
\end_inset


\end_layout

\begin_layout Standard

\series bold
\emph on
The First Welfare Theorem
\end_layout

\begin_layout Standard
Allocation in a competitive equilibrium solves the social planner's problem.
