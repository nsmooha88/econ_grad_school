\begin_layout Standard
// Preamble
\end_layout

\begin_layout Standard
var c k i y w r lambda A N L b; 
\end_layout

\begin_layout Standard
var exo e;
\end_layout

\begin_layout Standard
parameters alpha beta gamma delta eta rho sigma;
\end_layout

\begin_layout Standard
alpha = .667; 
\end_layout

\begin_layout Standard
beta = .984; 
\end_layout

\begin_layout Standard
gamma = 1.004; 
\end_layout

\begin_layout Standard
eta = 1; 
\end_layout

\begin_layout Standard
delta=.025; 
\end_layout

\begin_layout Standard
rho = .979; 
\end_layout

\begin_layout Standard
sigma = 1;
\end_layout

\begin_layout Standard
// model
\end_layout

\begin_layout Standard
model(linear); 
\end_layout

\begin_layout Standard
0 = 0.029*i + (1-delta)*k(-1) - gamma*k; 
\end_layout

\begin_layout Standard
0 = gamma*lambda(+1)-gamma*lambda-beta*(1-alpha)*0.136*k+(gamma-beta*(1-delta))*y
(+1); 
\end_layout

\begin_layout Standard
0 = r - lambda + lambda(+1); 
\end_layout

\begin_layout Standard
A = rho*A(-1) + e; 
\end_layout

\begin_layout Standard
0 = lambda + c; 
\end_layout

\begin_layout Standard
0 = eta*L + lambda + w; 
\end_layout

\begin_layout Standard
w = A + (1 - alpha) * (k(-1) - N); 
\end_layout

\begin_layout Standard
0 = 0.22*N + 0.78*L; 
\end_layout

\begin_layout Standard
y = 0.786*c + 0.214*i; 
\end_layout

\begin_layout Standard
y = A + alpha*N + (1-alpha)*k; 
\end_layout

\begin_layout Standard
b = y - N; 
\end_layout

\begin_layout Standard
end;
\end_layout

\begin_layout Standard
// steady state
\end_layout

\begin_layout Standard
initval; 
\end_layout

\begin_layout Standard
k=0; 
\end_layout

\begin_layout Standard
c=0; 
\end_layout

\begin_layout Standard
e=0; 
\end_layout

\begin_layout Standard
i=0; 
\end_layout

\begin_layout Standard
y=0; 
\end_layout

\begin_layout Standard
w=0; 
\end_layout

\begin_layout Standard
r=1.02; 
\end_layout

\begin_layout Standard
lambda=0; 
\end_layout

\begin_layout Standard
A=0; 
\end_layout

\begin_layout Standard
L=0; 
\end_layout

\begin_layout Standard
N=0; 
\end_layout

\begin_layout Standard
b=0; 
\end_layout

\begin_layout Standard
end;
\end_layout

\begin_layout Standard
steady; 
\end_layout

\begin_layout Standard
check;
\end_layout

\begin_layout Standard
// shocks
\end_layout

\begin_layout Standard
shocks; 
\end_layout

\begin_layout Standard
var e = 0.0000518; 
\end_layout

\begin_layout Standard
end;
\end_layout

