\begin_layout Title
Macroeconomic Theory II: Homework 4
\end_layout

\begin_layout Author
Nathan Smooha
\end_layout

\begin_layout Problem
Consider the following problem:
\begin_inset Formula 
\[
{\displaystyle \max_{\{C_{i}\}_{i=1}^{m}}}\left[{\displaystyle \sum_{i=1}^{m}}C_{i}^{1-\frac{1}{\epsilon}}\right]^{\frac{\epsilon}{\epsilon-1}}
\]

\end_inset

subject to
\begin_inset Formula 
\[
{\displaystyle \sum_{i=1}^{m}}C_{i}P_{i}=Z
\]

\end_inset

Notice that this is the discrete version of hte problem we discussed in
 the lecture.
 Show that the solution of this problem (i.e., the maximized value of the
 consumption index) is
\begin_inset Formula 
\[
C^{*}=\frac{Z}{P}
\]

\end_inset

and the demand for an individual good is
\begin_inset Formula 
\[
C_{i}=\left(\frac{P_{i}}{P}\right)^{-\epsilon}C^{*}
\]

\end_inset

where 
\begin_inset Formula $P$
\end_inset

 is an appropriately defined price index, whose expression you have to find
 by yourself.
\end_layout

\begin_layout Proof
The Lagrangian can be set up as follows
\begin_inset Formula 
\[
L=\left[{\displaystyle \sum_{i=1}^{m}}C_{i}^{1-\frac{1}{\epsilon}}\right]^{\frac{\epsilon}{\epsilon-1}}+\lambda\left[Z-{\displaystyle \sum_{i=1}^{m}}C_{i}P_{i}\right]
\]

\end_inset

The first-order condition with respect to a specific good 
\begin_inset Formula $j$
\end_inset

 is
\begin_inset Formula 
\begin{gather}
\frac{\partial L}{\partial c_{t}(j)}=0\nonumber \\
\iff\frac{\epsilon}{\epsilon-1}\left[{\displaystyle \sum_{i=1}^{m}}C_{i}^{1-\frac{1}{\epsilon}}\right]\frac{\epsilon-1}{\epsilon}C_{j}^{-\frac{1}{\epsilon}}-\lambda P_{j}=0\nonumber \\
\iff\left[{\displaystyle \sum_{i=1}^{m}}C_{i}^{1-\frac{1}{\epsilon}}\right]C_{j}^{-\frac{1}{\epsilon}}=\lambda P_{j},\ \forall\ j=1,\ldots,m\nonumber \\
\iff\left(\frac{C_{j}}{C_{k}}\right)^{-\frac{1}{\epsilon}}=\frac{P_{j}}{P_{k}}\nonumber \\
\iff\frac{C_{j}}{C_{k}}=\left(\frac{P_{j}}{P_{k}}\right)^{-\epsilon}\nonumber \\
\iff C_{j}=C_{k}\left(\frac{P_{j}}{P_{k}}\right)^{-\epsilon}
\end{gather}

\end_inset

Let us substitute equation (1) into the constraint.
\begin_inset Formula 
\begin{eqnarray}
{\displaystyle \sum_{j=1}^{m}}C_{j}P_{j} & = & Z\nonumber \\
{\displaystyle \sum_{j=1}^{m}}C_{k}\left(\frac{P_{j}}{P_{k}}\right)^{-\epsilon}P_{j} & = & Z\nonumber \\
C_{k}P_{k}^{\epsilon}{\displaystyle \sum_{j=1}^{m}}P_{j}^{1-\epsilon} & = & Z
\end{eqnarray}

\end_inset

Let us define 
\begin_inset Formula $P$
\end_inset

 as
\begin_inset Formula 
\begin{equation}
P\equiv\left[{\displaystyle \sum_{j=1}^{m}}P_{j}^{1-\epsilon}\right]^{\frac{1}{1-\epsilon}}
\end{equation}

\end_inset

After substituting expression (3) for 
\begin_inset Formula $P$
\end_inset

 into equation (2), we have
\begin_inset Formula 
\begin{eqnarray}
C_{k}P_{k}^{\epsilon}P^{1-\epsilon} & = & Z\nonumber \\
C_{k} & = & \left(\frac{P_{k}}{P}\right)^{-\epsilon}\frac{Z}{P}
\end{eqnarray}

\end_inset

which is a necessary condition for maximizing the consumption index.
 Then, we substitute equation (6) into the consumption idex.
\begin_inset Formula 
\begin{gather}
\left[{\displaystyle \sum_{k=1}^{m}}C_{k}^{1-\frac{1}{\epsilon}}\right]^{\frac{\epsilon}{\epsilon-1}}\nonumber \\
=\left[{\displaystyle \sum_{k=1}^{m}}\left\{ \left(\frac{P_{k}}{P}\right)^{-\epsilon}\frac{Z}{P}\right\} ^{1-\frac{1}{\epsilon}}\right]^{\frac{\epsilon}{\epsilon-1}}\nonumber \\
=\left[\left\{ \left(\frac{1}{P}\right)^{-\epsilon}\left(\frac{Z}{P}\right)\right\} ^{\frac{\epsilon-1}{\epsilon}}{\displaystyle \sum_{k=1}^{m}}\left(P_{k}^{-\epsilon}\right)^{\frac{\epsilon-1}{\epsilon}}\right]^{\frac{\epsilon}{\epsilon-1}}\nonumber \\
=\left(\frac{1}{P}\right)^{-\epsilon}\left(\frac{Z}{P}\right)\left[{\displaystyle \sum_{k=1}^{m}}P_{k}^{1-\epsilon}\right]^{\frac{\epsilon}{\epsilon-1}}
\end{gather}

\end_inset

Finally, from expression (3) for 
\begin_inset Formula $P$
\end_inset

, equation (5) becomes
\begin_inset Formula 
\begin{gather}
\left(\frac{1}{P}\right)^{-\epsilon}\left(\frac{Z}{P}\right)P^{-\epsilon}=\frac{Z}{P}
\end{gather}

\end_inset

Thus, the maximized value of the consumption index) is equation (6)
\begin_inset Formula 
\[
C^{*}=\frac{Z}{P}
\]

\end_inset

and the demand for an individual good is equation (4) 
\begin_inset Formula 
\[
C_{i}=\left(\frac{P_{i}}{P}\right)^{-\epsilon}C^{*}
\]

\end_inset

where 
\begin_inset Formula $P$
\end_inset

 is given by equation (3)
\begin_inset Formula 
\[
P\equiv\left[{\displaystyle \sum_{j=1}^{m}}P_{j}^{1-\epsilon}\right]^{\frac{1}{1-\epsilon}}
\]

\end_inset


\end_layout

