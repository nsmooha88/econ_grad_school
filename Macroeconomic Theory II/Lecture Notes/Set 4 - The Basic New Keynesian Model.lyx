\begin_layout Subsubsection*
CGG's Model
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
\pi_{t} & = & \delta E_{t}\left\{ \pi_{t+1}\right\} +\lambda(y_{t}-z_{t})\\
y_{t} & = & E_{t}\left\{ y_{t+1}\right\} -\frac{1}{\sigma}\left(r_{t}-E_{t}\left\{ \pi_{t+1}\right\} \right)+g_{t}\\
r_{t}^{*} & = & \beta E_{t}\left\{ \pi_{t+1}\right\} +\gamma\chi_{t}\\
r_{t} & = & \rho r_{t-1}+(1-\rho)r_{t}^{*}
\end{eqnarray*}

\end_inset

where 
\begin_inset Formula $\delta$
\end_inset

 is the discount rate, 
\begin_inset Formula $z_{t}$
\end_inset

 is the natural rate of output, and 
\begin_inset Formula $g_{t}$
\end_inset

 exogenous demand shock.
 The first equation is the New Keynesian Phillips Curve and the second is
 Dynamic IS Curve, while the third and fourth polic rule equations are policy
 rules.
 These parameter values do not satisfy the Taylor Principle, so the existence
 of a unique equilibrium is not guaranteed.
\end_layout

