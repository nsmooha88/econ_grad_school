\begin_layout Title
Econometrics I: Quiz 2
\end_layout

\begin_layout Author
Nathan Smooha
\end_layout

\begin_layout Standard
Consider a linear regression model 
\begin_inset Formula $y=X\beta+u$
\end_inset

, where 
\begin_inset Formula $y:N\times1$
\end_inset

, 
\begin_inset Formula $X:N\times K$
\end_inset

, 
\begin_inset Formula $\beta:K\times1$
\end_inset

, and 
\begin_inset Formula $u:N\times1$
\end_inset

.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\hat{\beta}$
\end_inset

 be the LSE of 
\begin_inset Formula $\beta$
\end_inset

.
\end_layout

\begin_layout Problem
What is the assumption under which the LSE 
\begin_inset Formula $\hat{\beta}$
\end_inset

 is the unique estimator? Which assumption prevents a perfect fit?
\end_layout

\begin_layout Proof
If 
\begin_inset Formula $rank(X)=K$
\end_inset

, then 
\begin_inset Formula $\hat{\beta}$
\end_inset

 is the unique LSE.
 If 
\begin_inset Formula $rank(X,y)=K+1$
\end_inset

, then this prevents a perfect fit.
\end_layout

\begin_layout Problem
What is the additional assumption under which the LSE of 
\begin_inset Formula $\beta$
\end_inset

 is unbiased? What does the unbiasedness mean?
\end_layout

\begin_layout Proof
\begin_inset Formula $E(u|X)=0$
\end_inset

 is the additional assumption under which the LSE of 
\begin_inset Formula $\beta$
\end_inset

 is unbiased.
 Note that 
\begin_inset Formula $(X,y)$
\end_inset

 are random.
 If we hold 
\begin_inset Formula $X$
\end_inset

 fixed, vary 
\begin_inset Formula $y$
\end_inset

, and calculate 
\begin_inset Formula $\hat{\beta}$
\end_inset

 for each realization of 
\begin_inset Formula $y$
\end_inset

, then if we take the average of all 
\begin_inset Formula $\hat{\beta}$
\end_inset

, it will equal the population mean, i.e., 
\begin_inset Formula $E(\hat{\beta}|X)=\beta$
\end_inset

.
\end_layout

\begin_layout Problem
Prove that LSE 
\begin_inset Formula $\hat{\beta}$
\end_inset

 is unbiased conditional on 
\begin_inset Formula $X$
\end_inset

 as well as unconditionally.
\end_layout

\begin_layout Proof
\begin_inset Formula $\hat{\beta}$
\end_inset

 is unbiased conditional on 
\begin_inset Formula $X$
\end_inset

.
\begin_inset Formula 
\begin{eqnarray*}
E(\hat{\beta}|X) & = & E\left[(X^{\prime}X)^{-1}X^{\prime}y|X\right]\\
 & = & E\left[\beta+(X^{\prime}X)^{-1}X^{\prime}u|X\right]\\
 & = & \beta+(X^{\prime}X)^{-1}X^{\prime}E(u|X)\\
 & = & \beta\ \ \mbox{since}\ E(u|X)=0
\end{eqnarray*}

\end_inset


\begin_inset Formula $\hat{\beta}$
\end_inset

 is also unbiased unconditionally.
\begin_inset Formula 
\[
E(\hat{\beta})=E\left[E(\hat{\beta}|X)\right]=\beta
\]

\end_inset


\end_layout

\begin_layout Problem
Suppose one of the regressors is the lagged dependent variable.
 Is the assumption in (2) satisfied? Explain why or why not?
\end_layout

\begin_layout Proof
No, the assumption in (2) is not satisfied.
\begin_inset Formula 
\[
E(u|X)=0\implies E(u_{t}|X_{s})=0\ \forall\ t,s\implies E(X_{s}^{\prime}u_{t})=0\ \forall\ t,s
\]

\end_inset

Now, suppose
\begin_inset Formula 
\[
y_{t}=\beta y_{t-1}+u_{t}
\]

\end_inset

Then,
\begin_inset Formula 
\begin{eqnarray*}
E(X_{t+1}\cdot u_{t}) & = & E(y_{t}\cdot u_{t})\\
 & = & E\left[\left(\beta y_{t-1}+u_{t}\right)\cdot u_{t}\right]\\
 & = & E(u_{t}^{2})\\
 & = & \sigma^{2}
\end{eqnarray*}

\end_inset

Thus, 
\begin_inset Formula $E(X_{s}\cdot u_{t})\neq0\ \forall\ t,s$
\end_inset

, which means that 
\begin_inset Formula $E(u|X)\neq0$
\end_inset

.
\end_layout

\begin_layout Problem
What is the additional assumption under which 
\begin_inset Formula $\hat{\beta}$
\end_inset

 is BLUE conditional on 
\begin_inset Formula $X$
\end_inset

?
\end_layout

\begin_layout Proof
\begin_inset Formula $E(uu^{\prime}|X)=\sigma^{2}I$
\end_inset

 is the additional assumption under which 
\begin_inset Formula $\hat{\beta}$
\end_inset

 is BLUE conditional on 
\begin_inset Formula $X$
\end_inset

.
\end_layout

\begin_layout Problem
Present the estimator of the variane of the homoskedastic error terms and
 prove its unbiasedness.
\end_layout

\begin_layout Proof
The estimator of 
\begin_inset Formula $\sigma^{2}$
\end_inset

 is
\begin_inset Formula 
\[
\hat{\sigma}^{2}=\frac{\hat{u}^{\prime}\hat{u}}{N-K}
\]

\end_inset

To show that 
\begin_inset Formula $\hat{\sigma}^{2}$
\end_inset

 is an unbiased estimator of 
\begin_inset Formula $\sigma^{2}$
\end_inset

 when need to show that 
\begin_inset Formula $E\left(\hat{u}^{\prime}\hat{u}|X\right)=(N-K)\sigma^{2}$
\end_inset

.
\begin_inset Formula 
\begin{eqnarray*}
E\left(\hat{u}^{\prime}\hat{u}|X\right) & = & E(u^{\prime}Mu|X)\\
 & = & E\left[tr(u^{\prime}Mu)|X\right]\\
 & = & E\left[tr(uu^{\prime}M)|X\right]\\
 & = & tr\left[E(uu^{\prime}|X)M\right]\\
 & = & \sigma^{2}tr(M)\\
 & = & \sigma^{2}(N-K)
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Problem
Prove the Gauss-Markov theorem conditional on 
\begin_inset Formula $X$
\end_inset

.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $\tilde{\beta}$
\end_inset

 be another linear unbiased estimator.
 Since it is linear in 
\begin_inset Formula $y$
\end_inset

, 
\begin_inset Formula $\tilde{\beta}=Cy$
\end_inset

.
 Let 
\begin_inset Formula $C=A+D$
\end_inset

 where 
\begin_inset Formula $A=(X^{\prime}X)^{-1}X^{\prime}$
\end_inset


\begin_inset Formula 
\begin{eqnarray*}
\tilde{\beta} & = & Cy\\
 & = & \hat{\beta}+Dy\\
 & = & \hat{\beta}+DX\beta+Du
\end{eqnarray*}

\end_inset

Note that
\begin_inset Formula 
\[
E(\tilde{\beta}|X)=\beta+DX\beta
\]

\end_inset

So, for 
\begin_inset Formula $\tilde{\beta}$
\end_inset

 to be unbiased, 
\begin_inset Formula $DX=0$
\end_inset

.
 We now have
\begin_inset Formula 
\begin{eqnarray*}
\tilde{\beta} & = & \hat{\beta}+Du\\
\left(\tilde{\beta}-\beta\right) & = & \left(\hat{\beta}-\beta\right)+Du\\
 & = & Au+Du\\
 & = & (A+D)u
\end{eqnarray*}

\end_inset

Now,
\begin_inset Formula 
\begin{eqnarray*}
cov(\tilde{\beta}|X) & = & cov(\tilde{\beta}-\beta|X)\\
 & = & cov\left[(A+D)u|X\right]\\
 & = & (A+D)cov(u|X)(A+D)^{\prime}\\
 & = & \sigma^{2}(A+D)(A+D)^{\prime}\\
 & = & \sigma^{2}\left(AA^{\prime}+AD^{\prime}+DA^{\prime}+DD^{\prime}\right)
\end{eqnarray*}

\end_inset

Since 
\begin_inset Formula $A=(X^{\prime}X)^{-1}X^{\prime}$
\end_inset

, then 
\begin_inset Formula $AD^{\prime}=DA^{\prime}=0$
\end_inset

.
 Hence,
\begin_inset Formula 
\[
cov(\tilde{\beta}|X)=\sigma^{2}\left[\left(X^{\prime}X\right)^{-1}+DD^{\prime}\right]
\]

\end_inset

Since 
\begin_inset Formula $DD^{\prime}$
\end_inset

 is always positive semi-definite, then
\begin_inset Formula 
\[
cov(\tilde{\beta}|X)=\sigma^{2}\left[\left(X^{\prime}X\right)^{-1}+DD^{\prime}\right]\geq\sigma^{2}\left(X^{\prime}X\right)^{-1}=cov(\hat{\beta}|X)
\]

\end_inset


\end_layout

