\begin_layout Standard
First theorem
\end_layout

\begin_layout Theorem
Let 
\begin_inset Formula $X\sim N(\mu,\sigma^{2})$
\end_inset

 and 
\begin_inset Formula $b=\nicefrac{(c-\mu)}{\sigma}$
\end_inset

.
 Then,
\end_layout

\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $E(X|X>c)=\mu+\sigma\frac{\phi(b)}{1-\Phi(b)}\equiv\mu+\sigma\lambda^{+}(b)$
\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Formula $E(X|X<c)=\mu-\sigma\frac{\phi(b)}{\Phi(b)}\equiv\mu+\sigma\lambda^{-}(b)$
\end_inset


\end_layout

\end_deeper
\begin_layout Standard
Second theorem
\end_layout

\begin_layout Theorem*
Let 
\begin_inset Formula $X_{1}$
\end_inset

 and 
\begin_inset Formula $X_{2}$
\end_inset

 be jointly normal with means 
\begin_inset Formula $\mu_{1}$
\end_inset

 and 
\begin_inset Formula $\mu_{2}$
\end_inset

, and covariance matrix 
\begin_inset Formula $\Sigma=(\sigma_{ij})$
\end_inset

.
 Then,
\begin_inset Formula 
\[
X_{1}=\mu_{1}+\left(\nicefrac{\sigma_{12}}{\sigma_{22}}\right)\left(X_{2}-\mu_{2}\right)+\eta_{1}
\]

\end_inset

where 
\begin_inset Formula $E(\eta_{1})=0,\ \mbox{Var}(\eta_{1})=\sigma_{11}-\sigma_{12}\sigma_{22}^{-1}\sigma_{21},\ \mbox{Cov}(X_{2},\eta_{1})=0$
\end_inset


\end_layout

